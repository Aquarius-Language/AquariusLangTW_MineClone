## 星泉無垠（AquaCraft）— 以星泉 WGPU 模組製作的體素生存沙盒（網頁與桌面共用同一份程式）。
星泉無垠 / AquaCraft: a voxel survival sandbox built on AquariusLang's WGPU module; one program for web and desktop.
採集資源、合成工具、蓋避難所、撐過夜晚，進度自動存檔。
Gather resources, craft tools, build a shelter, survive the night; progress saves automatically.
##
變數 GPU = 匯入("WGPU");
變數 數學 = 匯入("GLM");
變數 存放 = 匯入("Storage");
變數 序列 = 匯入("Serialization");
變數 雜訊 = 匯入(目前工作目錄 + "/src/noise.aqua");
變數 方塊 = 匯入(目前工作目錄 + "/src/blocks.aqua");
變數 生成 = 匯入(目前工作目錄 + "/src/worldgen.aqua");
變數 世界 = 匯入(目前工作目錄 + "/src/world.aqua");
變數 網格 = 匯入(目前工作目錄 + "/src/mesher.aqua");
變數 玩家 = 匯入(目前工作目錄 + "/src/player.aqua");
變數 相機 = 匯入(目前工作目錄 + "/src/camera.aqua");
變數 繪 = 匯入(目前工作目錄 + "/src/renderer.aqua");
變數 介面 = 匯入(目前工作目錄 + "/src/ui.aqua");
變數 聲 = 匯入(目前工作目錄 + "/src/audio.aqua");
變數 物品 = 匯入(目前工作目錄 + "/src/items.aqua");
變數 背包 = 匯入(目前工作目錄 + "/src/inventory.aqua");
變數 合成 = 匯入(目前工作目錄 + "/src/crafting.aqua");
變數 容器 = 匯入(目前工作目錄 + "/src/containers.aqua");
變數 掉落 = 匯入(目前工作目錄 + "/src/drops.aqua");
變數 怪物 = 匯入(目前工作目錄 + "/src/mobs.aqua");
變數 庫介 = 匯入(目前工作目錄 + "/src/invui.aqua");
變數 語言 = 匯入(目前工作目錄 + "/src/lang.aqua");
變數 字型 = 匯入(目前工作目錄 + "/src/glyphs.aqua");
變數 調試 = 匯入(目前工作目錄 + "/src/debug.aqua");

變數 空 = [][0];
變數 預設種子 = 20261012;   # 開場：湖畔森林望向對岸山脈 Opens on a lakeside facing mountains
變數 存檔鍵 = "aquacraft-world-v1";
變數 設定鍵 = "aquacraft-settings-v1";

# ---------- 設定 Settings ----------
變數 預設名 = ["Low", "Medium", "High", "Ultra", "Custom"];
變數 陰影名 = ["Off", "Low", "Medium", "High"];
變數 陰影尺寸表 = [0, 1024, 2048, 3072];
變數 陰影範圍表 = [0.0d, 44.0d, 72.0d, 104.0d];
變數 設定 = {"preset": 2, "distance": 10, "shadows": 2, "effects": 1, "scale": 100, "sensitivity": 8, "fov": 75, "volume": 80, "fps": 假, "mobs": 真, "lang": "zh"};
變數 套用預設 = 函式(p) {
    如果 (p == 0) { 設定["distance"] = 6; 設定["shadows"] = 0; 設定["effects"] = 0; 設定["scale"] = 75; }
    如果 (p == 1) { 設定["distance"] = 8; 設定["shadows"] = 1; 設定["effects"] = 0; 設定["scale"] = 90; }
    如果 (p == 2) { 設定["distance"] = 10; 設定["shadows"] = 2; 設定["effects"] = 1; 設定["scale"] = 100; }
    如果 (p == 3) { 設定["distance"] = 14; 設定["shadows"] = 3; 設定["effects"] = 1; 設定["scale"] = 100; }
    設定["preset"] = p;
};
變數 讀設定 = 存放.GetPreference(設定鍵);
如果 (讀設定 != 空) {
    變數 鍵們 = 雜湊.鍵列表(讀設定);
    迴圈 (變數 i = 0; i < 長度(鍵們); i++) { 如果 (雜湊.包含鍵(設定, 鍵們[i])) { 設定[鍵們[i]] = 讀設定[鍵們[i]]; } }
}
變數 存設定 = 函式() { 存放.SetPreference(設定鍵, 設定); };
# 預設繁體中文；切換後記在設定裡。 繁體中文 by default; the choice is kept with the settings.
語言.設定語言(設定["lang"]);

# ---------- 模組初始化 Module wiring ----------
變數 種子 = 預設種子;
變數 存檔 = 空;
變數 讀存檔 = 函式() {
    變數 位元 = 存放.Read(存檔鍵);
    如果 (位元 == 空) { 回傳 空; }
    變數 r = 序列.TryParseBinary(位元);
    如果 (!r.ok) { 回傳 空; }
    回傳 r.value;
};
如果 (!調試.全新) { 存檔 = 讀存檔(); }
如果 (存檔 != 空) { 種子 = 存檔["seed"]; }

相機.初始化(數學);
網格.初始化(方塊);
物品.初始化(方塊, 語言);
介面.初始化(方塊, 物品, 語言, 字型);
背包.初始化(物品);
合成.初始化(物品, 方塊);
庫介.初始化(介面, 物品, 背包, 合成, 方塊);
變數 時刻 = 0.31d;
變數 日長 = 1200.0d;
變數 選取 = 0;
變數 出生點 = [0.5d, 80.0d, 0.5d, 0.0d];   # 重生點與測試腳本的 "home" Respawn point, also the test script's "home"

# ---------- 生存狀態 Survival state ----------
變數 生命 = 20;
變數 氧氣 = 10.0d;
變數 受傷閃 = 0.0d;
變數 無敵 = 0.0d;
變數 回血計時 = 0.0d;
變數 上次受傷 = 0.0d;
變數 溺水計時 = 0.0d;

變數 開始世界 = 函式(新種子, 沿用存檔) {
    種子 = 新種子;
    生成.初始化(雜訊, 方塊, 種子);
    世界.初始化(生成, 方塊, 雜訊);
    玩家.初始化(世界, 方塊, 數學);
    容器.初始化(背包, 物品, 方塊, 世界);
    掉落.初始化(世界, 方塊, 物品, 背包, 數學);
    怪物.初始化(世界, 方塊, 數學);
    背包.全部清空();
    生命 = 20; 氧氣 = 10.0d;
    如果 (沿用存檔 && 存檔 != 空) {
        世界.載入修改(存檔["edits"]);
        變數 p = 存檔["player"];
        玩家.設定位置(p[0], p[1], p[2], p[3], p[4]);
        時刻 = 存檔["time"];
        選取 = 存檔["slot"];
        出生點 = [p[0], p[1], p[2], p[3]];
        如果 (雜湊.包含鍵(存檔, "inv")) { 背包.匯入(背包.格, 存檔["inv"]); }
        如果 (雜湊.包含鍵(存檔, "containers")) { 容器.匯入(存檔["containers"]); }
        如果 (雜湊.包含鍵(存檔, "drops")) { 掉落.匯入(存檔["drops"]); }
        如果 (雜湊.包含鍵(存檔, "health")) { 生命 = 存檔["health"]; 如果 (生命 <= 0) { 生命 = 20; } }
        如果 (雜湊.包含鍵(存檔, "spawn")) { 出生點 = 存檔["spawn"]; }
    } 否則 {
        世界.載入修改([]);
        變數 出生 = 生成.尋找出生點();
        變數 yaw = 數學.Sin(0.0d);
        # 由方向向量求偏航：比較八個方向。 Yaw from the chosen view direction.
        變數 dx = 出生[3]; 變數 dz = 出生[4];
        變數 角 = [1.5708d, 0.7854d, 0.0d, -0.7854d, -1.5708d, -2.3562d, 3.1416d, 2.3562d];
        變數 方向 = [[1.0d, 0.0d], [0.7071d, 0.7071d], [0.0d, 1.0d], [-0.7071d, 0.7071d], [-1.0d, 0.0d], [-0.7071d, -0.7071d], [0.0d, -1.0d], [0.7071d, -0.7071d]];
        迴圈 (變數 i = 0; i < 8; i++) {
            變數 d = 方向[i];
            如果 ((d[0] - dx) * (d[0] - dx) + (d[1] - dz) * (d[1] - dz) < 0.01d) { yaw = 角[i]; }
        }
        玩家.設定位置(出生[0] + 0.5d, 出生[1] + 1.2d, 出生[2] + 0.5d, yaw, -0.12d);
        時刻 = 0.31d;
        選取 = 0;
        變數 起 = 玩家.位置;
        出生點 = [起[0], 起[1], 起[2], 玩家.偏航];
    }
};

變數 已存版本 = -1;
變數 存檔資料 = 函式() {
    變數 p = 玩家.位置;
    回傳 {"version": 2, "seed": 種子, "player": [p[0], p[1], p[2], 玩家.偏航, 玩家.俯仰], "time": 時刻, "slot": 選取,
        "edits": 世界.修改清單(), "inv": 背包.匯出(背包.格), "containers": 容器.匯出(), "drops": 掉落.匯出(),
        "health": 生命, "spawn": 出生點};
};
變數 儲存 = 函式() {
    如果 (調試.全新) { 回傳 0; }
    存放.Write(存檔鍵, 序列.Binary(存檔資料(), 1));
    世界.清除修改旗標();
    已存版本 = 背包.版本;
};

# ---------- 視窗與繪製 Window and renderer ----------
變數 窗 = GPU.CreateWindow(1280, 760, 語言.譯("AquaCraft"));
繪.初始化(GPU, 窗, 數學, 字型);
變數 套用畫質 = 函式() {
    繪.設定陰影(陰影尺寸表[設定["shadows"]]);
    繪.調整大小(窗.PixelWidth, 窗.PixelHeight, 設定["scale"] / 100.0d);
    聲.設定音量(設定["volume"] / 100.0d);
};

# ---------- 區塊串流 Chunk streaming ----------
變數 中心cx = 99999; 變數 中心cz = 99999;
變數 完成 = 假;
變數 已網格區塊 = [];
變數 清單已變 = 真;
變數 網格化區塊 = 函式(c) {
    變數 cx = c["cx"]; 變數 cz = c["cz"];
    變數 最高 = c["最高"];
    迴圈 (變數 dz = -1; dz <= 1; dz++) { 迴圈 (變數 dx = -1; dx <= 1; dx++) {
        變數 n = 世界.取區塊(cx + dx, cz + dz);
        如果 (n["最高"] > 最高) { 最高 = n["最高"]; }
    } }
    變數 填 = 世界.填充(cx, cz);
    變數 結果 = 網格.網格化(cx, cz, 填[0], 填[1], 最高);
    繪.上傳區塊(c, 結果[0], 結果[1], 結果[2]);
    c["髒"] = 假;
    清單已變 = 真;
};
變數 鄰居齊全 = 函式(cx, cz) {
    迴圈 (變數 dz = -1; dz <= 1; dz++) { 迴圈 (變數 dx = -1; dx <= 1; dx++) {
        如果 (!世界.有區塊(cx + dx, cz + dz)) { 回傳 假; }
    } }
    回傳 真;
};
變數 重建髒區塊 = 函式() {
    變數 全部 = 世界.全部區塊();
    迴圈 (變數 i = 0; i < 長度(全部); i++) {
        變數 c = 全部[i];
        如果 (c["髒"] && c["網格"]) { 網格化區塊(c); }
    }
};
變數 串流 = 函式(px, pz, 預算) {
    變數 開始 = 目前時間();
    變數 R = 設定["distance"];
    變數 pcx = 雜訊.地板除(雜訊.取整(px), 16);
    變數 pcz = 雜訊.地板除(雜訊.取整(pz), 16);
    如果 (pcx != 中心cx || pcz != 中心cz) {
        中心cx = pcx; 中心cz = pcz; 完成 = 假;
        # 卸載遠方區塊並釋放 GPU 緩衝區。 Unload distant chunks and their GPU buffers.
        變數 全部 = 世界.全部區塊();
        迴圈 (變數 i = 0; i < 長度(全部); i++) {
            變數 c = 全部[i];
            變數 ddx = c["cx"] - pcx; 變數 ddz = c["cz"] - pcz;
            如果 (ddx < 0) { ddx = -ddx; } 如果 (ddz < 0) { ddz = -ddz; }
            如果 (ddx > R + 2 || ddz > R + 2) { 繪.釋放區塊(c); 世界.移除區塊(c); 清單已變 = 真; }
        }
    }
    如果 (完成) { 回傳 真; }
    變數 全完成 = 真;
    迴圈 (變數 d = 0; d <= R + 1; d++) {
        迴圈 (變數 dz = -d; dz <= d; dz++) {
            迴圈 (變數 dx = -d; dx <= d; dx++) {
                如果 (dx == -d || dx == d || dz == -d || dz == d) {
                    如果 (目前時間() - 開始 > 預算) { 回傳 假; }
                    變數 cx = pcx + dx; 變數 cz = pcz + dz;
                    如果 (!世界.有區塊(cx, cz)) {
                        世界.產生區塊(cx, cz);
                        全完成 = 假;
                    }
                    如果 (d <= R) {
                        變數 c = 世界.取區塊(cx, cz);
                        如果 (!c["網格"] || c["髒"]) {
                            如果 (鄰居齊全(cx, cz)) { 網格化區塊(c); } 否則 { 全完成 = 假; }
                        }
                    }
                }
            }
        }
    }
    完成 = 全完成;
    回傳 完成;
};
變數 可繪區塊 = 函式() {
    如果 (清單已變) {
        已網格區塊 = [];
        變數 全部 = 世界.全部區塊();
        迴圈 (變數 i = 0; i < 長度(全部); i++) { 如果 (全部[i]["網格"]) { 已網格區塊 = 加入(已網格區塊, 全部[i]); } }
        清單已變 = 假;
    }
    回傳 已網格區塊;
};
變數 載入進度 = 函式() {
    變數 R = 設定["distance"];
    變數 半 = R;
    如果 (半 > 6) { 半 = 6; }
    變數 總 = (2 * 半 + 1) * (2 * 半 + 1);
    變數 好 = 0;
    迴圈 (變數 dz = -半; dz <= 半; dz++) { 迴圈 (變數 dx = -半; dx <= 半; dx++) {
        如果 (世界.有區塊(中心cx + dx, 中心cz + dz)) { 如果 ((世界.取區塊(中心cx + dx, 中心cz + dz))["網格"]) { 好++; } }
    } }
    回傳 好 * 1.0d / 總;
};

# ---------- 天空與光照 Sky and lighting ----------
變數 平滑 = 函式(a, b, x) { 變數 t = (x - a) / (b - a); 如果 (t < 0) { t = 0.0d; } 如果 (t > 1) { t = 1.0d; } 回傳 t * t * (3.0d - 2.0d * t); };
變數 混合 = 函式(a, b, t) { 回傳 a + (b - a) * t; };
變數 太陽高度 = 函式() {
    變數 角 = (時刻 - 0.25d) * 6.2831853d;
    變數 太陽 = 相機.正規化(數學.Cos(角), 數學.Sin(角), 0.32d);
    回傳 太陽[1];
};
變數 影格資料 = 函式(眼, 前, 寬高比, 時間秒, 水下) {
    變數 角 = (時刻 - 0.25d) * 6.2831853d;
    變數 太陽 = 相機.正規化(數學.Cos(角), 數學.Sin(角), 0.32d);
    變數 白天 = 平滑(-0.10d, 0.18d, 太陽[1]);
    變數 夜 = 1.0d - 平滑(-0.22d, 0.04d, 太陽[1]);
    變數 光 = 太陽;
    變數 是月 = 太陽[1] < -0.04d;
    如果 (是月) { 光 = [-太陽[0], -太陽[1], -太陽[2]]; }
    變數 高 = 太陽[1]; 如果 (高 < 0) { 高 = 0.0d; }
    變數 暖 = 平滑(0.0d, 0.38d, 高);
    變數 光色 = [混合(1.9d, 2.3d, 暖) * 白天, 混合(0.9d, 2.2d, 暖) * 白天, 混合(0.4d, 2.02d, 暖) * 白天];
    如果 (是月) { 光色 = [0.045d * 夜, 0.06d * 夜, 0.11d * 夜]; }
    變數 環境 = [混合(0.012d, 0.32d, 白天), 混合(0.018d, 0.40d, 白天), 混合(0.04d, 0.58d, 白天)];
    變數 R = 設定["distance"] * 16.0d;
    變數 遠 = R * 1.6d + 96.0d;
    變數 投影 = 相機.透視(設定["fov"] * 0.0174533d, 寬高比, 0.05d, 遠);
    變數 vp = 相機.乘(投影, 相機.視圖(前));
    變數 陰影級 = 設定["shadows"];
    變數 範圍 = 陰影範圍表[陰影級];
    變數 陰影 = 陣列.建立(16, 0.0d);
    變數 有陰影 = 0.0d;
    如果 (陰影級 > 0 && 光[1] > 0.05d) {
        有陰影 = 1.0d;
        陰影 = 相機.陰影矩陣(光, 眼, [前[0] * 範圍 * 0.35d, 0.0d, 前[2] * 範圍 * 0.35d], 範圍, 陰影尺寸表[陰影級] * 1.0d);
    }
    變數 柔 = 1.6d;
    如果 (陰影級 == 3) { 柔 = 2.2d; }
    變數 曝光 = 混合(1.7d, 0.72d, 白天);
    變數 f = {};
    f["vp"] = vp;
    f["ivp"] = 數學.Inverse(vp);
    f["shadow"] = 陰影;
    f["camera"] = [眼[0], 眼[1], 眼[2], 時間秒];
    f["sunDir"] = [光[0], 光[1], 光[2], 白天];
    f["sunColor"] = [光色[0], 光色[1], 光色[2], 有陰影];
    f["ambient"] = [環境[0], 環境[1], 環境[2], 1.0d];
    f["horizon"] = [0.7d, 0.8d, 0.95d, R];
    變數 水 = 0.0d; 如果 (水下) { 水 = 1.0d; }
    f["params"] = [水, 設定["effects"] * 1.0d, 陰影尺寸表[陰影級] * 1.0d, 柔];
    f["params2"] = [0.36d, 0.0d, 0.0d, 夜];
    f["exposure"] = 曝光;
    f["shadowRange"] = 範圍;
    f["day"] = 白天;
    f["night"] = 夜;
    回傳 f;
};

# ---------- 介面狀態 Screen state ----------
變數 狀態 = "loading";
變數 返回狀態 = "title";
變數 懸停 = "";
變數 顯示除錯 = 假;
變數 fps = 0.0d;
變數 介面髒 = 真;
變數 訊息 = "";
變數 訊息時 = 0.0d;
變數 名稱顯示 = 0.0d;        # 切換快捷列時顯示物品名稱 Selected item name fades after switching

# 容器畫面資料。 Container screen data.
變數 介面模式 = "inv";
變數 合成格2 = 背包.新格位(4);
變數 合成格3 = 背包.新格位(9);
變數 輸出格 = 背包.新格位(1);
變數 目前箱子 = 背包.新格位(27);
變數 目前熔爐 = {};
變數 拖曳中 = 假;
變數 拖曳起 = ["", -1];
變數 右拖中 = 假;
變數 右拖已放 = {};
變數 滑鼠位置 = [0.0d, 0.0d];
變數 調試滑鼠 = [];   # 測試腳本指定的游標位置 Cursor position set by the test script

變數 提示 = 函式(文) { 訊息 = 文; 訊息時 = 2.0d; 介面髒 = 真; };

變數 設定列 = ["lang", "preset", "distance", "shadows", "effects", "scale", "sensitivity", "fov", "volume", "mobs", "fps"];
變數 設定標題 = ["Language", "Graphics preset", "Render distance", "Shadows", "Effects", "Render scale", "Mouse sensitivity", "Field of view", "Volume", "Night creatures", "Show FPS"];
變數 設定值文字 = 函式(k) {
    變數 v = 設定[k];
    如果 (k == "lang") { 回傳 語言.名稱(v); }
    如果 (k == "preset") { 回傳 預設名[v]; }
    如果 (k == "distance") { 回傳 語言.格式("{0} chunks", [v]); }
    如果 (k == "shadows") { 回傳 陰影名[v]; }
    如果 (k == "effects") { 如果 (v == 1) { 回傳 "High"; } 回傳 "Low"; }
    如果 (k == "scale" || k == "volume") { 回傳 字串.轉文字(v) + "%"; }
    如果 (k == "fov") { 回傳 語言.格式("{0} deg", [v]); }
    如果 (k == "fps" || k == "mobs") { 如果 (v) { 回傳 "On"; } 回傳 "Off"; }
    回傳 字串.轉文字(v);
};
# 切換語言：介面文字、視窗標題一起更新。 Switch language; UI text and the window title follow.
變數 切換語言 = 函式() {
    如果 (設定["lang"] == "zh") { 設定["lang"] = "en"; } 否則 { 設定["lang"] = "zh"; }
    語言.設定語言(設定["lang"]);
    窗.SetTitle(語言.譯("AquaCraft"));
    介面髒 = 真;
};
變數 調整設定 = 函式(k, 方向) {
    如果 (k == "lang") {
        切換語言();
    } 否則如果 (k == "preset") {
        變數 p = 設定["preset"] + 方向;
        如果 (p < 0) { p = 3; } 如果 (p > 3) { p = 0; }
        套用預設(p);
    } 否則 {
        如果 (k == "distance") { 設定[k] = 設定[k] + 方向 * 2; 如果 (設定[k] < 4) { 設定[k] = 4; } 如果 (設定[k] > 16) { 設定[k] = 16; } 完成 = 假; }
        如果 (k == "shadows") { 設定[k] = (設定[k] + 方向 + 4) % 4; }
        如果 (k == "effects") { 設定[k] = 1 - 設定[k]; }
        如果 (k == "scale") { 設定[k] = 設定[k] + 方向 * 10; 如果 (設定[k] < 50) { 設定[k] = 50; } 如果 (設定[k] > 100) { 設定[k] = 100; } }
        如果 (k == "sensitivity") { 設定[k] = 設定[k] + 方向; 如果 (設定[k] < 1) { 設定[k] = 1; } 如果 (設定[k] > 20) { 設定[k] = 20; } }
        如果 (k == "fov") { 設定[k] = 設定[k] + 方向 * 5; 如果 (設定[k] < 55) { 設定[k] = 55; } 如果 (設定[k] > 100) { 設定[k] = 100; } }
        如果 (k == "volume") { 設定[k] = 設定[k] + 方向 * 10; 如果 (設定[k] < 0) { 設定[k] = 0; } 如果 (設定[k] > 100) { 設定[k] = 100; } }
        如果 (k == "fps") { 設定[k] = !設定[k]; }
        如果 (k == "mobs") { 設定[k] = !設定[k]; 如果 (!設定[k]) { 怪物.清除(); } }
        如果 (k != "sensitivity" && k != "fov" && k != "volume" && k != "fps" && k != "mobs" && k != "lang") { 設定["preset"] = 4; }
    }
    套用畫質();
    存設定();
};

# ---------- 挖掘與互動狀態 Mining and interaction state ----------
變數 挖掘目標 = [假, 0, 0, 0];
變數 挖掘進度 = 0.0d;
變數 挖掘音計時 = 0.0d;
變數 破壞冷卻 = 0.0d;
變數 互動計時 = 0.0d;
變數 攻擊冷卻 = 0.0d;
變數 揮動 = 1.0d;
變數 外框目標 = [假, 0, 0, 0, 0.0d];

變數 手上 = 函式() { 回傳 (背包.格)[選取]; };

變數 建立介面 = 函式() {
    變數 W = 窗.PixelWidth; 變數 H = 窗.PixelHeight;
    變數 s = 介面.開始(W, H);
    如果 (狀態 == "loading") {
        介面.矩形(0, 0, W, H, 0.05d, 0.08d, 0.12d, 1.0d);
        介面.置中文字(W / 2, H / 2 - 40 * s, s * 3, "AquaCraft", 0.85d, 0.95d, 1.0d, 1.0d);
        變數 p = 載入進度();
        變數 bw = 160 * s; 變數 bx = (W - bw) / 2; 變數 by = H / 2 + 6 * s;
        介面.矩形(bx, by, bw, 6 * s, 0.15d, 0.2d, 0.26d, 1.0d);
        介面.矩形(bx, by, bw * p, 6 * s, 0.35d, 0.75d, 0.95d, 1.0d);
        介面.置中文字(W / 2, by + 14 * s, s, 語言.格式("Generating terrain... {0}%", [雜訊.取整(p * 100.0d)]), 0.8d, 0.88d, 0.95d, 1.0d);
    } 否則如果 (狀態 == "title") {
        介面.矩形(0, 0, W, H, 0.0d, 0.02d, 0.05d, 0.25d);
        # 中文標題字形較大，用 4 倍；英文用 5 倍。 The Chinese title glyphs are larger: x4 instead of x5.
        變數 標題倍 = 5; 如果 (語言.是中文()) { 標題倍 = 4; }
        介面.置中文字(W / 2, H / 5, s * 標題倍, "AquaCraft", 0.95d, 0.98d, 1.0d, 1.0d);
        介面.置中文字(W / 2, H / 5 + 46 * s, s, "Survive, gather and build - written in AquariusLang on WebGPU", 0.85d, 0.92d, 1.0d, 0.9d);
        變數 bw = 120 * s; 變數 bh = 20 * s; 變數 bx = (W - bw) / 2; 變數 by = H / 2 - 10 * s;
        介面.按鈕("play", bx, by, bw, bh, "Play", 懸停);
        介面.按鈕("new", bx, by + bh + 6 * s, bw, bh, "New World", 懸停);
        介面.按鈕("settings", bx, by + 2 * (bh + 6 * s), bw, bh, "Settings", 懸停);
        # 語言切換鈕（右上角）。 Language toggle, top right.
        變數 另一語 = "English"; 如果 (!語言.是中文()) { 另一語 = "繁體中文"; }
        變數 lw = 介面.文字寬(另一語, s) + 16 * s;
        介面.按鈕("lang", W - lw - 8 * s, 8 * s, lw, 16 * s, 另一語, 懸停);
        # 操作說明：行距隨語言調整（中文字較高）。 Controls panel; line pitch follows the language.
        變數 行 = 介面.行距() * s;
        變數 操作 = ["WASD  move    Mouse  look", "Space jump    Shift  sprint", "Hold left  mine / attack", "Right  place / use",
            "E  inventory    Q  drop", "1-9 / wheel  hotbar", "Esc  pause   F3  debug info"];
        變數 ph = 行 * 9 + 14 * s;
        變數 px = 12 * s; 變數 py = H - ph - 2 * s;
        變數 pw = 介面.文字寬("Punch trees, craft tools, light the night", s);
        迴圈 (變數 i = 0; i < 長度(操作); i++) { 變數 w = 介面.文字寬(操作[i], s); 如果 (w > pw) { pw = w; } }
        介面.面板(px - 6 * s, py - 6 * s, pw + 13 * s, ph);
        介面.文字(px, py, s, "Controls", 0.75d, 0.9d, 1.0d, 1.0d);
        迴圈 (變數 i = 0; i < 長度(操作); i++) {
            介面.文字(px, py + 2 * s + (i + 1) * 行, s, 操作[i], 0.9d, 0.92d, 0.95d, 1.0d);
        }
        介面.文字(px, py + 6 * s + 8 * 行, s, "Punch trees, craft tools, light the night", 0.65d, 0.75d, 0.85d, 1.0d);
    } 否則如果 (狀態 == "settings") {
        介面.矩形(0, 0, W, H, 0.0d, 0.02d, 0.05d, 0.55d);
        介面.置中文字(W / 2, 24 * s, s * 2, "Settings", 0.95d, 0.98d, 1.0d, 1.0d);
        變數 rw = 240 * s; 變數 rh = 18 * s; 變數 rx = (W - rw) / 2; 變數 ry = 52 * s;
        迴圈 (變數 i = 0; i < 長度(設定列); i++) {
            變數 y = ry + i * (rh + 4 * s);
            介面.面板(rx, y, rw, rh);
            介面.文字(rx + 8 * s, y + 5 * s, s, 設定標題[i], 0.85d, 0.92d, 1.0d, 1.0d);
            介面.按鈕(設定列[i] + ":-", rx + rw - 110 * s, y + 2 * s, 14 * s, rh - 4 * s, "<", 懸停);
            介面.置中文字(rx + rw - 55 * s, y + 5 * s, s, 設定值文字(設定列[i]), 1.0d, 1.0d, 1.0d, 1.0d);
            介面.按鈕(設定列[i] + ":+", rx + rw - 16 * s, y + 2 * s, 14 * s, rh - 4 * s, ">", 懸停);
        }
        變數 by = ry + 長度(設定列) * (rh + 4 * s) + 6 * s;
        介面.按鈕("back", (W - 100 * s) / 2, by, 100 * s, 20 * s, "Done", 懸停);
    } 否則 {
        # 遊戲 HUD。 In-game HUD.
        如果 (玩家.眼在水中) { 介面.矩形(0, 0, W, H, 0.02d, 0.18d, 0.25d, 0.12d); }
        如果 (受傷閃 > 0) { 介面.矩形(0, 0, W, H, 0.6d, 0.0d, 0.0d, 受傷閃 * 0.35d); }
        如果 (狀態 == "play") {
            介面.十字準星(W, H);
            庫介.挖掘指示(W, H, 挖掘進度);
            庫介.手持物品(W, H, 手上(), 揮動);
        }
        庫介.快捷列(W, H, 選取, 生命, 雜訊.取整(氧氣 + 0.99d), 玩家.眼在水中 || 氧氣 < 9.9d, 名稱顯示);
        如果 (設定["fps"] || 顯示除錯) {
            介面.文字(6 * s, 6 * s, s, 語言.格式("FPS {0}   chunks {1}/{2}", [雜訊.取整(fps + 0.5d), 繪.繪製區塊數, 長度(已網格區塊)]), 1.0d, 1.0d, 1.0d, 0.9d);
        }
        如果 (顯示除錯) {
            變數 p = 玩家.位置;
            介面.文字(6 * s, 18 * s, s, "XYZ " + 字串.轉文字(雜訊.取整(p[0])) + " " + 字串.轉文字(雜訊.取整(p[1])) + " " + 字串.轉文字(雜訊.取整(p[2])), 1.0d, 1.0d, 1.0d, 0.9d);
            介面.文字(6 * s, 30 * s, s, 語言.格式("Seed {0}   time {1}h   edits {2}", [種子, 雜訊.取整(時刻 * 24.0d), 世界.修改數]), 1.0d, 1.0d, 1.0d, 0.9d);
            介面.文字(6 * s, 42 * s, s, 語言.格式("Backend {0}   {1}x{2}   creatures {3}", [繪.裝置.Backend, 繪.內寬, 繪.內高, 怪物.數量()]), 1.0d, 1.0d, 1.0d, 0.9d);
        }
        如果 (訊息時 > 0) {
            變數 a = 訊息時; 如果 (a > 1) { a = 1.0d; }
            介面.置中文字(W / 2, H / 3, s, 訊息, 1.0d, 1.0d, 1.0d, a);
        }
        如果 (狀態 == "inventory") {
            變數 資料 = {"grid": 合成格2, "out": 輸出格, "chest": 目前箱子, "furnace": 目前熔爐};
            如果 (介面模式 == "table") { 資料["grid"] = 合成格3; }
            庫介.畫面(W, H, 介面模式, 資料, 滑鼠位置[0], 滑鼠位置[1]);
        }
        如果 (狀態 == "dead") {
            介面.矩形(0, 0, W, H, 0.35d, 0.0d, 0.0d, 0.45d);
            介面.置中文字(W / 2, H / 4, s * 3, "You died", 1.0d, 0.9d, 0.9d, 1.0d);
            介面.置中文字(W / 2, H / 4 + (24 + 介面.行距()) * s, s, "Your items were dropped where you fell", 0.95d, 0.85d, 0.85d, 1.0d);
            變數 bw = 120 * s; 變數 bh = 20 * s;
            介面.按鈕("respawn", (W - bw) / 2, H / 2, bw, bh, "Respawn", 懸停);
        }
        如果 (狀態 == "pause") {
            介面.矩形(0, 0, W, H, 0.0d, 0.02d, 0.05d, 0.5d);
            介面.置中文字(W / 2, H / 4, s * 3, "Paused", 0.95d, 0.98d, 1.0d, 1.0d);
            變數 bw = 120 * s; 變數 bh = 20 * s; 變數 bx = (W - bw) / 2; 變數 by = H / 2 - 20 * s;
            介面.按鈕("resume", bx, by, bw, bh, "Resume", 懸停);
            介面.按鈕("settings", bx, by + bh + 6 * s, bw, bh, "Settings", 懸停);
            介面.按鈕("save", bx, by + 2 * (bh + 6 * s), bw, bh, "Save & Title", 懸停);
            介面.置中文字(W / 2, by + 3 * (bh + 6 * s) + 8 * s, s, "World is saved automatically", 0.7d, 0.8d, 0.9d, 0.9d);
        }
    }
    繪.設定介面(介面.結束());
};

# ---------- 物品進出世界 Items entering and leaving the world ----------
變數 丟出堆疊 = 函式(id, n, d, 用力) {
    如果 (id == 0 || n <= 0) { 回傳 0; }
    變數 e = 玩家.眼睛(); 變數 fw = 玩家.前方();
    掉落.丟出(e[0] + fw[0] * 0.4d, e[1] - 0.3d + fw[1] * 0.4d, e[2] + fw[2] * 0.4d, id, n, d, fw[0] * 用力, fw[1] * 用力 + 2.0d, fw[2] * 用力, 1.5d);
    回傳 0;
};
變數 丟出溢出 = 函式(清單) {
    迴圈 (變數 i = 0; i < 長度(清單); i++) { 變數 s堆 = 清單[i]; 丟出堆疊(s堆[0], s堆[1], s堆[2], 3.0d); }
};

# ---------- 受傷與死亡 Damage and death ----------
變數 受傷 = 函式(量, 秒) {
    如果 (量 <= 0 || 狀態 == "dead") { 回傳 0; }
    生命 -= 量;
    受傷閃 = 1.0d;
    上次受傷 = 秒;
    聲.播放("hurt", 0.8d, 1.0d);
    介面髒 = 真;
    如果 (生命 <= 0) {
        生命 = 0;
        # 掉落所有物品。 Drop everything where the player fell.
        變數 p = 玩家.位置;
        迴圈 (變數 i = 0; i < 36; i++) {
            變數 s堆 = (背包.格)[i];
            如果 (s堆[0] != 0) { 掉落.彈出(雜訊.取整(p[0]), 雜訊.取整(p[1]), 雜訊.取整(p[2]), s堆[0], s堆[1], s堆[2]); }
        }
        背包.全部清空();
        挖掘進度 = 0.0d;
        窗.SetPointerLock(假);
        狀態 = "dead";
    }
    回傳 0;
};

變數 重生 = 函式() {
    玩家.設定位置(出生點[0], 出生點[1] + 0.5d, 出生點[2], 出生點[3], 0.0d);
    生命 = 20; 氧氣 = 10.0d; 受傷閃 = 0.0d;
};

# ---------- 挖掘與放置 Mining and placing ----------
變數 支撐檢查 = 函式(x, y, z) {
    # 上方的植物或火把失去支撐就掉落。 Plants and torches above lose their support.
    變數 上 = 世界.取方塊(x, y + 1, z);
    如果 (上 > 0 && (方塊.需支撐)[上]) {
        世界.設方塊(x, y + 1, z, 方塊.空氣);
        變數 掉 = 物品.掉落表(上, 0);
        迴圈 (變數 i = 0; i < 長度(掉); i++) { 掉落.彈出(x, y + 1, z, (掉[i])[0], (掉[i])[1], 0); }
    }
};

變數 破壞方塊 = 函式(x, y, z) {
    變數 held = 手上();
    變數 舊 = 世界.設方塊(x, y, z, 方塊.空氣);
    如果 (舊 <= 0) { 回傳 0; }
    聲.方塊聲((方塊.音材)[舊], "break");
    掉落.碎屑(x, y, z, (方塊.側面)[舊], 14, 1.0d);
    變數 掉 = 物品.掉落表(舊, held[0]);
    迴圈 (變數 i = 0; i < 長度(掉); i++) { 掉落.彈出(x, y, z, (掉[i])[0], (掉[i])[1], 0); }
    # 容器內容一起掉出。 Container contents spill out.
    如果 (方塊.是箱子(舊) || 方塊.是熔爐(舊)) {
        變數 內容 = 容器.移除(x, y, z);
        迴圈 (變數 i = 0; i < 長度(內容); i++) {
            變數 s堆 = 內容[i];
            如果 (s堆[0] != 0) { 掉落.彈出(x, y, z, s堆[0], s堆[1], s堆[2]); }
        }
    }
    支撐檢查(x, y, z);
    # 工具耗損。 Tool wear.
    如果 ((方塊.硬度)[舊] > 0 && 物品.是工具(held[0])) {
        變數 名 = 物品.名稱(held[0]);
        變數 量 = 1;
        如果 (物品.工具類(held[0]) == 4) { 量 = 2; }
        如果 (背包.磨損(held, 量)) {
            聲.播放("tool_break", 0.9d, 1.0d);
            變數 e = 玩家.眼睛(); 變數 fw = 玩家.前方();
            掉落.碎屑(雜訊.取整(e[0] + fw[0]) * 1.0d, e[1] - 0.8d, 雜訊.取整(e[2] + fw[2]) * 1.0d, 5, 10, 0.6d);
            提示(語言.格式("{0} broke!", [名]));
        }
    }
    重建髒區塊();
    回傳 舊;
};

# 放置時正面朝向玩家。 Facing blocks turn their front toward the player.
變數 朝向玩家面 = 函式() {
    變數 fw = 玩家.前方();
    變數 ax = fw[0]; 變數 az = fw[2];
    如果 (ax < 0) { ax = -ax; } 如果 (az < 0) { az = -az; }
    如果 (ax > az) { 如果 (fw[0] > 0) { 回傳 1; } 回傳 0; }
    如果 (fw[2] > 0) { 回傳 5; }
    回傳 4;
};

變數 開啟容器 = 函式(模式, x, y, z) {
    介面模式 = 模式;
    如果 (模式 == "chest") { 目前箱子 = 容器.取箱子(x, y, z); }
    如果 (模式 == "furnace") { 目前熔爐 = 容器.取熔爐(x, y, z); }
    窗.SetPointerLock(假);
    狀態 = "inventory";
    挖掘進度 = 0.0d;
    聲.播放("click", 0.5d, 0.8d);
    介面髒 = 真;
};

變數 使用 = 函式(r) {
    變數 目標 = 世界.取方塊(r[1], r[2], r[3]);
    如果 (目標 == 方塊.工作台) { 開啟容器("table", r[1], r[2], r[3]); 回傳 真; }
    如果 (目標 > 0 && 方塊.是熔爐(目標)) { 開啟容器("furnace", r[1], r[2], r[3]); 回傳 真; }
    如果 (目標 > 0 && 方塊.是箱子(目標)) { 開啟容器("chest", r[1], r[2], r[3]); 回傳 真; }
    變數 held = 手上();
    變數 id = held[0];
    如果 (!物品.可放置(id)) { 回傳 假; }
    變數 x = r[4]; 變數 y = r[5]; 變數 z = r[6];
    變數 目前 = 世界.取方塊(x, y, z);
    如果 (目前 < 0 || !方塊.可替換(目前) || y < 1 || y > 126) { 回傳 假; }
    如果 ((方塊.實體)[id] && 玩家.佔據(x, y, z)) { 回傳 假; }
    如果 ((方塊.需支撐)[id]) {
        變數 下 = 世界.取方塊(x, y - 1, z);
        如果 (下 <= 0 || (方塊.種類)[下] != 1) { 回傳 假; }
    }
    變數 放 = 方塊.朝向方塊(id, 朝向玩家面());
    世界.設方塊(x, y, z, 放);
    背包.減少(held, 1);
    聲.方塊聲((方塊.音材)[id], "place");
    重建髒區塊();
    回傳 真;
};

# 每影格的挖掘、攻擊與放置。 Mining, attacking and placing each frame.
變數 互動 = 函式(左持, 左按, 右持, 右按, dt, 秒) {
    變數 r = 玩家.射線();
    變數 eye = 玩家.眼睛();
    變數 fw = 玩家.前方();
    變數 怪 = 怪物.射線命中(eye, fw, 3.5d);
    互動計時 -= dt; 攻擊冷卻 -= dt; 破壞冷卻 -= dt;
    如果 (揮動 < 1) { 揮動 = 揮動 + dt * 3.5d; }
    # 方塊距離。 Distance to the targeted block.
    變數 方塊距 = 100.0d;
    如果 (r[0]) {
        變數 bx = r[1] + 0.5d - eye[0]; 變數 by = r[2] + 0.5d - eye[1]; 變數 bz = r[3] + 0.5d - eye[2];
        方塊距 = 數學.Sqrt(bx * bx + by * by + bz * bz) - 0.5d;
    }
    # 攻擊怪物。 Attack a creature in front of the block.
    如果 (怪[1] >= 0 && 怪[0] < 方塊距) {
        外框目標 = [假, 0, 0, 0, 0.0d];
        挖掘進度 = 0.0d;
        如果 (左按 && 攻擊冷卻 <= 0) {
            攻擊冷卻 = 0.45d; 揮動 = 0.0d;
            變數 held = 手上();
            變數 死 = 怪物.受擊(怪[1], 物品.攻擊力(held[0]), fw[0], fw[2]);
            聲.播放("hit", 0.8d, 1.0d);
            如果 (物品.是工具(held[0])) {
                變數 量 = 2; 如果 (物品.工具類(held[0]) == 4) { 量 = 1; }
                如果 (背包.磨損(held, 量)) { 聲.播放("tool_break", 0.9d, 1.0d); 提示("Your tool broke!"); }
            }
        }
        回傳 0;
    }
    如果 (r[0]) {
        外框目標 = [真, r[1] - eye[0], r[2] - eye[1], r[3] - eye[2], 挖掘進度];
    } 否則 { 外框目標 = [假, 0, 0, 0, 0.0d]; }
    # 按住左鍵挖掘。 Hold to mine.
    如果 (左持 && r[0]) {
        如果 (!挖掘目標[0] || 挖掘目標[1] != r[1] || 挖掘目標[2] != r[2] || 挖掘目標[3] != r[3]) {
            挖掘目標 = [真, r[1], r[2], r[3]];
            挖掘進度 = 0.0d;
        }
        變數 id = 世界.取方塊(r[1], r[2], r[3]);
        變數 held = 手上();
        變數 時間 = 物品.挖掘時間(held[0], id);
        如果 (時間 >= 0 && 破壞冷卻 <= 0) {
            如果 (時間 <= 0.0001d) { 挖掘進度 = 1.0d; } 否則 { 挖掘進度 = 挖掘進度 + dt / 時間; }
            挖掘音計時 -= dt;
            如果 (挖掘音計時 <= 0) {
                挖掘音計時 = 0.24d; 揮動 = 0.0d;
                聲.方塊聲((方塊.音材)[id], "step");
                掉落.碎屑(r[1], r[2], r[3], (方塊.側面)[id], 2, 0.4d);
            }
            如果 (挖掘進度 >= 1.0d) {
                破壞方塊(r[1], r[2], r[3]);
                挖掘進度 = 0.0d; 挖掘目標 = [假, 0, 0, 0];
                破壞冷卻 = 0.18d;
            }
        }
        外框目標[4] = 挖掘進度;
    } 否則 {
        挖掘進度 = 0.0d; 挖掘目標 = [假, 0, 0, 0];
    }
    # 右鍵：使用或放置。 Right: use a station or place a block.
    如果 (r[0] && (右按 || (右持 && 互動計時 <= 0))) {
        如果 (使用(r)) { 揮動 = 0.0d; }
        互動計時 = 0.22d;
    }
    回傳 0;
};

# ---------- 容器畫面的滑鼠操作 Container screen input ----------
變數 目前網格 = 函式() { 如果 (介面模式 == "table") { 回傳 合成格3; } 回傳 合成格2; };
變數 網格大小 = 函式() { 如果 (介面模式 == "table") { 回傳 3; } 回傳 2; };

變數 區域陣列 = 函式(名) {
    如果 (名 == "main") { 回傳 背包.格; }
    如果 (名 == "grid") { 回傳 目前網格(); }
    如果 (名 == "chest") { 回傳 目前箱子; }
    如果 (名 == "furnace") { 回傳 目前熔爐["格"]; }
    回傳 [];
};

變數 更新輸出 = 函式() {
    變數 r = 合成.比對(目前網格(), 網格大小());
    如果 (r >= 0) {
        變數 R = 合成.取得(r);
        背包.設定(輸出格[0], R[4], R[5], 0);
    } 否則 { 背包.清空(輸出格[0]); }
};

# 取走合成輸出。 Collect the crafted output.
變數 取輸出 = 函式(全部) {
    變數 次 = 0;
    迴圈 (變數 k = 0; k < 64; k++) {
        更新輸出();
        變數 o = 輸出格[0];
        如果 (o[0] == 0) { 中斷; }
        如果 (全部) {
            如果 (!背包.可容納(o[0], o[1], 0)) { 中斷; }
            背包.加入(o[0], o[1], 0);
        } 否則 {
            變數 h = 背包.手持;
            如果 (h[0] == 0) { 背包.設定(h, o[0], o[1], 0); }
            否則如果 (h[0] == o[0] && h[2] == 0 && h[1] + o[1] <= 物品.最大堆疊(o[0])) { h[1] = h[1] + o[1]; }
            否則 { 中斷; }
        }
        合成.消耗(目前網格(), 網格大小(), 背包);
        次++;
        如果 (!全部) { 中斷; }
    }
    如果 (次 > 0) { 聲.播放("click", 0.5d, 1.3d); }
    更新輸出();
};

# 熔爐輸出只能取出。 The furnace output can only be taken.
變數 取出到游標 = 函式(陣, i) {
    變數 s堆 = 陣[i]; 變數 h = 背包.手持;
    如果 (s堆[0] == 0) { 回傳 0; }
    如果 (h[0] == 0) { 背包.複製到(h, s堆); 背包.清空(s堆); }
    否則如果 (h[0] == s堆[0] && h[1] + s堆[1] <= 物品.最大堆疊(h[0])) { h[1] = h[1] + s堆[1]; 背包.清空(s堆); }
    背包.變更();
    回傳 0;
};

變數 Shift鍵 = 函式() { 回傳 窗.KeyDown(340) || 窗.KeyDown(344); };

# Shift 點擊的去向。 Where a shift-click sends a stack.
變數 快速轉移 = 函式(名, i) {
    如果 (名 == "main") {
        如果 (介面模式 == "chest") { 背包.快速移動(背包.格, i, 目前箱子, 0, 27); 回傳 0; }
        如果 (介面模式 == "furnace") {
            變數 id = ((背包.格)[i])[0];
            如果 (物品.熔煉(id) > 0) { 背包.快速移動(背包.格, i, 目前熔爐["格"], 0, 1); 回傳 0; }
            如果 (物品.燃料(id) > 0) { 背包.快速移動(背包.格, i, 目前熔爐["格"], 1, 2); 回傳 0; }
        }
        如果 (i < 9) { 背包.快速移動(背包.格, i, 背包.格, 9, 36); } 否則 { 背包.快速移動(背包.格, i, 背包.格, 0, 9); }
        回傳 0;
    }
    背包.快速移動(區域陣列(名), i, 背包.格, 0, 36);
    回傳 0;
};

變數 關閉容器 = 函式() {
    丟出溢出(合成.退回(合成格2, 背包));
    丟出溢出(合成.退回(合成格3, 背包));
    變數 h = 背包.手持;
    如果 (h[0] != 0) {
        變數 剩 = 背包.加入(h[0], h[1], h[2]);
        如果 (剩 > 0) { 丟出堆疊(h[0], 剩, h[2], 3.0d); }
        背包.清空(h);
    }
    背包.清空(輸出格[0]);
    拖曳中 = 假; 右拖中 = 假;
};

變數 容器輸入 = 函式() {
    變數 m = 滑鼠位置;
    變數 命 = 庫介.命中(m[0], m[1]);
    變數 名 = 命[0]; 變數 i = 命[1];
    變數 按左 = 窗.MousePressed(0); 變數 放左 = 窗.MouseReleased(0);
    變數 按右 = 窗.MousePressed(1);
    如果 (按左) {
        如果 (名 == "out") { 取輸出(Shift鍵()); }
        否則如果 (名 == "recipe") {
            變數 R = 合成.取得(i);
            如果 (合成.可製作(R, 網格大小(), 背包, 目前網格())) {
                丟出溢出(合成.自動填入(R, 目前網格(), 網格大小(), 背包));
                聲.播放("click", 0.5d, 1.1d);
            }
        } 否則如果 (名 == "furnace" && i == 2) {
            如果 (Shift鍵()) { 快速轉移(名, i); } 否則 { 取出到游標(目前熔爐["格"], 2); }
        } 否則如果 (名 != "") {
            如果 (Shift鍵()) { 快速轉移(名, i); }
            否則 {
                變數 原本空 = (背包.手持)[0] == 0;
                背包.左鍵(區域陣列(名), i);
                # 拿起後可拖到別格放下。 Picking up starts a drag-and-drop.
                如果 (原本空 && (背包.手持)[0] != 0) { 拖曳中 = 真; 拖曳起 = [名, i]; } 否則 { 拖曳中 = 假; }
            }
        } 否則如果 (!庫介.在面板內(m[0], m[1]) && (背包.手持)[0] != 0) {
            # 點到面板外：丟出游標上的物品。 Clicking outside the panels throws the held stack.
            變數 h = 背包.手持;
            丟出堆疊(h[0], h[1], h[2], 4.0d);
            背包.清空(h); 背包.變更();
        }
    }
    # 以按鍵狀態判斷放開，即使同一影格內按下又放開也不會遺漏。 Use the held state so no release is missed.
    如果 (拖曳中 && (放左 || !窗.MouseDown(0))) {
        如果 (名 != "" && 名 != "out" && 名 != "recipe" && !(名 == "furnace" && i == 2) && (名 != 拖曳起[0] || i != 拖曳起[1]) && (背包.手持)[0] != 0) {
            背包.左鍵(區域陣列(名), i);
        }
        拖曳中 = 假;
    }
    # 右鍵：拿一半或放一個；按住拖曳可逐格分配。 Right: take half or place one; drag to spread.
    如果 (按右 && 名 != "" && 名 != "out" && 名 != "recipe" && !(名 == "furnace" && i == 2)) {
        變數 原本有 = (背包.手持)[0] != 0;
        背包.右鍵(區域陣列(名), i);
        如果 (原本有) { 右拖中 = 真; 右拖已放 = {}; 右拖已放[名 + 字串.轉文字(i)] = 真; }
    } 否則如果 (窗.MouseDown(1) && 右拖中 && 名 != "" && 名 != "out" && 名 != "recipe" && !(名 == "furnace" && i == 2)) {
        變數 k = 名 + 字串.轉文字(i);
        如果 (!雜湊.包含鍵(右拖已放, k)) { 右拖已放[k] = 真; 背包.放一個(區域陣列(名), i); }
    }
    如果 (!窗.MouseDown(1)) { 右拖中 = 假; }
    # 數字鍵與快捷列交換；Q 丟出一個。 Number keys swap with the hotbar; Q drops one.
    如果 (名 != "" && 名 != "out" && 名 != "recipe") {
        迴圈 (變數 k = 0; k < 9; k++) { 如果 (窗.KeyPressed(49 + k)) { 背包.與快捷列交換(區域陣列(名), i, k); } }
        如果 (窗.KeyPressed(81)) {
            變數 s堆 = (區域陣列(名))[i];
            如果 (s堆[0] != 0) { 丟出堆疊(s堆[0], 1, s堆[2], 4.0d); 背包.減少(s堆, 1); }
        }
    }
    更新輸出();
};

# ---------- 自動測試 Automated test driver ----------
變數 調試索引 = 0; 變數 調試等待 = 0; 變數 調試輸入 = [0.0d, 0.0d, 0, 0, 0];
變數 調試左 = 假; 變數 調試右 = 假; 變數 調試挖 = 0; 變數 調試持挖 = 假; 變數 調試等秒 = 0.0d;
變數 調試步 = 函式(dt) {
    調試左 = 假; 調試右 = 假;
    如果 (調試等秒 > 0) { 調試等秒 -= dt; 回傳 0; }
    如果 (調試挖 > 0) { 調試挖 -= 1; 回傳 0; }
    如果 (調試輸入[2] > 0) { 調試輸入[2] = 調試輸入[2] - 1; 回傳 0; }
    調試輸入 = [0.0d, 0.0d, 0, 0, 0];
    如果 (調試等待 > 0) { 調試等待 -= 1; 回傳 0; }
    如果 (調試索引 >= 長度(調試.步驟)) { 回傳 0; }
    變數 a = (調試.步驟)[調試索引];
    調試索引++;
    印出("debug step", a[0]);
    如果 (a[0] == "wait") { 調試等待 = a[1]; }
    如果 (a[0] == "waits") { 調試等秒 = a[1]; }
    如果 (a[0] == "capture") { 繪.要求截圖(目前工作目錄 + "/" + a[1] + ".png"); 調試等待 = 2; }
    如果 (a[0] == "play") { 狀態 = "play"; 介面髒 = 真; }
    如果 (a[0] == "move") { 調試輸入 = [a[1], a[2], a[3], a[4], a[5]]; }
    如果 (a[0] == "look") { 玩家.轉動(a[1], a[2]); }
    如果 (a[0] == "mine") { 調試挖 = a[1]; }
    如果 (a[0] == "minehold") { 調試持挖 = 真; }
    如果 (a[0] == "minestop") { 調試持挖 = 假; }
    如果 (a[0] == "pitch") { 變數 fp = 玩家.位置; 玩家.設定位置(fp[0], fp[1], fp[2], 玩家.偏航, a[1]); }
    如果 (a[0] == "turn") { 變數 fp = 玩家.位置; 玩家.設定位置(fp[0], fp[1], fp[2], 玩家.偏航 + a[1], 玩家.俯仰); }
    如果 (a[0] == "throw") { 變數 h = 手上(); 如果 (h[0] != 0) { 丟出堆疊(h[0], a[1], h[2], 3.0d); 背包.減少(h, a[1]); } }
    如果 (a[0] == "use") { 調試右 = 真; }
    如果 (a[0] == "slot") { 選取 = a[1]; 名稱顯示 = 2.0d; 介面髒 = 真; }
    如果 (a[0] == "give") { 背包.加入(a[1], a[2], 0); }
    如果 (a[0] == "time") { 時刻 = a[1]; }
    如果 (a[0] == "home") { 玩家.設定位置(出生點[0], 出生點[1], 出生點[2], 出生點[3], a[1]); }
    如果 (a[0] == "face") { 變數 fp = 玩家.位置; 玩家.設定位置(fp[0], fp[1], fp[2], a[1], a[2]); }
    如果 (a[0] == "tp") { 玩家.設定位置(a[1], a[2], a[3], 玩家.偏航, 玩家.俯仰); }
    如果 (a[0] == "openinv") { 介面模式 = "inv"; 狀態 = "inventory"; }
    如果 (a[0] == "lang") { 切換語言(); }
    如果 (a[0] == "state") { 狀態 = a[1]; 介面髒 = 真; }
    如果 (a[0] == "msg") { 提示(語言.格式(a[1], [a[2]])); }
    如果 (a[0] == "close") { 關閉容器(); 狀態 = "play"; }
    如果 (a[0] == "mouse") { 調試滑鼠 = [a[1] * 窗.PixelWidth, a[2] * 窗.PixelHeight]; 滑鼠位置 = 調試滑鼠; }
    如果 (a[0] == "craft") {
        # 用配方指南的流程製作：自動填入後取走輸出。 Craft through the recipe-guide path.
        迴圈 (變數 r = 0; r < 合成.數量(); r++) {
            變數 R = 合成.取得(r);
            如果 (R[4] == a[1] && 合成.可製作(R, 網格大小(), 背包, 目前網格())) {
                丟出溢出(合成.自動填入(R, 目前網格(), 網格大小(), 背包));
                迴圈 (變數 k = 0; k < a[2]; k++) { 取輸出(真); 如果 (k + 1 < a[2]) { 丟出溢出(合成.自動填入(R, 目前網格(), 網格大小(), 背包)); } }
                中斷;
            }
        }
        更新輸出();
    }
    如果 (a[0] == "hurt") { 受傷(a[1], 0.0d); }
    如果 (a[0] == "savecheck") {
        # 存檔來回測試：序列化後再解析，比對背包、容器與修改。 Save round trip check.
        變數 資料 = 存檔資料();
        變數 位元 = 序列.Binary(資料, 1);
        變數 r = 序列.TryParseBinary(位元);
        如果 (!r.ok) { 印出("savecheck: parse failed"); } 否則 {
            變數 回 = r.value;
            變數 a1 = 資料["inv"]; 變數 b1 = 回["inv"];
            變數 同 = 長度(a1) == 長度(b1);
            迴圈 (變數 i = 0; i < 長度(a1) && 同; i++) { 如果 (a1[i] != b1[i]) { 同 = 假; } }
            變數 箱數 = 長度(雜湊.鍵列表((回["containers"])["chests"]));
            變數 爐數 = 長度(雜湊.鍵列表((回["containers"])["furnaces"]));
            印出("savecheck inventory match", 同, "edits", 長度(回["edits"]) / 3, "chests", 箱數, "furnaces", 爐數);
        }
    }
    如果 (a[0] == "hold") {
        # 把某物品換到快捷列第 0 格並選取。 Move an item into hotbar slot 0 and select it.
        迴圈 (變數 i = 0; i < 36; i++) {
            如果 (((背包.格)[i])[0] == a[1]) { 如果 (i != 0) { 背包.交換內容((背包.格)[i], (背包.格)[0]); } 中斷; }
        }
        選取 = 0; 名稱顯示 = 2.0d;
    }
    如果 (a[0] == "fillfurnace") {
        如果 (介面模式 == "furnace") {
            變數 g = 目前熔爐["格"];
            如果 (背包.取走(a[1], a[2]) == a[2]) { 背包.設定(g[0], a[1], a[2], 0); }
            如果 (背包.取走(a[3], a[4]) == a[4]) { 背包.設定(g[1], a[3], a[4], 0); }
        }
    }
    如果 (a[0] == "dump") {
        變數 文 = "inv:";
        迴圈 (變數 i = 0; i < 36; i++) { 變數 s堆 = (背包.格)[i]; 如果 (s堆[0] != 0) { 文 = 文 + " " + 物品.名稱(s堆[0]) + "x" + 字串.轉文字(s堆[1]); } }
        印出(文, "health", 生命, "creatures", 怪物.數量());
    }
    如果 (a[0] == "quit") { 窗.Close(); }
    如果 (a[0] == "surface") {
        變數 p = 玩家.位置;
        迴圈 (變數 y = 125; y > 1; y -= 1) {
            變數 id = 世界.取方塊(雜訊.取整(p[0]), y, 雜訊.取整(p[2]));
            如果 (id > 0 && id != 方塊.水) { 玩家.設定位置(p[0], y + 1.0d, p[2], 玩家.偏航, 玩家.俯仰); 中斷; }
        }
    }
    如果 (a[0] == "seekwater") {
        # 以同心圓搜尋已載入範圍內最深的水（深度相近時取最近者）。 Ring search for the deepest nearby water.
        變數 p = 玩家.位置; 變數 最佳深 = 0; 變數 bx = 0; 變數 bz = 0; 變數 b角 = 0.0d;
        迴圈 (變數 r = 4; r < 180; r += 4) {
            變數 段 = 雜訊.取整(r * 0.75d) + 8;
            迴圈 (變數 k = 0; k < 段; k++) {
                變數 角 = k * 6.2831853d / 段;
                變數 wx = 雜訊.取整(p[0] + 數學.Cos(角) * r); 變數 wz = 雜訊.取整(p[2] + 數學.Sin(角) * r);
                如果 (世界.取方塊(wx, 51, wz) == 方塊.水) {
                    變數 深 = 1;
                    迴圈 (變數 y = 50; y > 30 && 世界.取方塊(wx, y, wz) == 方塊.水; y -= 1) { 深 += 1; }
                    如果 (深 > 最佳深 + 1) { 最佳深 = 深; bx = wx; bz = wz; b角 = 角; }
                }
            }
        }
        如果 (最佳深 > 0) {
            變數 ty = a[1];
            如果 (ty < 0) { ty = 52.0d - 最佳深 + 0.05d; }
            玩家.設定位置(bx + 0.5d, ty, bz + 0.5d, -b角 - 1.5707963d, a[2]);
        }
    }
    如果 (a[0] == "findtree") {
        # 面向最近的樹幹（測試採集）。 Walk up to the nearest tree trunk for the gathering test.
        變數 p = 玩家.位置; 變數 找到 = 假;
        迴圈 (變數 r = 1; r < 60 && !找到; r++) {
            迴圈 (變數 dz = -r; dz <= r && !找到; dz++) {
                迴圈 (變數 dx = -r; dx <= r && !找到; dx++) {
                    如果 (dx == -r || dx == r || dz == -r || dz == r) {
                        變數 tx = 雜訊.取整(p[0]) + dx; 變數 tz = 雜訊.取整(p[2]) + dz;
                        迴圈 (變數 y = 雜訊.取整(p[1]) - 8; y < 雜訊.取整(p[1]) + 14 && !找到; y++) {
                            如果 (世界.取方塊(tx, y, tz) == 方塊.原木 && 世界.取方塊(tx, y - 1, tz) != 方塊.原木) {
                                # 站在樹幹旁一格、面向樹幹。 Stand one block away facing the trunk.
                                變數 sx = tx + 1; 變數 sz = tz;
                                如果 (世界.取方塊(sx, y, sz) != 0 || 世界.取方塊(sx, y + 1, sz) != 0) { sx = tx - 1; }
                                玩家.設定位置(sx + 0.5d, y * 1.0d, sz + 0.5d, 0.0d, -0.05d);
                                變數 yaw = -1.5707963d; 如果 (sx < tx) { yaw = 1.5707963d; }
                                玩家.設定位置(sx + 0.5d, y * 1.0d, sz + 0.5d, yaw, -0.05d);
                                找到 = 真;
                            }
                        }
                    }
                }
            }
        }
        如果 (!找到) { 印出("findtree: none"); }
    }
    回傳 0;
};

# ---------- 主迴圈 Main loop ----------
開始世界(種子, 存檔 != 空);
套用畫質();
變數 上次 = 目前時間();
變數 啟動秒 = 目前時間();
變數 鎖定請求時 = -10.0d;
變數 曾鎖定 = 假;     # 本次進入遊戲後是否取得過指標鎖定 Did pointer lock succeed since entering play?
變數 無鎖提示 = 假;
變數 自動存檔 = 0.0d;
變數 fps累計 = 0.0d; 變數 fps影格 = 0;
變數 標題時間 = 0.0d;
變數 最後白天 = 1.0d; 變數 最後夜 = 0.0d;
變數 上次簽 = [];
變數 進入遊戲 = 函式() {
    聲.啟動();
    聲.設定音量(設定["volume"] / 100.0d);
    窗.SetPointerLock(真);
    鎖定請求時 = (目前時間() - 啟動秒) / 1000.0d;
    曾鎖定 = 假; 無鎖提示 = 假;
    狀態 = "play";
    介面髒 = 真;
};
變數 滑鼠像素 = 函式() {
    變數 sx = 1.0d;
    如果 (窗.Width > 0) { sx = 窗.PixelWidth * 1.0d / 窗.Width; }
    回傳 [窗.MouseX * sx, 窗.MouseY * sx];
};

迴圈 (變數 運行 = 真; 運行; 運行 = 運行) {
    窗.Poll();
    如果 (窗.ShouldClose) { 中斷; }
    變數 現在 = 目前時間();
    變數 dt = (現在 - 上次) / 1000.0d;
    上次 = 現在;
    如果 (dt > 0.1d) { dt = 0.1d; }
    變數 秒 = (現在 - 啟動秒) / 1000.0d;
    fps累計 += dt; fps影格++;
    如果 (fps累計 >= 0.5d) { fps = fps影格 / fps累計; fps累計 = 0.0d; fps影格 = 0; 介面髒 = 真; 如果 (調試.啟用 && 雜訊.取整(秒) % 5 == 0) { 印出("fps", fps, 狀態, 長度(已網格區塊)); } }
    如果 (窗.PixelWidth > 0 && 窗.PixelHeight > 0) {
        如果 (窗.Resized) { 套用畫質(); 介面髒 = 真; }
        變數 p = 玩家.位置;
        # 串流預算：載入時盡量多做，遊戲中每影格約 6 毫秒。 Streaming budget per frame.
        變數 預算 = 6.0d;
        如果 (狀態 == "loading") { 預算 = 40.0d; }
        如果 (狀態 == "title" || 狀態 == "pause" || 狀態 == "settings") { 預算 = 12.0d; }
        串流(p[0], p[2], 預算);
        如果 (狀態 == "loading") {
            介面髒 = 真;
            如果 (載入進度() >= 1.0d) {
                # 安全出生：往上找到兩格空氣。 Safe spawn: rise until two air blocks.
                迴圈 (變數 k = 0; k < 140 && 玩家.碰撞(p[0], p[1], p[2]); k++) { p[1] = p[1] + 1.0d; }
                狀態 = "title";
            }
        }
        變數 m = 滑鼠像素();
        如果 (長度(調試滑鼠) == 2) { m = 調試滑鼠; }
        滑鼠位置 = m;
        變數 新懸停 = 介面.點擊(m[0], m[1]);
        如果 (新懸停 != 懸停) { 懸停 = 新懸停; 介面髒 = 真; }
        變數 點 = 窗.MousePressed(0);
        如果 (調試.啟用 && 狀態 != "loading") { 調試步(dt); }
        變數 遊戲進行 = 狀態 == "play" || 狀態 == "inventory" || 狀態 == "dead";
        如果 (狀態 == "title") {
            標題時間 += dt;
            如果 (點 && 懸停 == "play") { 聲.啟動(); 聲.播放("click", 0.7d, 1.0d); 進入遊戲(); }
            否則如果 (點 && 懸停 == "new") {
                聲.啟動(); 聲.播放("click", 0.7d, 1.0d);
                存檔 = 空;
                變數 新 = 雜訊.取整((目前時間() * 7919.0d) % 900000.0d) + 字串.字元碼(目前日期(), 9) * 1000;
                繪.裝置.Poll();
                變數 全部 = 世界.全部區塊();
                迴圈 (變數 i = 0; i < 長度(全部); i++) { 繪.釋放區塊(全部[i]); }
                開始世界(新, 假);
                中心cx = 99999; 清單已變 = 真; 狀態 = "loading";
            } 否則如果 (點 && 懸停 == "settings") { 聲.播放("click", 0.7d, 1.0d); 返回狀態 = "title"; 狀態 = "settings"; 介面髒 = 真; }
            否則如果 (點 && 懸停 == "lang") { 聲.播放("click", 0.7d, 1.0d); 切換語言(); 存設定(); }
        } 否則如果 (狀態 == "settings") {
            如果 (點 && 懸停 != "") {
                聲.播放("click", 0.6d, 1.0d);
                如果 (懸停 == "back") { 狀態 = 返回狀態; } 否則 {
                    變數 部 = 字串.分割(懸停, ":");
                    變數 方向 = 1;
                    如果 (部[1] == "-") { 方向 = -1; }
                    調整設定(部[0], 方向);
                }
                介面髒 = 真;
            }
            如果 (窗.KeyPressed(256)) { 狀態 = 返回狀態; 介面髒 = 真; }
        } 否則如果 (狀態 == "pause") {
            如果 (點 && 懸停 == "resume") { 聲.播放("click", 0.6d, 1.0d); 進入遊戲(); }
            否則如果 (點 && 懸停 == "settings") { 聲.播放("click", 0.6d, 1.0d); 返回狀態 = "pause"; 狀態 = "settings"; 介面髒 = 真; }
            否則如果 (點 && 懸停 == "save") { 聲.播放("click", 0.6d, 1.0d); 儲存(); 狀態 = "title"; 介面髒 = 真; }
            否則如果 (窗.KeyPressed(256)) { 進入遊戲(); }
        } 否則如果 (狀態 == "dead") {
            如果 (點 && 懸停 == "respawn") { 重生(); 進入遊戲(); }
        } 否則如果 (狀態 == "inventory") {
            容器輸入();
            如果 (窗.KeyPressed(69) || 窗.KeyPressed(256)) { 關閉容器(); 進入遊戲(); }
        } 否則如果 (狀態 == "play") {
            # 失去指標鎖定（Esc 或切換視窗）時暫停。 Pause when pointer lock is lost.
            如果 (窗.PointerLocked) { 曾鎖定 = 真; }
            # 頁面不允許指標鎖定（例如內嵌瀏覽器）時改以一般滑鼠移動轉視角，不暫停。
            # Where pointer lock is not permitted (some embedded browsers) keep playing with plain mouse motion.
            如果 (!曾鎖定 && !無鎖提示 && !調試.啟用 && 秒 - 鎖定請求時 > 1.0d) { 無鎖提示 = 真; 提示("Pointer lock unavailable - move the mouse to look"); }
            如果 (!調試.啟用 && (窗.KeyPressed(256) || (曾鎖定 && !窗.PointerLocked) || !窗.Focused)) {
                窗.SetPointerLock(假); 狀態 = "pause"; 儲存(); 介面髒 = 真;
            } 否則 {
                變數 sens = 設定["sensitivity"] * 0.00032d;
                玩家.轉動(-窗.MouseDeltaX * sens, -窗.MouseDeltaY * sens);
                迴圈 (變數 k = 0; k < 9; k++) { 如果 (窗.KeyPressed(49 + k)) { 選取 = k; 名稱顯示 = 2.0d; } }
                如果 (窗.Wheel > 0.3d) { 選取 = (選取 + 8) % 9; 名稱顯示 = 2.0d; }
                如果 (窗.Wheel < -0.3d) { 選取 = (選取 + 1) % 9; 名稱顯示 = 2.0d; }
                如果 (窗.KeyPressed(292)) { 顯示除錯 = !顯示除錯; }
                如果 (窗.KeyPressed(69)) { 開啟容器("inv", 0, 0, 0); }
                如果 (窗.KeyPressed(81)) {
                    變數 h = 手上();
                    如果 (h[0] != 0) {
                        變數 數 = 1;
                        如果 (窗.KeyDown(341) || 窗.KeyDown(345)) { 數 = h[1]; }
                        丟出堆疊(h[0], 數, h[2], 6.0d);
                        背包.減少(h, 數);
                    }
                }
                如果 (狀態 == "play") {
                    互動(窗.MouseDown(0) || 調試挖 > 0 || 調試持挖, 窗.MousePressed(0) || 調試左, 窗.MouseDown(1), 窗.MousePressed(1) || 調試右, dt, 秒);
                }
            }
        }
        # 世界持續運作（背包畫面打開時也一樣）。 The world keeps running, even with a screen open.
        如果 (遊戲進行) {
            變數 fb = 0.0d; 變數 lr = 0.0d; 變數 跳 = 假; 變數 衝 = 假;
            如果 (狀態 == "play") {
                fb = 調試輸入[0]; lr = 調試輸入[1];
                如果 (窗.KeyDown(87)) { fb += 1.0d; } 如果 (窗.KeyDown(83)) { fb -= 1.0d; }
                如果 (窗.KeyDown(68)) { lr += 1.0d; } 如果 (窗.KeyDown(65)) { lr -= 1.0d; }
                跳 = 窗.KeyDown(32) || 調試輸入[3] == 1;
                衝 = 窗.KeyDown(340) || 窗.KeyDown(344) || 調試輸入[4] == 1;
            }
            如果 (狀態 != "dead") {
                變數 步數 = 1;
                如果 (dt > 0.02d) { 步數 = 2; } 如果 (dt > 0.04d) { 步數 = 4; }
                迴圈 (變數 k = 0; k < 步數; k++) { 玩家.更新(dt / 步數, fb, lr, 跳, 衝); }
                迴圈 (變數 k = 0; k < 長度(玩家.事件); k++) {
                    變數 e = (玩家.事件)[k];
                    如果 (e == "step") { 變數 下 = 玩家.腳下方塊(); 如果 (下 > 0) { 聲.方塊聲((方塊.音材)[下], "step"); } }
                    如果 (e == "splash") { 聲.播放("splash", 0.7d, 1.0d); }
                    如果 (e == "land") { 聲.播放("land", 0.6d, 1.0d); }
                }
                # 摔落傷害：v² = 2gh，g = 28。 Fall damage from the landing speed.
                變數 v = 玩家.取落地速度();
                如果 (v < 0) {
                    變數 高 = v * v / 56.0d;
                    變數 傷 = 雜訊.取整(高 - 3.5d);
                    如果 (傷 > 0) { 受傷(傷, 秒); }
                }
                # 溺水與氧氣。 Drowning.
                如果 (玩家.眼在水中) {
                    氧氣 -= dt * 0.8d;
                    如果 (氧氣 <= 0) {
                        氧氣 = 0.0d;
                        溺水計時 -= dt;
                        如果 (溺水計時 <= 0) { 溺水計時 = 1.0d; 受傷(2, 秒); }
                    }
                } 否則 { 氧氣 += dt * 4.0d; 如果 (氧氣 > 10) { 氧氣 = 10.0d; } 溺水計時 = 0.0d; }
                # 自然回復。 Natural regeneration.
                如果 (生命 > 0 && 生命 < 20 && 秒 - 上次受傷 > 4.0d) {
                    回血計時 += dt;
                    如果 (回血計時 > 2.5d) { 回血計時 = 0.0d; 生命 += 1; 介面髒 = 真; }
                }
            }
            # 怪物。 Creatures.
            怪物.更新(dt, 最後夜, 最後白天, 玩家.位置, !設定["mobs"]);
            迴圈 (變數 k = 0; k < 長度(怪物.事件); k++) {
                變數 e = (怪物.事件)[k];
                如果 (e[0] == "hit" && 無敵 <= 0 && 狀態 != "dead") {
                    無敵 = 0.6d;
                    玩家.擊退(e[2], e[3], 6.0d);
                    受傷(e[1], 秒);
                }
                如果 (e[0] == "die") {
                    聲.播放("growl", 0.7d, 1.4d);
                    掉落.碎屑(雜訊.取整(e[1]), 雜訊.取整(e[2]) + 1, 雜訊.取整(e[3]), 30, 12, 0.8d);
                    變數 n = 1;
                    如果 (e[1] - 雜訊.取整(e[1]) > 0.5d) { n = 2; }
                    掉落.丟出(e[1], e[2] + 0.5d, e[3], 物品.煤炭, n, 0, 0.0d, 3.0d, 0.0d, 0.4d);
                }
            }
            無敵 -= dt;
            # 掉落物與粒子。 Dropped items and particles.
            變數 撿 = 掉落.更新(dt, 玩家.位置, 狀態 != "dead");
            如果 (撿 > 0) { 聲.播放("pop", 0.5d, 1.0d); }
            # 熔爐。 Furnaces.
            如果 (容器.更新(dt)) { 重建髒區塊(); }
            時刻 = 時刻 + dt / 日長;
            如果 (時刻 >= 1.0d) { 時刻 -= 1.0d; }
            自動存檔 += dt;
            如果 (自動存檔 > 30.0d && (世界.已修改 || 背包.版本 != 已存版本) && 狀態 != "dead") { 儲存(); 自動存檔 = 0.0d; }
        }
        如果 (訊息時 > 0) { 訊息時 -= dt * 0.7d; }
        如果 (名稱顯示 > 0) { 名稱顯示 -= dt; }
        如果 (受傷閃 > 0) { 受傷閃 -= dt * 2.5d; }
        如果 (狀態 != "play") { 外框目標 = [假, 0, 0, 0, 0.0d]; }
        # 相機。 Camera.
        變數 eye = 玩家.眼睛();
        變數 偏 = 玩家.偏航;
        如果 (狀態 == "title" || 狀態 == "loading") { 偏 = 偏 + 數學.Sin(標題時間 * 0.05d) * 0.12d; }
        變數 cp = 數學.Cos(玩家.俯仰);
        變數 前 = [數學.Sin(偏) * cp, 數學.Sin(玩家.俯仰), 數學.Cos(偏) * cp];
        # 介面只在內容改變時重建；背包畫面每影格重建（滑鼠、拖曳）。 Rebuild the HUD only when something changed.
        變數 簽 = [背包.版本, 生命, 雜訊.取整(氧氣 * 2.0d), 選取, 雜訊.取整(挖掘進度 * 24.0d), 雜訊.取整(揮動 * 12.0d),
            雜訊.取整(名稱顯示 * 12.0d), 雜訊.取整(訊息時 * 12.0d), 雜訊.取整(受傷閃 * 12.0d), 狀態, 玩家.眼在水中, 語言.版本];
        變數 簽變 = 長度(上次簽) != 長度(簽);
        如果 (!簽變) { 迴圈 (變數 k = 0; k < 長度(簽); k++) { 如果 (簽[k] != 上次簽[k]) { 簽變 = 真; } } }
        如果 (介面髒 || 簽變 || 狀態 == "inventory") { 建立介面(); 介面髒 = 假; 上次簽 = 簽; }
        如果 (狀態 == "loading") {
            繪.只畫介面([0.05d, 0.08d, 0.12d, 1]);
        } 否則 {
            變數 f = 影格資料(eye, 前, 窗.PixelWidth * 1.0d / 窗.PixelHeight, 秒, 玩家.眼在水中);
            最後白天 = f["day"]; 最後夜 = f["night"];
            f["lights"] = 世界.附近光源(eye[0], eye[1], eye[2], 56.0d, 32);
            變數 實 = 陣列.建立(0, 0, 4096);
            掉落.繪製資料(實, 秒);
            怪物.繪製資料(實);
            f["ents"] = 實;
            變數 繪設 = {"bloom": 0.0d};
            如果 (設定["effects"] == 1) { 繪設["bloom"] = 0.055d; }
            繪.繪製(f, 可繪區塊(), 外框目標, 繪設);
            聲.環境(dt, f["day"], eye[1], 玩家.眼在水中, 狀態 != "play");
        }
    }
}
儲存();
窗.Dispose();
