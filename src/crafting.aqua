## 合成（Crafting）：可重複使用的配方系統，支援有形（shaped，可左右鏡像）與無形（shapeless）配方。
合成格可為 2x2（背包）或 3x3（工作台）。輸出只是預覽；取走輸出時才消耗材料。
A reusable recipe system with shaped recipes (mirrorable) and shapeless recipes, for the 2x2 inventory
grid and the 3x3 crafting table. The output is only a preview; ingredients are consumed on collection.
配方格式 Recipe layout: [種類 0 有形 / 1 無形, 寬, 高, 材料, 產物, 數量]
  有形 shaped: 材料 is 寬x高 item ids row by row (0 = empty).
  無形 shapeless: 材料 is a list of item ids in any position.
##
變數 物 = 0;
變數 方 = 0;
變數 配方 = [];

變數 有形 = 函式(寬, 高, 材料, 產物, 數量) { 陣列.追加(配方, [0, 寬, 高, 材料, 產物, 數量]); };
變數 無形 = 函式(材料, 產物, 數量) { 陣列.追加(配方, [1, 長度(材料), 1, 材料, 產物, 數量]); };

變數 初始化 = 函式(物品模組, 方塊模組) {
    物 = 物品模組; 方 = 方塊模組;
    配方 = [];
    變數 P = 方.木板; 變數 S = 物.木棒; 變數 C = 方.圓石; 變數 I = 物.鐵錠;
    無形([方.原木], 方.木板, 4);
    有形(1, 2, [P, P], S, 4);
    有形(2, 2, [P, P, P, P], 方.工作台, 1);
    有形(1, 2, [物.煤炭, S], 方.火把, 4);
    有形(3, 3, [C, C, C, C, 0, C, C, C, C], 方.熔爐, 1);
    有形(3, 3, [P, P, P, P, 0, P, P, P, P], 方.箱子, 1);
    變數 材料們 = [P, C, I];
    迴圈 (變數 t = 0; t < 3; t++) {
        變數 M = 材料們[t];
        有形(3, 3, [M, M, M, 0, S, 0, 0, S, 0], 物.木鎬 + t, 1);
        有形(2, 3, [M, M, M, S, 0, S], 物.木斧 + t, 1);
        有形(1, 3, [M, S, S], 物.木鏟 + t, 1);
        有形(1, 3, [M, M, S], 物.木劍 + t, 1);
    }
};

變數 數量 = 函式() { 回傳 長度(配方); };
變數 取得 = 函式(i) { 回傳 配方[i]; };

# 比對合成格；回傳配方索引或 -1。網格為 n*n 個格位。 Match an n*n grid; returns a recipe index or -1.
變數 比對 = 函式(網格, n) {
    變數 x0 = n; 變數 y0 = n; 變數 x1 = -1; 變數 y1 = -1;
    變數 非空 = 0;
    迴圈 (變數 y = 0; y < n; y++) {
        迴圈 (變數 x = 0; x < n; x++) {
            如果 ((網格[y * n + x])[0] != 0) {
                非空++;
                如果 (x < x0) { x0 = x; } 如果 (x > x1) { x1 = x; }
                如果 (y < y0) { y0 = y; } 如果 (y > y1) { y1 = y; }
            }
        }
    }
    如果 (非空 == 0) { 回傳 -1; }
    變數 w = x1 - x0 + 1; 變數 h = y1 - y0 + 1;
    迴圈 (變數 r = 0; r < 長度(配方); r++) {
        變數 R = 配方[r];
        如果 (R[0] == 0) {
            如果 (R[1] == w && R[2] == h) {
                變數 材 = R[3];
                變數 正 = 真; 變數 鏡 = 真;
                迴圈 (變數 y = 0; y < h; y++) {
                    迴圈 (變數 x = 0; x < w; x++) {
                        變數 g = (網格[(y + y0) * n + x + x0])[0];
                        如果 (g != 材[y * w + x]) { 正 = 假; }
                        如果 (g != 材[y * w + (w - 1 - x)]) { 鏡 = 假; }
                    }
                }
                如果 (正 || 鏡) { 回傳 r; }
            }
        } 否則 {
            變數 材 = R[3];
            如果 (長度(材) == 非空) {
                變數 剩 = 陣列.克隆(材);
                變數 符合 = 真;
                迴圈 (變數 i = 0; i < n * n; i++) {
                    變數 g = (網格[i])[0];
                    如果 (g != 0) {
                        變數 k = 陣列.尋找(剩, g);
                        如果 (k < 0) { 符合 = 假; } 否則 { 陣列.刪除(剩, k, k + 1); }
                    }
                }
                如果 (符合) { 回傳 r; }
            }
        }
    }
    回傳 -1;
};

# 取走輸出時：每個用到的格位各減一。 On collection, every used grid slot loses one item.
變數 消耗 = 函式(網格, n, 背包) {
    迴圈 (變數 i = 0; i < n * n; i++) {
        變數 s = 網格[i];
        如果 (s[0] != 0) { 背包.減少(s, 1); }
    }
};

# 配方需要的材料總數 {編號: 數量}。 Ingredient totals for a recipe.
變數 需求 = 函式(R) {
    變數 表 = {};
    變數 材 = R[3];
    迴圈 (變數 i = 0; i < 長度(材); i++) {
        變數 id = 材[i];
        如果 (id != 0) {
            如果 (雜湊.包含鍵(表, id)) { 表[id] = 表[id] + 1; } 否則 { 表[id] = 1; }
        }
    }
    回傳 表;
};

# 是否放得進 n*n 合成格。 Does the recipe fit an n*n grid?
變數 適合 = 函式(R, n) {
    如果 (R[0] == 0) { 回傳 R[1] <= n && R[2] <= n; }
    回傳 長度(R[3]) <= n * n;
};

# 背包加上合成格裡的材料是否足夠。 Enough ingredients in the inventory plus the grid?
變數 可製作 = 函式(R, n, 背包, 網格) {
    如果 (!適合(R, n)) { 回傳 假; }
    變數 表 = 需求(R);
    變數 鍵們 = 雜湊.鍵列表(表);
    迴圈 (變數 i = 0; i < 長度(鍵們); i++) {
        變數 id = 鍵們[i];
        如果 (背包.計數(id) + 背包.計數陣列(網格, id) < 表[id]) { 回傳 假; }
    }
    回傳 真;
};

# 合成格內容退回背包；放不下的回傳給呼叫者丟出。 Return grid items to the inventory; leftovers are returned.
變數 退回 = 函式(網格, 背包) {
    變數 溢出 = [];
    迴圈 (變數 i = 0; i < 長度(網格); i++) {
        變數 s = 網格[i];
        如果 (s[0] != 0) {
            變數 剩 = 背包.加入(s[0], s[1], s[2]);
            如果 (剩 > 0) { 陣列.追加(溢出, [s[0], 剩, s[2]]); }
            背包.清空(s);
        }
    }
    背包.變更();
    回傳 溢出;
};

# 依配方把材料從背包排進合成格（配方指南點擊）。 Lay a recipe out from the inventory (recipe guide).
變數 自動填入 = 函式(R, 網格, n, 背包) {
    變數 溢出 = 退回(網格, 背包);
    如果 (R[0] == 0) {
        變數 w = R[1]; 變數 h = R[2];
        迴圈 (變數 y = 0; y < h; y++) {
            迴圈 (變數 x = 0; x < w; x++) {
                變數 id = (R[3])[y * w + x];
                如果 (id != 0) {
                    如果 (背包.取走(id, 1) == 1) { 背包.設定(網格[y * n + x], id, 1, 0); }
                }
            }
        }
    } 否則 {
        變數 材 = R[3];
        迴圈 (變數 i = 0; i < 長度(材); i++) {
            如果 (背包.取走(材[i], 1) == 1) { 背包.設定(網格[i], 材[i], 1, 0); }
        }
    }
    背包.變更();
    回傳 溢出;
};
