## 背包介面（Inventory screens）：快捷列 HUD、背包（2x2 合成）、工作台（3x3）、箱子、熔爐與配方指南。
繪製時記錄每個格位的點擊區域，主程式用「命中」查出滑鼠下的格位。
HUD hotbar, the inventory (2x2 crafting), crafting table (3x3), chest, furnace and the recipe guide.
Every slot drawn registers a hit region; the main loop asks 命中 which slot is under the mouse.
##
變數 介 = 0;
變數 物 = 0;
變數 背 = 0;
變數 合 = 0;
變數 方 = 0;
變數 區域 = [];
變數 懸停堆 = [0, 0, 0];
變數 懸停配方 = -1;

變數 初始化 = 函式(介面模組, 物品模組, 背包模組, 合成模組, 方塊模組) {
    介 = 介面模組; 物 = 物品模組; 背 = 背包模組; 合 = 合成模組; 方 = 方塊模組;
};

變數 加區 = 函式(名, i, x, y, w, h) { 陣列.追加(區域, [名, i, x, y, w, h]); };

變數 命中 = 函式(mx, my) {
    迴圈 (變數 k = 長度(區域) - 1; k >= 0; k -= 1) {
        變數 r = 區域[k];
        如果 (mx >= r[2] && mx < r[2] + r[4] && my >= r[3] && my < r[3] + r[5]) { 回傳 [r[0], r[1]]; }
    }
    回傳 ["", -1];
};

# 面板是否包含滑鼠（點到面板外代表丟出物品）。 Is the mouse over any panel?
變數 面板們 = [];
變數 在面板內 = 函式(mx, my) {
    迴圈 (變數 k = 0; k < 長度(面板們); k++) {
        變數 r = 面板們[k];
        如果 (mx >= r[0] && mx < r[0] + r[2] && my >= r[1] && my < r[1] + r[3]) { 回傳 真; }
    }
    回傳 假;
};

變數 畫面板 = 函式(x, y, w, h) {
    變數 s = 介.縮放;
    陣列.追加(面板們, [x, y, w, h]);
    介.矩形(x, y, w, h, 0.11d, 0.13d, 0.17d, 0.96d);
    介.矩形(x, y, w, s, 0.36d, 0.42d, 0.5d, 1.0d);
    介.矩形(x, y, s, h, 0.36d, 0.42d, 0.5d, 1.0d);
    介.矩形(x, y + h - s, w, s, 0.03d, 0.04d, 0.06d, 1.0d);
    介.矩形(x + w - s, y, s, h, 0.03d, 0.04d, 0.06d, 1.0d);
};

# 一個格位：凹陷底框、物品、懸停高亮與點擊區域。 One slot: inset frame, stack, hover highlight, hit region.
變數 槽 = 函式(名, i, x, y, S, 堆, mx, my, 亮) {
    變數 s = 介.縮放;
    介.矩形(x, y, S, S, 0.05d, 0.06d, 0.08d, 0.95d);
    介.矩形(x + s, y + s, S - s, S - s, 0.24d, 0.27d, 0.32d, 0.95d);
    介.矩形(x + s, y + s, S - 2 * s, S - 2 * s, 0.16d, 0.18d, 0.22d, 0.95d);
    介.堆疊(x + s, y + s, S - 2 * s, 堆, 亮);
    加區(名, i, x, y, S, S);
    變數 懸 = mx >= x && mx < x + S && my >= y && my < y + S;
    如果 (懸) {
        介.矩形(x + s, y + s, S - 2 * s, S - 2 * s, 1.0d, 1.0d, 1.0d, 0.22d);
        如果 (堆[0] != 0) { 懸停堆 = 堆; }
    }
    回傳 懸;
};

# ---------- 遊戲中 HUD ----------
變數 快捷列 = 函式(W, H, 選取, 生命, 氧氣, 顯示氧氣, 名稱透明) {
    變數 s = 介.縮放;
    變數 格 = 20 * s;
    變數 總寬 = 格 * 9 + 2 * s;
    變數 x0 = (W - 總寬) / 2;
    變數 y0 = H - 格 - 6 * s;
    介.矩形(x0, y0, 總寬, 格 + 2 * s, 0.03d, 0.04d, 0.06d, 0.6d);
    迴圈 (變數 i = 0; i < 9; i++) {
        變數 x = x0 + s + i * 格;
        如果 (i == 選取) {
            介.矩形(x, y0 + s, 格, 格, 0.95d, 0.97d, 1.0d, 0.2d);
            介.外框(x - s, y0, 格 + 2 * s, 格 + 2 * s, s, 0.97d, 0.98d, 1.0d, 0.95d);
        }
        介.堆疊(x + 2 * s, y0 + 3 * s, 格 - 4 * s, (背.格)[i], 1.0d);
        介.字(x + 2 * s, y0 + 2 * s, 1, 字串.轉文字(i + 1), 0.85d, 0.9d, 0.95d, 0.45d);
    }
    # 生命與氧氣。 Health hearts and air bubbles.
    變數 p = s;
    變數 hy = y0 - 9 * p;
    迴圈 (變數 i = 0; i < 10; i++) {
        變數 填 = (生命 - i * 2) / 2.0d;
        介.愛心(x0 + i * 8 * p, hy, p, 填);
    }
    如果 (顯示氧氣) {
        迴圈 (變數 i = 0; i < 10; i++) {
            介.泡泡(x0 + 總寬 - (i + 1) * 7 * p, hy, p, 氧氣 > i);
        }
    }
    變數 sel = (背.格)[選取];
    如果 (sel[0] != 0 && 名稱透明 > 0) {
        變數 a = 名稱透明; 如果 (a > 1) { a = 1.0d; }
        介.置中文字(W / 2, hy - 13 * s, s, 物.名稱(sel[0]), 0.95d, 0.97d, 1.0d, a);
    }
};

# 挖掘進度：準星下方的細條。 Mining progress bar under the crosshair.
變數 挖掘指示 = 函式(W, H, 進度) {
    如果 (進度 <= 0) { 回傳 0; }
    變數 s = 介.縮放;
    變數 bw = 24 * s; 變數 x = W / 2 - bw / 2; 變數 y = H / 2 + 10 * s;
    介.矩形(x - s, y - s, bw + 2 * s, 3 * s + 2 * s, 0.0d, 0.0d, 0.0d, 0.5d);
    介.矩形(x, y, bw * 進度, 3 * s, 0.95d, 0.85d, 0.45d, 0.95d);
    回傳 0;
};

# 手上的物品（右下角），挖掘或放置時擺動。 Held item in the corner, swinging while used.
變數 手持物品 = 函式(W, H, 堆, 擺動) {
    如果 (堆[0] == 0) { 回傳 0; }
    變數 s = 介.縮放;
    變數 size = 46 * s;
    變數 sw = 擺動;
    如果 (sw > 1) { sw = 1.0d; }
    變數 擺 = sw * (1.0d - sw) * 4.0d;
    變數 cx = W - 44 * s - 擺 * 26 * s;
    變數 cy = H - 30 * s - 擺 * 14 * s;
    介.物品圖示(cx, cy, size, 堆[0], 0.92d);
    回傳 0;
};

# ---------- 背包、工作台、箱子、熔爐 ----------
變數 標題 = 函式(x, y, 文) { 介.文字(x, y, 介.縮放, 文, 0.86d, 0.9d, 0.96d, 1.0d); };

# 箭頭（進度 0..1）。 Progress arrow.
變數 箭頭 = 函式(x, y, 進度) {
    變數 s = 介.縮放;
    介.矩形(x, y + 3 * s, 16 * s, 4 * s, 0.32d, 0.35d, 0.4d, 1.0d);
    介.矩形(x + 14 * s, y, 3 * s, 10 * s, 0.32d, 0.35d, 0.4d, 1.0d);
    介.矩形(x + 17 * s, y + 2 * s, 2 * s, 6 * s, 0.32d, 0.35d, 0.4d, 1.0d);
    如果 (進度 > 0) {
        介.矩形(x, y + 3 * s, 16 * s * 進度, 4 * s, 0.95d, 0.95d, 0.98d, 1.0d);
    }
};

# 火焰（燃燒比例）。 Flame gauge.
變數 火焰 = 函式(x, y, 比例) {
    變數 s = 介.縮放;
    介.矩形(x, y, 12 * s, 12 * s, 0.2d, 0.22d, 0.26d, 1.0d);
    如果 (比例 > 0) {
        變數 h = 12 * s * 比例;
        介.矩形(x + 2 * s, y + 12 * s - h, 8 * s, h, 1.0d, 0.55d, 0.15d, 1.0d);
        介.矩形(x + 4 * s, y + 12 * s - h * 0.6d, 4 * s, h * 0.6d, 1.0d, 0.85d, 0.35d, 1.0d);
    }
};

# 玩家背包區（背包三列加快捷列）。 Player inventory block: three backpack rows plus the hotbar.
變數 玩家格 = 函式(x0, y0, mx, my) {
    變數 s = 介.縮放;
    變數 S = 18 * s;
    迴圈 (變數 r = 0; r < 3; r++) {
        迴圈 (變數 c = 0; c < 9; c++) {
            變數 i = 9 + r * 9 + c;
            槽("main", i, x0 + 8 * s + c * S, y0 + 84 * s + r * S, S, (背.格)[i], mx, my, 1.0d);
        }
    }
    迴圈 (變數 c = 0; c < 9; c++) {
        槽("main", c, x0 + 8 * s + c * S, y0 + 142 * s, S, (背.格)[c], mx, my, 1.0d);
    }
};

# 合成格與輸出。 Crafting grid and output slot.
變數 合成區 = 函式(gx, gy, n, 網格, 輸出, mx, my) {
    變數 s = 介.縮放;
    變數 S = 18 * s;
    迴圈 (變數 r = 0; r < n; r++) {
        迴圈 (變數 c = 0; c < n; c++) {
            槽("grid", r * n + c, gx + c * S, gy + r * S, S, 網格[r * n + c], mx, my, 1.0d);
        }
    }
    變數 ax = gx + n * S + 6 * s;
    變數 ay = gy + (n * S) / 2 - 5 * s;
    變數 有 = 0.0d; 如果 ((輸出[0])[0] != 0) { 有 = 1.0d; }
    箭頭(ax, ay, 有);
    變數 ox = ax + 24 * s; 變數 oy = gy + (n * S) / 2 - 13 * s;
    介.矩形(ox - s, oy - s, 26 * s + 2 * s, 26 * s + 2 * s, 0.4d, 0.44d, 0.5d, 0.9d);
    槽("out", 0, ox, oy, 26 * s, 輸出[0], mx, my, 1.0d);
};

# 配方指南。 Recipe guide: every recipe, available ones bright; hover for ingredients, click to lay out.
變數 配方指南 = 函式(x, y, w, h, n, 網格, mx, my) {
    變數 s = 介.縮放;
    畫面板(x, y, w, h);
    標題(x + 7 * s, y + 6 * s, "Recipes");
    變數 S = 18 * s;
    變數 每列 = (w - 10 * s) / (S + 2 * s);
    懸停配方 = -1;
    迴圈 (變數 r = 0; r < 合.數量(); r++) {
        變數 R = 合.取得(r);
        變數 cx = x + 6 * s + (r % 每列) * (S + 2 * s);
        變數 cy = y + 18 * s + (r / 每列) * (S + 2 * s);
        變數 可 = 合.可製作(R, n, 背, 網格);
        變數 適 = 合.適合(R, n);
        如果 (可) { 介.矩形(cx, cy, S, S, 0.2d, 0.42d, 0.28d, 0.95d); }
        否則如果 (適) { 介.矩形(cx, cy, S, S, 0.18d, 0.2d, 0.24d, 0.95d); }
        否則 { 介.矩形(cx, cy, S, S, 0.1d, 0.1d, 0.12d, 0.95d); }
        變數 亮 = 0.4d; 如果 (可) { 亮 = 1.0d; } 否則如果 (適) { 亮 = 0.62d; }
        介.物品圖示(cx + S / 2, cy + S / 2, S * 0.75d, R[4], 亮);
        加區("recipe", r, cx, cy, S, S);
        如果 (mx >= cx && mx < cx + S && my >= cy && my < cy + S) {
            懸停配方 = r;
            介.外框(cx, cy, S, S, s, 1.0d, 1.0d, 1.0d, 0.9d);
        }
    }
    # 細節：懸停的配方。 Details of the hovered recipe.
    變數 dy = y + 18 * s + ((合.數量() + 每列 - 1) / 每列) * (S + 2 * s) + 6 * s;
    如果 (懸停配方 >= 0) {
        變數 R = 合.取得(懸停配方);
        介.文字(x + 7 * s, dy, s, 介.譯(物.名稱(R[4])) + " x" + 字串.轉文字(R[5]), 1.0d, 1.0d, 1.0d, 1.0d);
        變數 c = 12 * s;
        變數 px = x + 7 * s; 變數 py = dy + (介.行距() + 2) * s;
        迴圈 (變數 yy = 0; yy < 3; yy++) {
            迴圈 (變數 xx = 0; xx < 3; xx++) {
                介.矩形(px + xx * (c + s), py + yy * (c + s), c, c, 0.16d, 0.18d, 0.22d, 0.95d);
            }
        }
        如果 (R[0] == 0) {
            迴圈 (變數 yy = 0; yy < R[2]; yy++) {
                迴圈 (變數 xx = 0; xx < R[1]; xx++) {
                    變數 id = (R[3])[yy * R[1] + xx];
                    如果 (id != 0) { 介.物品圖示(px + xx * (c + s) + c / 2, py + yy * (c + s) + c / 2, c * 0.85d, id, 1.0d); }
                }
            }
        } 否則 {
            變數 材 = R[3];
            迴圈 (變數 k = 0; k < 長度(材); k++) {
                介.物品圖示(px + (k % 3) * (c + s) + c / 2, py + (k / 3) * (c + s) + c / 2, c * 0.85d, 材[k], 1.0d);
            }
        }
        變數 狀 = "";
        如果 (!合.適合(R, n)) { 狀 = "Needs a crafting table"; }
        否則如果 (合.可製作(R, n, 背, 網格)) { 狀 = "Click to fill the grid"; }
        否則 { 狀 = "Missing ingredients"; }
        如果 (R[0] == 1) { 介.文字(px + 3 * (c + s) + 4 * s, py + 2 * s, s, "Shapeless", 0.7d, 0.8d, 0.9d, 1.0d); }
        介.文字(px, py + 3 * (c + s) + 4 * s, s, 狀, 0.75d, 0.85d, 0.95d, 1.0d);
    } 否則 {
        介.文字(x + 7 * s, dy, s, "Hover a recipe", 0.6d, 0.7d, 0.8d, 1.0d);
        介.文字(x + 7 * s, dy + (介.行距() + 1) * s, s, "Green: craftable", 0.45d, 0.8d, 0.55d, 1.0d);
    }
};

# 主畫面。模式："inv"、"table"、"chest"、"furnace"。 Draw a container screen.
變數 畫面 = 函式(W, H, 模式, 資料, mx, my) {
    區域 = []; 面板們 = [];
    懸停堆 = [0, 0, 0];
    懸停配方 = -1;
    變數 s = 介.縮放;
    變數 S = 18 * s;
    介.矩形(0, 0, W, H, 0.0d, 0.01d, 0.03d, 0.45d);
    變數 主寬 = 176 * s; 變數 主高 = 166 * s;
    變數 有指南 = (模式 == "inv" || 模式 == "table") && W >= (176 + 150) * s;
    變數 指寬 = 0;
    如果 (有指南) { 指寬 = 144 * s; }
    變數 x0 = (W - 主寬 - 指寬) / 2;
    變數 y0 = (H - 主高) / 2;
    畫面板(x0, y0, 主寬, 主高);
    如果 (模式 == "inv") {
        標題(x0 + 8 * s, y0 + 6 * s, "Crafting");
        合成區(x0 + 52 * s, y0 + 22 * s, 2, 資料["grid"], 資料["out"], mx, my);
        標題(x0 + 8 * s, y0 + 73 * s, "Inventory");
    } 否則如果 (模式 == "table") {
        標題(x0 + 8 * s, y0 + 6 * s, "Crafting Table");
        合成區(x0 + 30 * s, y0 + 17 * s, 3, 資料["grid"], 資料["out"], mx, my);
        標題(x0 + 8 * s, y0 + 73 * s, "Inventory");
    } 否則如果 (模式 == "chest") {
        標題(x0 + 8 * s, y0 + 6 * s, "Chest");
        變數 箱 = 資料["chest"];
        迴圈 (變數 r = 0; r < 3; r++) {
            迴圈 (變數 c = 0; c < 9; c++) {
                槽("chest", r * 9 + c, x0 + 8 * s + c * S, y0 + 18 * s + r * S, S, 箱[r * 9 + c], mx, my, 1.0d);
            }
        }
        標題(x0 + 8 * s, y0 + 73 * s, "Inventory");
    } 否則如果 (模式 == "furnace") {
        標題(x0 + 8 * s, y0 + 6 * s, "Furnace");
        變數 f = 資料["furnace"];
        變數 g = f["格"];
        槽("furnace", 0, x0 + 52 * s, y0 + 17 * s, S, g[0], mx, my, 1.0d);
        變數 比例 = 0.0d;
        如果 (f["燒滿"] > 0) { 比例 = f["燒"] / f["燒滿"]; }
        火焰(x0 + 55 * s, y0 + 37 * s, 比例);
        槽("furnace", 1, x0 + 52 * s, y0 + 53 * s, S, g[1], mx, my, 1.0d);
        箭頭(x0 + 80 * s, y0 + 36 * s, f["煉"] / 8.0d);
        介.矩形(x0 + 111 * s, y0 + 30 * s, 26 * s, 26 * s, 0.4d, 0.44d, 0.5d, 0.9d);
        槽("furnace", 2, x0 + 112 * s, y0 + 31 * s, 24 * s, g[2], mx, my, 1.0d);
        介.文字(x0 + 8 * s, y0 + 60 * s, s, "Fuel", 0.6d, 0.7d, 0.8d, 1.0d);
        標題(x0 + 8 * s, y0 + 73 * s, "Inventory");
    }
    玩家格(x0, y0, mx, my);
    如果 (有指南) {
        變數 n = 2; 如果 (模式 == "table") { n = 3; }
        配方指南(x0 + 主寬 + 6 * s, y0, 指寬 - 6 * s, 主高, n, 資料["grid"], mx, my);
    }
    # 游標上的物品。 The stack on the cursor.
    變數 h = 背.手持;
    如果 (h[0] != 0) {
        介.堆疊(mx - 8 * s, my - 8 * s, 16 * s, h, 1.0d);
    } 否則如果 (懸停堆[0] != 0) {
        # 提示框。 Tooltip.
        變數 名 = 物.名稱(懸停堆[0]);
        變數 述 = 物.說明(懸停堆[0], 懸停堆[2]);
        變數 tw = 介.文字寬(名, s);
        變數 dw = 介.文字寬(述, s);
        如果 (dw > tw) { tw = dw; }
        變數 tx = mx + 12 * s; 變數 ty = my - 6 * s;
        如果 (tx + tw + 8 * s > W) { tx = mx - tw - 16 * s; }
        # 中文字較高：上下留白與行距加大。 Chinese glyphs are taller: more padding and line pitch.
        變數 上 = 4 * s; 如果 (介.行距() > 10) { 上 = 6 * s; }
        變數 行 = 介.行距() * s;
        變數 th = 上 * 2 + 行 + 7 * s;
        介.矩形(tx, ty, tw + 8 * s, th, 0.05d, 0.02d, 0.1d, 0.94d);
        介.外框(tx, ty, tw + 8 * s, th, s, 0.35d, 0.2d, 0.6d, 0.95d);
        介.文字(tx + 4 * s, ty + 上, s, 名, 1.0d, 1.0d, 1.0d, 1.0d);
        介.文字(tx + 4 * s, ty + 上 + 行, s, 述, 0.65d, 0.7d, 0.8d, 1.0d);
    }
};
