## 介面（UI）：原創像素字型、快捷列、十字準星、選單與設定。全部以像素座標組成頂點緩衝區。
UI built from an original pixel font, a hotbar, crosshair, menus and settings, as pixel-space vertices.
頂點格式：位置(x,y,0)、法線(模式,0,0)、UV、RGBA。模式 0 純色、1 字型、2 方塊圖集、3 物品圖集。
##
變數 方 = 0;
變數 物 = 0;
變數 語 = 0;
變數 字型 = 0;
變數 v = [];
變數 按鈕們 = [];
變數 縮放 = 2;

變數 初始化 = 函式(方塊模組, 物品模組, 語言模組, 字型模組) { 方 = 方塊模組; 物 = 物品模組; 語 = 語言模組; 字型 = 字型模組; };

# 依視窗高度與寬度決定像素縮放，窄視窗也放得下背包畫面。 Pixel scale from height and width.
變數 開始 = 函式(像素寬, 像素高) {
    v = 陣列.建立(0, 0, 60000);
    按鈕們 = [];
    縮放 = 像素高 / 340;
    變數 依寬 = 像素寬 / 330;
    如果 (依寬 < 縮放) { 縮放 = 依寬; }
    如果 (縮放 < 1) { 縮放 = 1; }
    回傳 縮放;
};

變數 頂點 = 函式(x, y, 模式, u, w, r, g, b, a) {
    陣列.追加(v, x); 陣列.追加(v, y); 陣列.追加(v, 0);
    陣列.追加(v, 模式); 陣列.追加(v, 0); 陣列.追加(v, 0);
    陣列.追加(v, u); 陣列.追加(v, w);
    陣列.追加(v, r); 陣列.追加(v, g); 陣列.追加(v, b); 陣列.追加(v, a);
};

變數 四邊 = 函式(x0, y0, x1, y1, x2, y2, x3, y3, 模式, u0, v0, u1, v1, r, g, b, a) {
    頂點(x0, y0, 模式, u0, v0, r, g, b, a); 頂點(x1, y1, 模式, u1, v0, r, g, b, a); 頂點(x2, y2, 模式, u1, v1, r, g, b, a);
    頂點(x0, y0, 模式, u0, v0, r, g, b, a); 頂點(x2, y2, 模式, u1, v1, r, g, b, a); 頂點(x3, y3, 模式, u0, v1, r, g, b, a);
};

變數 矩形 = 函式(x, y, w, h, r, g, b, a) {
    四邊(x, y, x + w, y, x + w, y + h, x, y + h, 0, 0, 0, 0, 0, r, g, b, a);
};

變數 外框 = 函式(x, y, w, h, t, r, g, b, a) {
    矩形(x, y, w, t, r, g, b, a); 矩形(x, y + h - t, w, t, r, g, b, a);
    矩形(x, y + t, t, h - 2 * t, r, g, b, a); 矩形(x + w - t, y + t, t, h - 2 * t, r, g, b, a);
};

# 介面文字一律先查翻譯表；拉丁字元寬 6 格，中文字寬 12 格（11x11 字形加 1 格間距）。
# Every UI string is translated first. Latin glyphs advance 6 px, Chinese glyphs 12 px (11x11 + gap).
變數 譯 = 函式(文) { 回傳 語.譯(文); };
變數 是中文字 = 函式(c) { 回傳 c > 127 && 雜湊.包含鍵(字型.表, 字串.轉文字(c)); };

# 一行文字的行距（像素格數）：中文字比拉丁字高，行距放寬。 Line pitch in font pixels.
變數 行距 = 函式() { 如果 (語.是中文()) { 回傳 13; } 回傳 10; };

變數 原始寬 = 函式(文, s) {
    變數 w = 0;
    迴圈 (變數 i = 0; i < 長度(文); i++) {
        如果 (是中文字(字串.字元碼(文, i))) { w += 12; } 否則 { w += 6; }
    }
    回傳 w * s - s;
};
變數 文字寬 = 函式(文, s) { 回傳 原始寬(譯(文), s); };

變數 原始字 = 函式(x, y, s, 文, r, g, b, a) {
    變數 cx = x;
    變數 寬 = 字型.寬 * 1.0d; 變數 高 = 字型.高 * 1.0d;
    迴圈 (變數 i = 0; i < 長度(文); i++) {
        變數 c = 字串.字元碼(文, i);
        如果 (是中文字(c)) {
            # 11x11 中文字形，垂直置中於拉丁字的 7 列高度上。 Centred on the Latin x-height band.
            變數 k = (字型.表)[字串.轉文字(c)];
            變數 gx = (k % 字型.每列) * 字型.中格; 變數 gy = 字型.中起 + (k / 字型.每列) * 字型.中格;
            四邊(cx, y - 2 * s, cx + 11 * s, y - 2 * s, cx + 11 * s, y + 9 * s, cx, y + 9 * s, 1,
                gx / 寬, gy / 高, (gx + 11) / 寬, (gy + 11) / 高, r, g, b, a);
            cx += 12 * s;
        } 否則 {
            如果 (c < 32 || c > 127) { c = 63; }
            如果 (c != 32) {
                變數 idx = c - 32;
                變數 u0 = (idx % 16) * 8 / 寬; 變數 v0 = (idx / 16) * 10 / 高;
                四邊(cx - s, y - s, cx + 7 * s, y - s, cx + 7 * s, y + 9 * s, cx - s, y + 9 * s, 1, u0, v0, u0 + 8 / 寬, v0 + 10 / 高, r, g, b, a);
            }
            cx += 6 * s;
        }
    }
};
變數 字 = 函式(x, y, s, 文, r, g, b, a) { 原始字(x, y, s, 譯(文), r, g, b, a); };

# 帶陰影的文字。 Text with a drop shadow.
變數 文字 = 函式(x, y, s, 文, r, g, b, a) {
    變數 t = 譯(文);
    原始字(x + s, y + s, s, t, 0.05d, 0.06d, 0.08d, a * 0.6d);
    原始字(x, y, s, t, r, g, b, a);
};

變數 置中文字 = 函式(cx, y, s, 文, r, g, b, a) { 文字(cx - 文字寬(文, s) / 2, y, s, 文, r, g, b, a); };

變數 按鈕 = 函式(id, x, y, w, h, 標籤, 懸停) {
    變數 s = 縮放;
    如果 (懸停 == id) {
        矩形(x, y, w, h, 0.24d, 0.45d, 0.62d, 0.92d);
        外框(x, y, w, h, s, 0.75d, 0.9d, 1.0d, 0.95d);
    } 否則 {
        矩形(x, y, w, h, 0.07d, 0.1d, 0.14d, 0.78d);
        外框(x, y, w, h, s, 0.35d, 0.45d, 0.55d, 0.8d);
    }
    置中文字(x + w / 2, y + (h - 8 * s) / 2, s, 標籤, 0.96d, 0.98d, 1.0d, 1.0d);
    按鈕們 = 加入(按鈕們, [id, x, y, w, h]);
};

變數 點擊 = 函式(mx, my) {
    迴圈 (變數 i = 0; i < 長度(按鈕們); i++) {
        變數 b = 按鈕們[i];
        如果 (mx >= b[1] && mx < b[1] + b[3] && my >= b[2] && my < b[2] + b[4]) { 回傳 b[0]; }
    }
    回傳 "";
};

# 等角方塊圖示：頂面、左、右三個面取自圖集。 Isometric block icon from the atlas.
變數 方塊圖示 = 函式(cx, cy, size, id, 亮) {
    變數 頂 = (方.頂面)[id]; 變數 側 = (方.側面)[id];
    如果 ((方.前向)[id] >= 0) { 側 = (方.前面)[id]; }
    變數 tu = (頂 % 8) * 0.125d; 變數 tv = (頂 / 8) * 0.25d;
    變數 su = (側 % 8) * 0.125d; 變數 sv = (側 / 8) * 0.25d;
    變數 s2 = (方.側面)[id];
    變數 ru = (s2 % 8) * 0.125d; 變數 rv = (s2 / 8) * 0.25d;
    變數 e = 0.5d / 256.0d;
    變數 h = size * 0.5d; 變數 q = size * 0.25d;
    如果 ((方.種類)[id] == 4) {
        四邊(cx - h, cy - h, cx + h, cy - h, cx + h, cy + h, cx - h, cy + h, 2, tu + e, tv + e, tu + 0.125d - e, tv + 0.25d - e, 亮, 亮, 亮, 1);
        回傳 0;
    }
    # 頂面菱形。 Top rhombus.
    四邊(cx, cy - h, cx + h, cy - q, cx, cy, cx - h, cy - q, 2, tu + e, tv + e, tu + 0.125d - e, tv + 0.25d - e, 亮, 亮, 亮, 1);
    # 左面（正面）與右面。 Left (front) and right faces.
    四邊(cx - h, cy - q, cx, cy, cx, cy + h, cx - h, cy + q, 2, su + e, sv + e, su + 0.125d - e, sv + 0.25d - e, 0.78d * 亮, 0.78d * 亮, 0.8d * 亮, 1);
    四邊(cx, cy, cx + h, cy - q, cx + h, cy + q, cx, cy + h, 2, ru + e, rv + e, ru + 0.125d - e, rv + 0.25d - e, 0.6d * 亮, 0.6d * 亮, 0.64d * 亮, 1);
    回傳 0;
};

變數 十字準星 = 函式(w, h) {
    變數 s = 縮放;
    變數 cx = w / 2; 變數 cy = h / 2;
    變數 L = 5 * s; 變數 T = s;
    矩形(cx - L - 1, cy - T / 2 - 1, 2 * L + 2, T + 2, 0, 0, 0, 0.35d);
    矩形(cx - T / 2 - 1, cy - L - 1, T + 2, 2 * L + 2, 0, 0, 0, 0.35d);
    矩形(cx - L, cy - T / 2, 2 * L, T, 1, 1, 1, 0.85d);
    矩形(cx - T / 2, cy - L, T, 2 * L, 1, 1, 1, 0.85d);
};

# 物品圖示：等角方塊、平面方塊圖格或物品圖集。 Item icon: isometric block, flat tile or item atlas.
變數 物品圖示 = 函式(cx, cy, size, id, 亮) {
    如果 (id <= 0) { 回傳 0; }
    變數 圖 = 物.圖示(id);
    變數 h = size * 0.5d;
    如果 (圖[0] == 0) { 方塊圖示(cx, cy, size, id, 亮); 回傳 0; }
    如果 (圖[0] == 1) {
        變數 t = 圖[1];
        變數 tu = (t % 8) * 0.125d; 變數 tv = (t / 8) * 0.25d; 變數 e = 0.5d / 256.0d;
        四邊(cx - h, cy - h, cx + h, cy - h, cx + h, cy + h, cx - h, cy + h, 2, tu + e, tv + e, tu + 0.125d - e, tv + 0.25d - e, 亮, 亮, 亮, 1);
        回傳 0;
    }
    變數 i = 圖[1];
    變數 iu = (i % 8) * 0.125d; 變數 iv = (i / 8) * 0.25d;
    四邊(cx - h, cy - h, cx + h, cy - h, cx + h, cy + h, cx - h, cy + h, 3, iu, iv, iu + 0.125d, iv + 0.25d, 亮, 亮, 亮, 1);
    回傳 0;
};

# 一格的物品：圖示、數量與耐久條。 A stack inside a slot: icon, count and durability bar.
變數 堆疊 = 函式(x, y, 格, s堆, 亮) {
    如果 (s堆[0] == 0 || s堆[1] <= 0) { 回傳 0; }
    變數 s = 縮放;
    物品圖示(x + 格 / 2, y + 格 / 2, 格 * 0.78d, s堆[0], 亮);
    如果 (s堆[1] > 1) {
        變數 文 = 字串.轉文字(s堆[1]);
        變數 ts = s;
        如果 (s >= 4) { ts = s - 1; }
        字(x + 格 - 文字寬(文, ts) - ts + ts, y + 格 - 9 * ts + ts, ts, 文, 0.1d, 0.1d, 0.1d, 0.85d);
        字(x + 格 - 文字寬(文, ts) - ts, y + 格 - 9 * ts, ts, 文, 1.0d, 1.0d, 1.0d, 1.0d);
    }
    如果 (物.是工具(s堆[0]) && s堆[2] > 0) {
        變數 上限 = 物.耐久(s堆[0]);
        變數 比 = (上限 - s堆[2]) * 1.0d / 上限;
        變數 bw = 格 - 4 * s;
        矩形(x + 2 * s, y + 格 - 3 * s, bw, 2 * s, 0.05d, 0.05d, 0.05d, 0.9d);
        矩形(x + 2 * s, y + 格 - 3 * s, bw * 比, s, 1.0d - 比, 0.25d + 0.7d * 比, 0.15d, 1.0d);
    }
    回傳 0;
};

# 小愛心（滿、半、空），以水平線段畫出。 Pixel heart (full, half, empty) drawn as horizontal runs.
變數 心列 = [[0, 1, 2], [0, 4, 2], [1, 0, 7], [2, 0, 7], [3, 1, 5], [4, 2, 3], [5, 3, 1]];
變數 愛心 = 函式(x, y, p, 填) {
    迴圈 (變數 k = 0; k < 長度(心列); k++) {
        變數 L = 心列[k];
        變數 r = L[0]; 變數 c0 = L[1]; 變數 n = L[2];
        如果 (填 >= 1.0d) {
            矩形(x + c0 * p, y + r * p, n * p, p, 0.86d, 0.12d, 0.14d, 1.0d);
        } 否則如果 (填 >= 0.5d) {
            # 左半邊亮。 Left half lit.
            變數 左 = 4 - c0; 如果 (左 > n) { 左 = n; } 如果 (左 < 0) { 左 = 0; }
            如果 (左 > 0) { 矩形(x + c0 * p, y + r * p, 左 * p, p, 0.86d, 0.12d, 0.14d, 1.0d); }
            如果 (n - 左 > 0) { 矩形(x + (c0 + 左) * p, y + r * p, (n - 左) * p, p, 0.18d, 0.06d, 0.07d, 0.85d); }
        } 否則 {
            矩形(x + c0 * p, y + r * p, n * p, p, 0.18d, 0.06d, 0.07d, 0.85d);
        }
    }
};

# 氧氣泡泡。 Air bubble.
變數 泡泡 = 函式(x, y, p, 有) {
    如果 (有) {
        矩形(x + p, y, 3 * p, 5 * p, 0.55d, 0.8d, 1.0d, 0.95d);
        矩形(x, y + p, 5 * p, 3 * p, 0.55d, 0.8d, 1.0d, 0.95d);
        矩形(x + p, y + p, p, p, 0.95d, 1.0d, 1.0d, 1.0d);
    }
};

變數 面板 = 函式(x, y, w, h) {
    矩形(x, y, w, h, 0.03d, 0.05d, 0.08d, 0.72d);
    外框(x, y, w, h, 縮放, 0.3d, 0.4d, 0.5d, 0.7d);
};

變數 結束 = 函式() { 回傳 v; };
