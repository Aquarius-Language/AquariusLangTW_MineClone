## 確定性地形生成（Deterministic terrain generation）
起伏丘陵、山脈、海灘、湖泊與森林都只由種子與座標決定。
Rolling hills, mountains, beaches, lakes and forests depend only on the seed and coordinates.
資料以每 4 個方塊壓成一個整數（每格 6 位元，最多 64 種方塊）儲存，節省 Wasm 記憶體。
Chunk data packs four block ids per integer (6 bits each, up to 64 block types) to stay well inside Wasm memory.
##
變數 雜 = 0;
變數 方 = 0;
變數 高度 = 128;
變數 海平面 = 52;
變數 每格 = 8192;      # 16*16*128/4 packed values per chunk

變數 初始化 = 函式(雜訊模組, 方塊模組, 種子) {
    雜 = 雜訊模組;
    方 = 方塊模組;
    雜.設定種子(種子);
};

# 地形高度（倍精度）；同時供生成與出生點搜尋使用。 Terrain height for a column.
變數 地形高度 = 函式(x, z) {
    變數 大陸 = 雜.分形(x, z, 760.0d, 3, 101);
    變數 基準 = 海平面 + (大陸 - 0.46d) * 64.0d;
    變數 丘陵 = (雜.分形(x, z, 150.0d, 3, 211) - 0.5d) * 20.0d;
    變數 山區 = 雜.平滑階梯(0.50d, 0.66d, 雜.分形(x + 913.0d, z - 377.0d, 900.0d, 2, 307));
    變數 脊 = 雜.山脊(x, z, 230.0d, 4, 401);
    變數 山 = 脊 * 脊 * 78.0d * 山區;
    變數 細節 = (雜.值雜訊(x / 21.0d, z / 21.0d, 503) - 0.5d) * 3.0d;
    # 河谷：在低窪處把丘陵壓平，形成開闊的谷地。 Flatten hills in low valleys.
    變數 谷 = 雜.平滑階梯(海平面 - 4.0d, 海平面 + 10.0d, 基準 + 山);
    變數 h = 基準 + 丘陵 * (0.35d + 0.65d * 谷) + 山 + 細節;
    如果 (h < 8) { h = 8.0d; }
    如果 (h > 120) { h = 120.0d; }
    回傳 h;
};

變數 森林度 = 函式(x, z) { 回傳 雜.分形(x - 1777.0d, z + 991.0d, 210.0d, 2, 601); };

# 樹的位置：每個 5x5 網格最多一棵，避免樹木相黏。 One tree candidate per 5x5 cell.
變數 樹候選 = 函式(格x, 格z) {
    變數 ox = 雜.取整(雜.雜湊2(格x, 格z, 701) * 4.99d);
    變數 oz = 雜.取整(雜.雜湊2(格x, 格z, 702) * 4.99d);
    回傳 [格x * 5 + ox, 格z * 5 + oz];
};

# 回傳樹種：0 無、1 闊葉樹、2 針葉樹。 Tree type at a world column: 0 none, 1 broadleaf, 2 conifer.
變數 樹種 = 函式(x, z, h) {
    如果 (h < 海平面 + 2 || h > 100) { 回傳 0; }
    變數 f = 森林度(x, z);
    變數 機率 = (f - 0.47d) * 2.4d;
    如果 (機率 < 0.03d) { 機率 = 0.03d; }
    如果 (雜.雜湊2(x, z, 703) > 機率) { 回傳 0; }
    # 坡度過大不長樹。 No trees on steep slopes.
    變數 d = 地形高度(x + 1.0d, z) - 地形高度(x - 1.0d, z);
    變數 e = 地形高度(x, z + 1.0d) - 地形高度(x, z - 1.0d);
    如果 (d * d + e * e > 9.0d) { 回傳 0; }
    如果 (h > 78 || 雜.雜湊2(x, z, 704) < 0.18d) { 回傳 2; }
    回傳 1;
};

變數 索引 = 函式(x, y, z) { 回傳 (y * 16 + z) * 16 + x; };

# 產生一個區塊的未壓縮方塊陣列（長度 32768）。 Generate an unpacked chunk (32768 ids).
變數 產生原始 = 函式(cx, cz) {
    變數 資料 = 陣列.建立(32768, 0);
    變數 x0 = cx * 16;
    變數 z0 = cz * 16;
    # 18x18 高度圖用於計算坡度。 Padded height map for slopes.
    變數 高 = 陣列.建立(324, 0);
    迴圈 (變數 j = 0; j < 18; j++) {
        迴圈 (變數 i = 0; i < 18; i++) {
            高[j * 18 + i] = 雜.取整(地形高度(x0 + i - 1.0d, z0 + j - 1.0d));
        }
    }
    迴圈 (變數 z = 0; z < 16; z++) {
        迴圈 (變數 x = 0; x < 16; x++) {
            變數 p = (z + 1) * 18 + x + 1;
            變數 h = 高[p];
            變數 坡 = 0;
            變數 n1 = 高[p + 1] - 高[p - 1];
            變數 n2 = 高[p + 18] - 高[p - 18];
            如果 (n1 < 0) { n1 = -n1; }
            如果 (n2 < 0) { n2 = -n2; }
            坡 = n1;
            如果 (n2 > 坡) { 坡 = n2; }
            變數 wx = x0 + x;
            變數 wz = z0 + z;
            變數 r = 雜.雜湊2(wx, wz, 801);
            變數 頂 = 方.草地;
            變數 次 = 方.泥土;
            變數 雪線 = 94 + 雜.取整(r * 6.0d);
            如果 (h <= 海平面 + 1) {
                # 海灘與湖底。 Beaches and lake beds.
                頂 = 方.沙子; 次 = 方.沙子;
                如果 (h < 海平面 - 3) {
                    變數 底 = 雜.值雜訊(wx / 13.0d, wz / 13.0d, 811);
                    如果 (底 < 0.33d) { 頂 = 方.礫石; 次 = 方.礫石; } 否則如果 (底 > 0.72d) { 頂 = 方.黏土; 次 = 方.黏土; }
                }
            } 否則如果 (h >= 雪線) {
                頂 = 方.雪地; 次 = 方.石頭;
                如果 (坡 >= 3) { 頂 = 方.石頭; }
            } 否則如果 (坡 >= 3) {
                頂 = 方.石頭; 次 = 方.石頭;
            } 否則如果 (h > 84 && 坡 >= 2) {
                頂 = 方.礫石; 次 = 方.石頭;
            }
            變數 泥深 = 3 + 雜.取整(r * 2.0d);
            # 礦脈：4x4x4 格子決定是否有礦，格內再逐格取樣。 Ore veins: a 4x4x4 cell decides, blocks sample inside it.
            變數 gx4 = 雜.地板除(wx, 4); 變數 gz4 = 雜.地板除(wz, 4);
            變數 上格 = -1; 變數 格值 = 1.0d;
            迴圈 (變數 y = 0; y <= h; y++) {
                變數 id = 方.石頭;
                如果 (y == h) { id = 頂; } 否則如果 (y > h - 泥深) { id = 次; }
                如果 (id == 方.石頭 && y > 1) {
                    變數 gy4 = y / 4;
                    如果 (gy4 != 上格) { 上格 = gy4; 格值 = 雜.雜湊3(gx4, gy4, gz4, 911); }
                    如果 (格值 < 0.075d) {
                        如果 (雜.雜湊3(wx, y, wz, 912) < 0.42d) { id = 方.煤礦; }
                    } 否則如果 (格值 < 0.115d && y < 60) {
                        如果 (雜.雜湊3(wx, y, wz, 913) < 0.38d) { id = 方.鐵礦; }
                    }
                }
                # 世界底部是基岩。 Bedrock floor.
                如果 (y == 0) { id = 方.基岩; }
                如果 (y == 1 && 雜.雜湊2(wx, wz, 914) < 0.5d) { id = 方.基岩; }
                資料[(y * 16 + z) * 16 + x] = id;
            }
            迴圈 (變數 y = h + 1; y <= 海平面; y++) { 資料[(y * 16 + z) * 16 + x] = 方.水; }
            # 草與花。 Grass tufts and flowers on open grass.
            如果 (頂 == 方.草地 && h > 海平面 + 1 && h < 126) {
                變數 草量 = 0.03d + 森林度(wx, wz) * 0.13d;
                變數 g = 雜.雜湊2(wx, wz, 821);
                如果 (g < 草量) {
                    如果 (g < 0.012d) { 資料[((h + 1) * 16 + z) * 16 + x] = 方.花; } 否則 { 資料[((h + 1) * 16 + z) * 16 + x] = 方.高草; }
                }
            }
        }
    }
    # 樹木：檢查涵蓋本區塊（含 3 格外框）的候選格。 Trees whose canopy can reach this chunk.
    變數 gx0 = 雜.地板除(x0 - 3, 5);
    變數 gx1 = 雜.地板除(x0 + 18, 5);
    變數 gz0 = 雜.地板除(z0 - 3, 5);
    變數 gz1 = 雜.地板除(z0 + 18, 5);
    迴圈 (變數 gz = gz0; gz <= gz1; gz++) {
        迴圈 (變數 gx = gx0; gx <= gx1; gx++) {
            變數 c = 樹候選(gx, gz);
            變數 tx = c[0];
            變數 tz = c[1];
            變數 th = 雜.取整(地形高度(tx * 1.0d, tz * 1.0d));
            變數 種 = 樹種(tx * 1.0d, tz * 1.0d, th);
            如果 (種 > 0) { 種樹(資料, tx - x0, th + 1, tz - z0, 種, 雜.雜湊2(tx, tz, 705)); }
        }
    }
    回傳 資料;
};

變數 放置 = 函式(資料, x, y, z, id, 覆蓋) {
    如果 (x >= 0 && x < 16 && z >= 0 && z < 16 && y >= 0 && y < 高度) {
        變數 i = (y * 16 + z) * 16 + x;
        變數 舊 = 資料[i];
        如果 (覆蓋 || 舊 == 0 || 舊 == 方.高草 || 舊 == 方.花) { 資料[i] = id; }
    }
};

變數 種樹 = 函式(資料, x, y, z, 種, r) {
    如果 (種 == 1) {
        變數 幹高 = 4 + 雜.取整(r * 3.0d);
        變數 頂y = y + 幹高;
        迴圈 (變數 dy = -2; dy <= 1; dy++) {
            變數 半徑 = 2;
            如果 (dy >= 0) { 半徑 = 1; }
            迴圈 (變數 dz = -半徑; dz <= 半徑; dz++) {
                迴圈 (變數 dx = -半徑; dx <= 半徑; dx++) {
                    變數 角 = (dx == -半徑 || dx == 半徑) && (dz == -半徑 || dz == 半徑);
                    變數 留 = !角 || 雜.雜湊3(x + dx, 頂y + dy, z + dz, 706) < 0.45d;
                    如果 (dy == 1 && 角) { 留 = 假; }
                    如果 (留) { 放置(資料, x + dx, 頂y + dy, z + dz, 方.樹葉, 假); }
                }
            }
        }
        迴圈 (變數 i = 0; i < 幹高; i++) { 放置(資料, x, y + i, z, 方.原木, 真); }
        放置(資料, x, y - 1, z, 方.泥土, 真);
    } 否則 {
        變數 幹高 = 6 + 雜.取整(r * 4.0d);
        變數 頂y = y + 幹高;
        變數 層 = 0;
        迴圈 (變數 yy = 頂y + 1; yy >= y + 2; yy -= 1) {
            變數 半徑 = 0;
            如果 (層 > 0) { 半徑 = 1 + (層 % 2); }
            如果 (層 > 4) { 半徑 = 2; }
            迴圈 (變數 dz = -半徑; dz <= 半徑; dz++) {
                迴圈 (變數 dx = -半徑; dx <= 半徑; dx++) {
                    如果 (dx * dx + dz * dz <= 半徑 * 半徑 + 1) { 放置(資料, x + dx, yy, z + dz, 方.樹葉, 假); }
                }
            }
            層++;
        }
        迴圈 (變數 i = 0; i < 幹高; i++) { 放置(資料, x, y + i, z, 方.原木, 真); }
        放置(資料, x, y - 1, z, 方.泥土, 真);
    }
};

# 壓縮：每 4 個方塊一個整數（6 位元）。 Pack four 6-bit ids per value.
變數 壓縮 = 函式(原始) {
    變數 結果 = 陣列.建立(每格, 0);
    變數 j = 0;
    迴圈 (變數 i = 0; i < 32768; i += 4) {
        結果[j] = 原始[i] + 原始[i + 1] * 64 + 原始[i + 2] * 4096 + 原始[i + 3] * 262144;
        j++;
    }
    回傳 結果;
};

變數 解壓 = 函式(壓) {
    變數 原始 = 陣列.建立(32768, 0);
    變數 i = 0;
    迴圈 (變數 j = 0; j < 每格; j++) {
        變數 v = 壓[j];
        如果 (v != 0) {
            變數 a = v % 64; v = (v - a) / 64;
            變數 b = v % 64; v = (v - b) / 64;
            變數 c = v % 64;
            原始[i] = a; 原始[i + 1] = b; 原始[i + 2] = c; 原始[i + 3] = (v - c) / 64;
        }
        i += 4;
    }
    回傳 原始;
};

# 出生點：尋找視野開闊、前方有湖或海、遠方有山的草地。 Spawn: an open grassy rise facing water with mountains beyond.
# 附近 3 格內是否有高過視線的樹（出生點與視線檢查用）。 Is a tree that reaches eye level within 3 blocks?
變數 附近有樹 = 函式(x, z, 眼) {
    變數 gx = 雜.地板除(雜.取整(x), 5);
    變數 gz = 雜.地板除(雜.取整(z), 5);
    迴圈 (變數 cz = gz - 1; cz <= gz + 1; cz++) {
        迴圈 (變數 cx = gx - 1; cx <= gx + 1; cx++) {
            變數 c = 樹候選(cx, cz);
            變數 ddx = c[0] + 0.5d - x; 變數 ddz = c[1] + 0.5d - z;
            如果 (ddx * ddx + ddz * ddz < 9.0d) {
                變數 th = 雜.取整(地形高度(c[0] * 1.0d, c[1] * 1.0d));
                如果 (th + 7 > 眼 && 樹種(c[0] * 1.0d, c[1] * 1.0d, th) > 0) { 回傳 真; }
            }
        }
    }
    回傳 假;
};

# 評分一個候選出生點，回傳 [分數, x, h, z, dx, dz] 或空陣列。 Score one spawn candidate.
變數 方向表 = [[1.0d, 0.0d], [0.7071d, 0.7071d], [0.0d, 1.0d], [-0.7071d, 0.7071d], [-1.0d, 0.0d], [-0.7071d, -0.7071d], [0.0d, -1.0d], [0.7071d, -0.7071d]];
變數 評分出生點 = 函式(x, z) {
    變數 h = 地形高度(x, z);
    如果 (h <= 海平面 + 4 || h >= 海平面 + 20) { 回傳 []; }
    變數 林 = 森林度(x, z);
    變數 結果 = [];
    變數 結果分 = -100000.0d;
    迴圈 (變數 a = 0; a < 8; a++) {
        變數 dx = 方向表[a][0]; 變數 dz = 方向表[a][1];
        變數 水 = 0.0d; 變數 岸 = 0.0d; 變數 山 = 0.0d; 變數 擋 = 0.0d;
        迴圈 (變數 s = 1; s <= 14; s++) {
            變數 d = s * 12.0d;
            如果 (s <= 3) { d = s * 8.0d; }
            變數 hh = 地形高度(x + dx * d, z + dz * d);
            如果 (s <= 4 && hh > h + 1.0d) { 擋 += 1.0d; }
            # 近處是水、遠處（仍在視距內）有對岸與山。 Water up close, a visible far shore and peaks beyond.
            如果 (s >= 3 && s <= 7 && hh < 海平面 - 1) { 水 += 1.0d; }
            如果 (s >= 8 && s <= 12 && hh > 海平面 + 1) { 岸 += 1.0d; }
            如果 (s >= 8 && hh > 海平面 + 24) { 山 += 1.0d; }
        }
        變數 分 = 水 * 3.0d + 岸 * 2.0d + 山 * 2.5d + 林 * 3.0d - 擋 * 5.0d;
        如果 (水 >= 2 && 岸 >= 1 && 分 > 結果分) {
            # 站立處與前 30 格視線不能被樹擋住。 The spot and the first 30 blocks of the view must be clear of trees.
            變數 擋住 = 附近有樹(x + 0.5d, z + 0.5d, h);
            迴圈 (變數 k = 2; k <= 30 && !擋住; k += 3) { 擋住 = 附近有樹(x + 0.5d + dx * k, z + 0.5d + dz * k, h); }
            如果 (!擋住) { 結果分 = 分; 結果 = [分, x, h, z, dx, dz]; }
        }
    }
    回傳 結果;
};

# 由內向外逐圈搜尋（每格 24 方塊），找到後再多看三圈取最佳；最遠約 720 方塊。
# Search square rings outward (24-block cells); after the first hit look three more rings, up to ~720 blocks.
變數 尋找出生點 = 函式() {
    變數 最佳 = [8.0d, 地形高度(8.0d, 8.0d), 8.0d, 0.0d, 1.0d];
    變數 最佳分 = -100000.0d;
    變數 首圈 = -1;
    迴圈 (變數 r = 0; r < 30; r++) {
        迴圈 (變數 j = -r; j <= r; j++) {
            迴圈 (變數 i = -r; i <= r; i++) {
                變數 ai = i; 如果 (ai < 0) { ai = -ai; }
                變數 aj = j; 如果 (aj < 0) { aj = -aj; }
                如果 (ai == r || aj == r) {
                    變數 c = 評分出生點(i * 24.0d + 8.0d, j * 24.0d + 8.0d);
                    如果 (長度(c) > 0) {
                        變數 分 = c[0] - (i * i + j * j) * 0.034d;
                        如果 (分 > 最佳分) { 最佳分 = 分; 最佳 = [c[1], c[2], c[3], c[4], c[5]]; }
                    }
                }
            }
        }
        如果 (首圈 < 0 && 最佳分 > -100000.0d) { 首圈 = r; }
        如果 (首圈 >= 0 && r >= 首圈 + 3) { 中斷; }
    }
    回傳 最佳;
};
