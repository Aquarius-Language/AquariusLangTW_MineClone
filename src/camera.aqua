## 相機與矩陣（Camera and matrices, column-major, WebGPU depth 0..1）
所有世界繪製都以相機為原點（camera-relative），避免遠離原點時的浮點誤差。
World rendering is camera-relative to keep float precision far from the origin.
##
變數 數 = 0;
變數 初始化 = 函式(數學模組) { 數 = 數學模組; };

變數 透視 = 函式(fovy, 寬高比, 近, 遠) {
    變數 f = 1.0d / (數.Sin(fovy * 0.5d) / 數.Cos(fovy * 0.5d));
    變數 m = 陣列.建立(16, 0.0d);
    m[0] = f / 寬高比; m[5] = f; m[10] = 遠 / (近 - 遠); m[11] = -1.0d; m[14] = 近 * 遠 / (近 - 遠);
    回傳 m;
};

變數 正規化 = 函式(x, y, z) {
    變數 l = 數.Sqrt(x * x + y * y + z * z);
    如果 (l < 0.000001d) { 回傳 [0.0d, 1.0d, 0.0d]; }
    回傳 [x / l, y / l, z / l];
};
變數 外積 = 函式(a, b) { 回傳 [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]; };
變數 內積 = 函式(a, b) { 回傳 a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; };

# 只有旋轉的視圖矩陣（相機相對）。 Rotation-only view matrix.
變數 視圖 = 函式(前) {
    變數 右 = 正規化(-前[2], 0.0d, 前[0]);
    如果 (前[0] * 前[0] + 前[2] * 前[2] < 0.000001d) { 右 = [1.0d, 0.0d, 0.0d]; }
    右 = 正規化(右[0], 右[1], 右[2]);
    變數 上 = 外積(右, 前);
    變數 m = 陣列.建立(16, 0.0d);
    m[0] = 右[0]; m[4] = 右[1]; m[8] = 右[2];
    m[1] = 上[0]; m[5] = 上[1]; m[9] = 上[2];
    m[2] = -前[0]; m[6] = -前[1]; m[10] = -前[2];
    m[15] = 1.0d;
    回傳 m;
};

變數 乘 = 函式(a, b) {
    變數 r = 陣列.建立(16, 0.0d);
    迴圈 (變數 c = 0; c < 4; c++) {
        迴圈 (變數 rr = 0; rr < 4; rr++) {
            r[c * 4 + rr] = a[rr] * b[c * 4] + a[4 + rr] * b[c * 4 + 1] + a[8 + rr] * b[c * 4 + 2] + a[12 + rr] * b[c * 4 + 3];
        }
    }
    回傳 r;
};

# 太陽正交陰影矩陣，中心貼齊紋素格以避免移動時閃爍。 Texel-snapped orthographic sun matrix.
變數 陰影矩陣 = 函式(光向, 相機, 中心偏移, 半徑, 尺寸) {
    變數 f = [-光向[0], -光向[1], -光向[2]];
    變數 提示 = [0.0d, 1.0d, 0.0d];
    如果 (f[1] > 0.99d || f[1] < -0.99d) { 提示 = [0.0d, 0.0d, 1.0d]; }
    變數 r = 外積(f, 提示); r = 正規化(r[0], r[1], r[2]);
    變數 u = 外積(r, f);
    # 世界座標中心，投影到光空間後貼齊。 Snap the world-space centre in light space.
    變數 c = [相機[0] + 中心偏移[0], 相機[1] + 中心偏移[1], 相機[2] + 中心偏移[2]];
    變數 紋素 = 2.0d * 半徑 / 尺寸;
    變數 lx = 內積(c, r); 變數 ly = 內積(c, u); 變數 lz = 內積(c, f);
    變數 t = 0; t += lx / 紋素; 如果 (t > lx / 紋素) { t -= 1; } lx = t * 紋素;
    t = 0; t += ly / 紋素; 如果 (t > ly / 紋素) { t -= 1; } ly = t * 紋素;
    變數 sc = [r[0] * lx + u[0] * ly + f[0] * lz, r[1] * lx + u[1] * ly + f[1] * lz, r[2] * lx + u[2] * ly + f[2] * lz];
    變數 D = 半徑 * 2.0d + 220.0d;
    # 光源眼睛（相機相對）：中心往太陽方向退 D/2。 Light eye, camera-relative.
    變數 e = [sc[0] - 相機[0] - f[0] * D * 0.5d, sc[1] - 相機[1] - f[1] * D * 0.5d, sc[2] - 相機[2] - f[2] * D * 0.5d];
    變數 m = 陣列.建立(16, 0.0d);
    m[0] = r[0] / 半徑; m[4] = r[1] / 半徑; m[8] = r[2] / 半徑; m[12] = -內積(r, e) / 半徑;
    m[1] = u[0] / 半徑; m[5] = u[1] / 半徑; m[9] = u[2] / 半徑; m[13] = -內積(u, e) / 半徑;
    m[2] = f[0] / D; m[6] = f[1] / D; m[10] = f[2] / D; m[14] = -內積(f, e) / D;
    m[15] = 1.0d;
    回傳 m;
};
