## 確定性雜湊與值雜訊（Deterministic hashing and value noise）
星泉沒有位元運算子，因此雜湊使用 2^31-1 的模運算；平方步驟以 16 位元拆分保持精確，
避免線性同餘造成的格紋。所有運算都是 IEEE 倍精度，在桌面與網頁得到相同結果。
Aquarius has no bitwise operators, so hashing works modulo 2^31-1. The squaring step splits the value
into 16-bit halves so every product stays exact (below 2^53) and breaks linear lattice artefacts.
##
變數 模數 = 2147483647.0d;
變數 種子值 = 1.0d;

變數 設定種子 = 函式(種子) {
    種子值 = (種子 * 1.0d) % 模數;
    如果 (種子值 < 0) { 種子值 += 模數; }
    回傳 種子值;
};

# 向下取整：複合指派會把倍精度截斷成整數，再修正負數。 Floor via truncating compound assignment.
變數 取整 = 函式(x) {
    變數 t = 0;
    t += x;
    如果 (t > x) { t -= 1; }
    回傳 t;
};

# 整數除法向下取整（區塊座標）。 Floor division for chunk coordinates.
變數 地板除 = 函式(a, n) {
    變數 q = a / n;
    如果 (q * n > a) { q -= 1; }
    回傳 q;
};

變數 平方模 = 函式(h) {
    變數 b = h % 65536.0d;
    變數 a = (h - b) / 65536.0d;
    回傳 (2.0d * a * a + 2.0d * a * b * 65536.0d + b * b) % 模數;
};

# 回傳 [0,1) 的雜湊值。 Hash of two integers in [0,1).
變數 雜湊2 = 函式(x, z, 通道) {
    變數 h = (x * 1619.0d + z * 31337.0d + 通道 * 1013.0d + 種子值 * 6971.0d) % 模數;
    如果 (h < 0) { h += 模數; }
    h = (h * 48271.0d + 11.0d) % 模數;
    h = 平方模(h + 1.0d);
    h = (h * 16807.0d + 7.0d) % 模數;
    回傳 h / 模數;
};

變數 雜湊3 = 函式(x, y, z, 通道) {
    回傳 雜湊2(x + y * 9973.0d, z - y * 7919.0d, 通道);
};

變數 平滑 = 函式(t) { 回傳 t * t * (3.0d - 2.0d * t); };

# 二維值雜訊，回傳 [0,1]。 2D value noise in [0,1].
變數 值雜訊 = 函式(x, z, 通道) {
    變數 ix = 取整(x);
    變數 iz = 取整(z);
    變數 fx = 平滑(x - ix);
    變數 fz = 平滑(z - iz);
    變數 a = 雜湊2(ix, iz, 通道);
    變數 b = 雜湊2(ix + 1, iz, 通道);
    變數 c = 雜湊2(ix, iz + 1, 通道);
    變數 d = 雜湊2(ix + 1, iz + 1, 通道);
    變數 上 = a + (b - a) * fx;
    變數 下 = c + (d - c) * fx;
    回傳 上 + (下 - 上) * fz;
};

# 分形布朗運動。 Fractal Brownian motion with the given octave count.
變數 分形 = 函式(x, z, 尺度, 八度, 通道) {
    變數 總和 = 0.0d;
    變數 振幅 = 1.0d;
    變數 正規 = 0.0d;
    變數 頻率 = 1.0d / 尺度;
    迴圈 (變數 o = 0; o < 八度; o++) {
        總和 += 值雜訊(x * 頻率 + o * 17.31d, z * 頻率 - o * 9.17d, 通道 + o) * 振幅;
        正規 += 振幅;
        振幅 *= 0.5d;
        頻率 *= 2.03d;
    }
    回傳 總和 / 正規;
};

# 山脊雜訊：1 - |2n-1|，平方後得到尖銳山脊。 Ridged noise for mountain ranges.
變數 山脊 = 函式(x, z, 尺度, 八度, 通道) {
    變數 總和 = 0.0d;
    變數 振幅 = 1.0d;
    變數 正規 = 0.0d;
    變數 頻率 = 1.0d / 尺度;
    變數 權重 = 1.0d;
    迴圈 (變數 o = 0; o < 八度; o++) {
        變數 n = 值雜訊(x * 頻率 + o * 31.7d, z * 頻率 + o * 4.3d, 通道 + o) * 2.0d - 1.0d;
        如果 (n < 0) { n = -n; }
        n = 1.0d - n;
        n = n * n * 權重;
        權重 = n * 1.6d;
        如果 (權重 > 1.0d) { 權重 = 1.0d; }
        總和 += n * 振幅;
        正規 += 振幅;
        振幅 *= 0.5d;
        頻率 *= 2.1d;
    }
    回傳 總和 / 正規;
};

變數 平滑階梯 = 函式(a, b, x) {
    變數 t = (x - a) / (b - a);
    如果 (t < 0) { t = 0.0d; }
    如果 (t > 1) { t = 1.0d; }
    回傳 t * t * (3.0d - 2.0d * t);
};
