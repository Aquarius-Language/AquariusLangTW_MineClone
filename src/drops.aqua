## 掉落物與粒子（Dropped items and particles）
掉落物有重力、碰撞與磁吸；靠近玩家且背包有空間時撿起。粒子只用於視覺回饋。
Dropped items fall, collide and drift toward the player, entering the inventory when there is room.
Particles are purely visual feedback for mining, breaking and tool wear.
實體繪製資料每個 12 個浮點數 Render records, 12 floats each:
  x, y, z, 大小, 旋轉, 種類 (0 方塊 1 平面方塊圖格 2 物品圖示 3 粒子 4 怪物), a, b, c, 亮度, e1, e2
##
變數 世 = 0;
變數 方 = 0;
變數 物 = 0;
變數 背 = 0;
變數 數 = 0;
變數 物品們 = [];     # [x, y, z, vx, vy, vz, id, 數量, 損耗, 年齡, 延遲]
變數 粒子們 = [];     # [x, y, z, vx, vy, vz, 圖格, 壽命, 總壽命, 大小]
變數 種子 = 777.0d;
變數 合併計時 = 0.0d;
變數 最多物品 = 200;
變數 最多粒子 = 160;

變數 初始化 = 函式(世界模組, 方塊模組, 物品模組, 背包模組, 數學模組) {
    世 = 世界模組; 方 = 方塊模組; 物 = 物品模組; 背 = 背包模組; 數 = 數學模組;
    物品們 = []; 粒子們 = [];
};

變數 亂數 = 函式() { 種子 = (種子 * 16807.0d) % 2147483647.0d; 回傳 種子 / 2147483647.0d; };
變數 取整 = 函式(v) { 變數 t = 0; t += v; 如果 (t > v) { t -= 1; } 回傳 t; };

變數 實心 = 函式(x, y, z) {
    變數 id = 世.取方塊(取整(x), 取整(y), 取整(z));
    如果 (id < 0) { 回傳 真; }
    回傳 (方.實體)[id];
};

# 丟出一疊物品。 Spawn a dropped stack.
變數 丟出 = 函式(x, y, z, id, n, d, vx, vy, vz, 延遲) {
    如果 (id == 0 || n <= 0) { 回傳 0; }
    如果 (長度(物品們) >= 最多物品) { 陣列.刪除(物品們, 0, 1); }
    陣列.追加(物品們, [x, y, z, vx, vy, vz, id, n, d, 0.0d, 延遲]);
    回傳 0;
};

# 方塊被挖掉時從中心彈出。 Pop an item out of a broken block.
變數 彈出 = 函式(bx, by, bz, id, n, d) {
    丟出(bx + 0.5d, by + 0.35d, bz + 0.5d, id, n, d, (亂數() - 0.5d) * 2.2d, 3.2d + 亂數() * 1.2d, (亂數() - 0.5d) * 2.2d, 0.35d);
};

變數 粒子 = 函式(x, y, z, 圖格, vx, vy, vz, 壽命, 大小) {
    如果 (長度(粒子們) >= 最多粒子) { 陣列.刪除(粒子們, 0, 1); }
    陣列.追加(粒子們, [x, y, z, vx, vy, vz, 圖格, 壽命, 壽命, 大小]);
};

# 挖掘或破壞時的碎屑。 Debris for mining hits (few) or breaking (many).
變數 碎屑 = 函式(bx, by, bz, 圖格, 數量, 力道) {
    迴圈 (變數 i = 0; i < 數量; i++) {
        變數 px = bx + 0.15d + 亂數() * 0.7d; 變數 py = by + 0.15d + 亂數() * 0.7d; 變數 pz = bz + 0.15d + 亂數() * 0.7d;
        粒子(px, py, pz, 圖格, (px - bx - 0.5d) * 力道 * 3.0d, 亂數() * 力道 * 3.0d + 0.5d, (pz - bz - 0.5d) * 力道 * 3.0d, 0.5d + 亂數() * 0.5d, 0.07d + 亂數() * 0.05d);
    }
};

# 每影格更新；回傳本影格撿起的物品數。 Per-frame update; returns how many stacks were picked up.
變數 更新 = 函式(dt, 玩家腳, 可撿) {
    變數 撿起 = 0;
    變數 px = 玩家腳[0]; 變數 py = 玩家腳[1] + 0.8d; 變數 pz = 玩家腳[2];
    變數 保留 = [];
    迴圈 (變數 i = 0; i < 長度(物品們); i++) {
        變數 e = 物品們[i];
        e[9] = e[9] + dt;
        e[10] = e[10] - dt;
        變數 dx = px - e[0]; 變數 dy = py - e[1]; 變數 dz = pz - e[2];
        變數 d2 = dx * dx + dy * dy + dz * dz;
        變數 磁吸 = 可撿 && e[10] <= 0 && d2 < 6.25d && 背.可容納(e[6], 1, e[8]);
        如果 (磁吸) {
            變數 d = 數.Sqrt(d2) + 0.001d;
            e[3] = e[3] + dx / d * 30.0d * dt; e[4] = e[4] + dy / d * 30.0d * dt; e[5] = e[5] + dz / d * 30.0d * dt;
        }
        # 重力與水中浮力。 Gravity, with buoyancy in water.
        變數 在水 = 世.取方塊(取整(e[0]), 取整(e[1] + 0.1d), 取整(e[2])) == 方.水;
        如果 (在水) { e[4] = e[4] * (1.0d - 3.0d * dt) + 3.0d * dt; } 否則 { e[4] = e[4] - 20.0d * dt; }
        變數 阻 = 1.0d - 2.0d * dt;
        e[3] = e[3] * 阻; e[5] = e[5] * 阻;
        # 逐軸移動。 Per-axis movement.
        變數 ny = e[1] + e[4] * dt;
        如果 (e[4] < 0 && 實心(e[0], ny, e[2])) {
            e[1] = 取整(ny) + 1.0d; e[4] = 0.0d;
            e[3] = e[3] * (1.0d - 8.0d * dt); e[5] = e[5] * (1.0d - 8.0d * dt);
        } 否則如果 (e[4] > 0 && 實心(e[0], ny + 0.25d, e[2])) {
            e[4] = 0.0d;
        } 否則 { e[1] = ny; }
        變數 nx = e[0] + e[3] * dt;
        如果 (實心(nx, e[1] + 0.05d, e[2])) { e[3] = 0.0d; } 否則 { e[0] = nx; }
        變數 nz = e[2] + e[5] * dt;
        如果 (實心(e[0], e[1] + 0.05d, nz)) { e[5] = 0.0d; } 否則 { e[2] = nz; }
        # 卡在方塊裡時往上推。 Push out of blocks it is stuck inside.
        如果 (實心(e[0], e[1] + 0.05d, e[2])) { e[1] = 取整(e[1] + 0.05d) + 1.0d; e[4] = 0.0d; }
        變數 留 = 真;
        如果 (可撿 && e[10] <= 0 && d2 < 1.6d) {
            變數 剩 = 背.加入(e[6], e[7], e[8]);
            如果 (剩 < e[7]) { 撿起++; }
            如果 (剩 <= 0) { 留 = 假; } 否則 { e[7] = 剩; }
        }
        如果 (e[9] > 300.0d || e[1] < -10) { 留 = 假; }
        如果 (留) { 陣列.追加(保留, e); }
    }
    物品們 = 保留;
    # 合併附近相同物品。 Merge nearby identical stacks every half second.
    合併計時 -= dt;
    如果 (合併計時 <= 0) {
        合併計時 = 0.5d;
        迴圈 (變數 i = 0; i < 長度(物品們); i++) {
            變數 a = 物品們[i];
            如果 (a[7] > 0 && 物.最大堆疊(a[6]) > 1) {
                迴圈 (變數 j = i + 1; j < 長度(物品們); j++) {
                    變數 b = 物品們[j];
                    如果 (b[7] > 0 && b[6] == a[6] && b[8] == a[8] && a[7] + b[7] <= 64) {
                        變數 ex = a[0] - b[0]; 變數 ey = a[1] - b[1]; 變數 ez = a[2] - b[2];
                        如果 (ex * ex + ey * ey + ez * ez < 1.0d) { a[7] = a[7] + b[7]; b[7] = 0; }
                    }
                }
            }
        }
        變數 剩下 = [];
        迴圈 (變數 i = 0; i < 長度(物品們); i++) { 如果 ((物品們[i])[7] > 0) { 陣列.追加(剩下, 物品們[i]); } }
        物品們 = 剩下;
    }
    # 粒子。 Particles.
    變數 留粒 = [];
    迴圈 (變數 i = 0; i < 長度(粒子們); i++) {
        變數 p = 粒子們[i];
        p[7] = p[7] - dt;
        p[4] = p[4] - 16.0d * dt;
        變數 ny = p[1] + p[4] * dt;
        如果 (p[4] < 0 && 實心(p[0], ny, p[2])) { p[1] = 取整(ny) + 1.0d; p[4] = 0.0d; p[3] = p[3] * 0.5d; p[5] = p[5] * 0.5d; } 否則 { p[1] = ny; }
        p[0] = p[0] + p[3] * dt; p[2] = p[2] + p[5] * dt;
        如果 (p[7] > 0) { 陣列.追加(留粒, p); }
    }
    粒子們 = 留粒;
    回傳 撿起;
};

# 寫出繪製紀錄到 out（扁平陣列）。 Append render records to out.
變數 繪製資料 = 函式(out, 時間) {
    迴圈 (變數 i = 0; i < 長度(物品們); i++) {
        變數 e = 物品們[i];
        變數 浮 = 數.Sin(e[9] * 2.5d) * 0.06d + 0.16d;
        變數 圖 = 物.圖示(e[6]);
        變數 種 = 2; 變數 a = 圖[1]; 變數 b = 0; 變數 c = 0; 變數 大小 = 0.42d;
        如果 (圖[0] == 0) { 種 = 0; a = (方.頂面)[e[6]]; b = (方.側面)[e[6]]; c = (方.底面)[e[6]]; 大小 = 0.26d; }
        如果 (圖[0] == 1) { 種 = 1; }
        陣列.追加陣列(out, [e[0], e[1] + 浮, e[2], 大小, e[9] * 1.6d, 種, a, b, c, 1.0d, 0, 0]);
        # 一疊較多時多畫一個。 Show a second copy for larger stacks.
        如果 (e[7] > 1 && 圖[0] == 0) { 陣列.追加陣列(out, [e[0] + 0.08d, e[1] + 浮 + 0.1d, e[2] + 0.05d, 大小, e[9] * 1.6d + 0.6d, 種, a, b, c, 1.0d, 0, 0]); }
    }
    迴圈 (變數 i = 0; i < 長度(粒子們); i++) {
        變數 p = 粒子們[i];
        變數 s = p[9] * (0.4d + 0.6d * p[7] / p[8]);
        陣列.追加陣列(out, [p[0], p[1], p[2], s, 0, 3, p[6], i % 7, (i * 3) % 7, 1.0d, 0, 0]);
    }
};

# ---------- 存檔 Serialisation ----------
變數 匯出 = 函式() {
    變數 out = [];
    迴圈 (變數 i = 0; i < 長度(物品們); i++) {
        變數 e = 物品們[i];
        陣列.追加陣列(out, [e[0], e[1], e[2], e[6], e[7], e[8], e[9]]);
    }
    回傳 out;
};

變數 匯入 = 函式(清單) {
    物品們 = [];
    迴圈 (變數 i = 0; i + 6 < 長度(清單); i += 7) {
        如果 (物.有效(清單[i + 3])) { 陣列.追加(物品們, [清單[i], 清單[i + 1], 清單[i + 2], 0.0d, 0.0d, 0.0d, 清單[i + 3], 清單[i + 4], 清單[i + 5], 清單[i + 6], 0.0d]); }
    }
};

變數 清除 = 函式() { 物品們 = []; 粒子們 = []; };
