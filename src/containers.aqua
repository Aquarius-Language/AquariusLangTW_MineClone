## 容器（Containers）：箱子（27 格）與熔爐（輸入、燃料、輸出）。以方塊座標為鍵，隨存檔保存。
熔爐在區塊載入時持續運作，點燃時換成發光的方塊。
Chests (27 slots) and furnaces (input, fuel, output), keyed by block position and saved with the world.
Furnaces keep working while their chunk is loaded and swap to the glowing block while burning.
##
變數 背 = 0;
變數 物 = 0;
變數 方 = 0;
變數 世 = 0;
變數 箱子們 = {};
變數 熔爐們 = {};
變數 熔煉秒 = 8.0d;

變數 初始化 = 函式(背包模組, 物品模組, 方塊模組, 世界模組) {
    背 = 背包模組; 物 = 物品模組; 方 = 方塊模組; 世 = 世界模組;
    箱子們 = {}; 熔爐們 = {};
};

變數 鍵 = 函式(x, y, z) { 回傳 字串.轉文字(x) + "," + 字串.轉文字(y) + "," + 字串.轉文字(z); };

變數 取箱子 = 函式(x, y, z) {
    變數 k = 鍵(x, y, z);
    如果 (!雜湊.包含鍵(箱子們, k)) { 箱子們[k] = 背.新格位(27); }
    回傳 箱子們[k];
};

變數 取熔爐 = 函式(x, y, z) {
    變數 k = 鍵(x, y, z);
    如果 (!雜湊.包含鍵(熔爐們, k)) {
        熔爐們[k] = {"x": x, "y": y, "z": z, "格": 背.新格位(3), "燒": 0.0d, "燒滿": 0.0d, "煉": 0.0d};
    }
    回傳 熔爐們[k];
};

# 方塊被挖掉時取出內容（之後由呼叫者丟出）。 Remove a container and return its slots for dropping.
變數 移除 = 函式(x, y, z) {
    變數 k = 鍵(x, y, z);
    變數 內容 = [];
    如果 (雜湊.包含鍵(箱子們, k)) { 內容 = 箱子們[k]; 雜湊.刪除鍵(箱子們, k); }
    如果 (雜湊.包含鍵(熔爐們, k)) { 內容 = (熔爐們[k])["格"]; 雜湊.刪除鍵(熔爐們, k); }
    回傳 內容;
};

# 能否把輸入熔成輸出。 Can the input be smelted into the output slot?
變數 可熔 = 函式(f) {
    變數 g = f["格"];
    變數 入 = g[0]; 變數 出 = g[2];
    如果 (背.是空(入)) { 回傳 假; }
    變數 結果 = 物.熔煉(入[0]);
    如果 (結果 == 0) { 回傳 假; }
    如果 (背.是空(出)) { 回傳 真; }
    回傳 出[0] == 結果 && 出[1] < 64;
};

# 每影格推進所有已載入的熔爐；方塊換成點燃或熄滅狀態時回傳真。
# Advance every loaded furnace; returns true when a block changed between lit and unlit.
變數 更新 = 函式(dt) {
    變數 改變 = 假;
    變數 全部 = 雜湊.值列表(熔爐們);
    迴圈 (變數 i = 0; i < 長度(全部); i++) {
        變數 f = 全部[i];
        變數 id = 世.取方塊(f["x"], f["y"], f["z"]);
        如果 (id >= 0 && 方.是熔爐(id)) {
            變數 g = f["格"];
            變數 能 = 可熔(f);
            如果 (f["燒"] <= 0 && 能 && !背.是空(g[1]) && 物.燃料((g[1])[0]) > 0) {
                f["燒"] = 物.燃料((g[1])[0]); f["燒滿"] = f["燒"];
                背.減少(g[1], 1);
            }
            如果 (f["燒"] > 0) {
                f["燒"] = f["燒"] - dt;
                如果 (能) {
                    f["煉"] = f["煉"] + dt;
                    如果 (f["煉"] >= 熔煉秒) {
                        f["煉"] = 0.0d;
                        變數 結果 = 物.熔煉((g[0])[0]);
                        背.減少(g[0], 1);
                        如果 (背.是空(g[2])) { 背.設定(g[2], 結果, 1, 0); } 否則 { (g[2])[1] = (g[2])[1] + 1; }
                        背.變更();
                    }
                } 否則 { f["煉"] = 0.0d; }
            } 否則 {
                f["燒"] = 0.0d;
                變數 c = f["煉"] - dt * 2.0d;
                如果 (c < 0) { c = 0.0d; }
                f["煉"] = c;
            }
            變數 應亮 = f["燒"] > 0;
            變數 現亮 = id != (方.熔爐狀態(id, 假));
            如果 (應亮 != 現亮) {
                世.設方塊(f["x"], f["y"], f["z"], 方.熔爐狀態(id, 應亮));
                改變 = 真;
            }
        }
    }
    回傳 改變;
};

# ---------- 存檔 Serialisation ----------
變數 匯出 = 函式() {
    變數 箱 = {};
    變數 k1 = 雜湊.鍵列表(箱子們);
    迴圈 (變數 i = 0; i < 長度(k1); i++) { 箱[k1[i]] = 背.匯出(箱子們[k1[i]]); }
    變數 爐 = {};
    變數 k2 = 雜湊.鍵列表(熔爐們);
    迴圈 (變數 i = 0; i < 長度(k2); i++) {
        變數 f = 熔爐們[k2[i]];
        爐[k2[i]] = [f["x"], f["y"], f["z"], f["燒"], f["燒滿"], f["煉"], 背.匯出(f["格"])];
    }
    回傳 {"chests": 箱, "furnaces": 爐};
};

變數 匯入 = 函式(資料) {
    箱子們 = {}; 熔爐們 = {};
    如果 (雜湊.包含鍵(資料, "chests")) {
        變數 箱 = 資料["chests"];
        變數 k1 = 雜湊.鍵列表(箱);
        迴圈 (變數 i = 0; i < 長度(k1); i++) {
            變數 slots = 背.新格位(27);
            背.匯入(slots, 箱[k1[i]]);
            箱子們[k1[i]] = slots;
        }
    }
    如果 (雜湊.包含鍵(資料, "furnaces")) {
        變數 爐 = 資料["furnaces"];
        變數 k2 = 雜湊.鍵列表(爐);
        迴圈 (變數 i = 0; i < 長度(k2); i++) {
            變數 v = 爐[k2[i]];
            變數 f = 取熔爐(v[0], v[1], v[2]);
            f["燒"] = v[3]; f["燒滿"] = v[4]; f["煉"] = v[5];
            背.匯入(f["格"], v[6]);
        }
    }
};
