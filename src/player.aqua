## 玩家控制與物理（Player controls, physics and block interaction）
AABB 0.6 x 1.8 x 0.6，眼高 1.62。逐軸掃掠碰撞、重力、跳躍、衝刺與游泳；DDA 射線選取方塊。
AABB 0.6 x 1.8 x 0.6 with eyes at 1.62. Per-axis swept collision, gravity, jumping, sprinting and
swimming; a DDA ray picks blocks within reach.
##
變數 世 = 0;
變數 方 = 0;
變數 數 = 0;
變數 半寬 = 0.3d;
變數 身高 = 1.8d;
變數 眼高 = 1.62d;
變數 觸及 = 5.0d;

變數 位置 = [0.5d, 80.0d, 0.5d];
變數 速度 = [0.0d, 0.0d, 0.0d];
變數 偏航 = 0.0d;
變數 俯仰 = 0.0d;
變數 著地 = 假;
變數 在水中 = 假;
變數 眼在水中 = 假;
變數 衝刺中 = 假;
變數 步距 = 0.0d;
變數 落地速度 = 0.0d;
變數 事件 = [];        # 本影格的音效事件 Sound events produced this frame

變數 初始化 = 函式(世界模組, 方塊模組, 數學模組) { 世 = 世界模組; 方 = 方塊模組; 數 = 數學模組; };

變數 轉動 = 函式(dyaw, dpitch) {
    偏航 = 偏航 + dyaw;
    俯仰 = 俯仰 + dpitch;
    如果 (俯仰 > 1.55d) { 俯仰 = 1.55d; }
    如果 (俯仰 < -1.55d) { 俯仰 = -1.55d; }
};

變數 設定位置 = 函式(x, y, z, yaw, pitch) {
    位置 = [x, y, z]; 速度 = [0.0d, 0.0d, 0.0d]; 偏航 = yaw; 俯仰 = pitch; 著地 = 假;
};

變數 實心 = 函式(x, y, z) {
    變數 id = 世.取方塊(x, y, z);
    如果 (id < 0) { 回傳 真; }       # 未載入區塊視為實心 Unloaded chunks are solid
    回傳 (方.實體)[id];
};

變數 取整 = 函式(v) { 變數 t = 0; t += v; 如果 (t > v) { t -= 1; } 回傳 t; };

# 檢查 AABB 是否與任何實心方塊重疊。 Does the AABB at p overlap a solid block?
變數 碰撞 = 函式(px, py, pz) {
    變數 x0 = 取整(px - 半寬 + 0.001d); 變數 x1 = 取整(px + 半寬 - 0.001d);
    變數 y0 = 取整(py + 0.001d); 變數 y1 = 取整(py + 身高 - 0.001d);
    變數 z0 = 取整(pz - 半寬 + 0.001d); 變數 z1 = 取整(pz + 半寬 - 0.001d);
    迴圈 (變數 y = y0; y <= y1; y++) {
        迴圈 (變數 z = z0; z <= z1; z++) {
            迴圈 (變數 x = x0; x <= x1; x++) {
                如果 (實心(x, y, z)) { 回傳 真; }
            }
        }
    }
    回傳 假;
};

變數 前方 = 函式() {
    變數 cp = 數.Cos(俯仰);
    回傳 [數.Sin(偏航) * cp, 數.Sin(俯仰), 數.Cos(偏航) * cp];
};

# 沿單一軸移動並在碰撞時停下。 Move along one axis, stopping at contact.
變數 移動軸 = 函式(軸, 量) {
    如果 (量 == 0) { 回傳 假; }
    變數 步數 = 1;
    變數 絕對 = 量;
    如果 (絕對 < 0) { 絕對 = -絕對; }
    如果 (絕對 > 0.25d) { 步數 = 取整(絕對 / 0.25d) + 1; }
    變數 每步 = 量 / 步數;
    迴圈 (變數 i = 0; i < 步數; i++) {
        變數 nx = 位置[0]; 變數 ny = 位置[1]; 變數 nz = 位置[2];
        如果 (軸 == 0) { nx += 每步; } 否則如果 (軸 == 1) { ny += 每步; } 否則 { nz += 每步; }
        如果 (碰撞(nx, ny, nz)) {
            # 貼齊方塊邊界。 Snap flush against the block.
            如果 (軸 == 1) {
                如果 (每步 < 0) { 位置[1] = 取整(ny) + 1.0d; } 否則 { 位置[1] = 取整(ny + 身高) - 身高 - 0.0001d; }
            } 否則如果 (軸 == 0) {
                如果 (每步 > 0) { 位置[0] = 取整(nx + 半寬) - 半寬 - 0.0001d; } 否則 { 位置[0] = 取整(nx - 半寬) + 1.0d + 半寬 + 0.0001d; }
            } 否則 {
                如果 (每步 > 0) { 位置[2] = 取整(nz + 半寬) - 半寬 - 0.0001d; } 否則 { 位置[2] = 取整(nz - 半寬) + 1.0d + 半寬 + 0.0001d; }
            }
            回傳 真;
        }
        位置[0] = nx; 位置[1] = ny; 位置[2] = nz;
    }
    回傳 假;
};

# 每影格更新。輸入：前後、左右、跳、衝刺。 Per-frame update with movement input.
變數 更新 = 函式(dt, 前後, 左右, 跳, 衝刺) {
    事件 = [];
    變數 腳 = 世.取方塊(取整(位置[0]), 取整(位置[1] + 0.4d), 取整(位置[2]));
    變數 眼 = 世.取方塊(取整(位置[0]), 取整(位置[1] + 眼高), 取整(位置[2]));
    變數 曾在水中 = 在水中;
    在水中 = 腳 == 方.水;
    眼在水中 = 眼 == 方.水;
    如果 (在水中 && !曾在水中 && 速度[1] < -4.0d) { 陣列.追加(事件, "splash"); }
    衝刺中 = 衝刺 && 前後 > 0;
    變數 速率 = 4.3d;
    如果 (衝刺中) { 速率 = 5.8d; }
    如果 (在水中) { 速率 = 2.6d; 如果 (衝刺中) { 速率 = 3.4d; } }
    變數 sy = 數.Sin(偏航); 變數 cy = 數.Cos(偏航);
    # 以偏航角將輸入轉到世界座標；右手座標系的右方是 (-cos, 0, sin)。 Right vector is (-cos, 0, sin).
    變數 wx = sy * 前後 - cy * 左右;
    變數 wz = cy * 前後 + sy * 左右;
    變數 長 = wx * wx + wz * wz;
    如果 (長 > 1.0d) { 變數 inv = 1.0d / 數.Sqrt(長); wx *= inv; wz *= inv; }
    # 地面加速快、空中控制較弱。 Responsive on the ground, gentler in the air.
    變數 控制 = 18.0d;
    如果 (!著地) { 控制 = 5.0d; }
    如果 (在水中) { 控制 = 6.0d; }
    變數 k = 控制 * dt;
    如果 (k > 1.0d) { k = 1.0d; }
    速度[0] = 速度[0] + ((wx * 速率 - 速度[0]) * k);
    速度[2] = 速度[2] + ((wz * 速率 - 速度[2]) * k);
    如果 (在水中) {
        速度[1] = 速度[1] - (9.0d * dt);
        速度[1] = 速度[1] * (1.0d - 2.5d * dt);
        如果 (跳) { 速度[1] = 速度[1] + (22.0d * dt); 如果 (速度[1] > 4.0d) { 速度[1] = 4.0d; } }
        如果 (速度[1] < -5.0d) { 速度[1] = -5.0d; }
    } 否則 {
        速度[1] = 速度[1] - (28.0d * dt);
        如果 (速度[1] < -60.0d) { 速度[1] = -60.0d; }
        如果 (跳 && 著地) { 速度[1] = 8.6d; 著地 = 假; }
    }
    變數 下落 = 速度[1];
    變數 撞y = 移動軸(1, 速度[1] * dt);
    變數 曾著地 = 著地;
    著地 = 假;
    如果 (撞y) {
        如果 (速度[1] < 0) { 著地 = 真; }
        速度[1] = 0.0d;
    }
    如果 (著地 && !曾著地 && 下落 < -9.0d) { 陣列.追加(事件, "land"); }
    # 記錄落地速度供摔落傷害使用；落入水中不算。 Landing speed for fall damage (not into water).
    如果 (著地 && !曾著地 && !在水中) { 落地速度 = 下落; }
    如果 (在水中) { 落地速度 = 0.0d; }
    如果 (移動軸(0, 速度[0] * dt)) { 速度[0] = 0.0d; }
    如果 (移動軸(2, 速度[2] * dt)) { 速度[2] = 0.0d; }
    # 腳步聲。 Footsteps by distance travelled on the ground.
    如果 (著地) {
        步距 += 數.Sqrt(速度[0] * 速度[0] + 速度[2] * 速度[2]) * dt;
        如果 (步距 > 1.9d) { 步距 = 0.0d; 陣列.追加(事件, "step"); }
    }
    # 掉出世界時回到上方。 Recover if the player falls out of the world.
    如果 (位置[1] < -20) { 位置[1] = 140.0d; 速度[1] = 0.0d; }
};

# 擊退。 Knockback.
變數 擊退 = 函式(kx, kz, 力) { 速度[0] = kx * 力; 速度[2] = kz * 力; 速度[1] = 5.0d; 著地 = 假; };
變數 取落地速度 = 函式() { 變數 v = 落地速度; 落地速度 = 0.0d; 回傳 v; };

變數 腳下方塊 = 函式() { 回傳 世.取方塊(取整(位置[0]), 取整(位置[1] - 0.2d), 取整(位置[2])); };

變數 眼睛 = 函式() { 回傳 [位置[0], 位置[1] + 眼高, 位置[2]]; };

# DDA 射線：回傳 [命中?, x, y, z, 前一格 x, y, z]。 Amanatides-Woo traversal within reach.
變數 射線 = 函式() {
    變數 o = 眼睛();
    變數 d = 前方();
    變數 x = 取整(o[0]); 變數 y = 取整(o[1]); 變數 z = 取整(o[2]);
    變數 px = x; 變數 py = y; 變數 pz = z;
    變數 sx = 1; 變數 sy = 1; 變數 sz = 1;
    如果 (d[0] < 0) { sx = -1; } 如果 (d[1] < 0) { sy = -1; } 如果 (d[2] < 0) { sz = -1; }
    變數 大 = 1000000.0d;
    變數 tdx = 大; 變數 tdy = 大; 變數 tdz = 大;
    如果 (d[0] != 0) { tdx = sx / d[0]; } 如果 (d[1] != 0) { tdy = sy / d[1]; } 如果 (d[2] != 0) { tdz = sz / d[2]; }
    變數 tmx = 大; 變數 tmy = 大; 變數 tmz = 大;
    如果 (d[0] > 0) { tmx = (x + 1 - o[0]) / d[0]; } 否則如果 (d[0] < 0) { tmx = (o[0] - x) / -d[0]; }
    如果 (d[1] > 0) { tmy = (y + 1 - o[1]) / d[1]; } 否則如果 (d[1] < 0) { tmy = (o[1] - y) / -d[1]; }
    如果 (d[2] > 0) { tmz = (z + 1 - o[2]) / d[2]; } 否則如果 (d[2] < 0) { tmz = (o[2] - z) / -d[2]; }
    變數 t = 0.0d;
    迴圈 (變數 i = 0; i < 64 && t <= 觸及; i++) {
        變數 id = 世.取方塊(x, y, z);
        如果 (id > 0 && id != 方.水) { 回傳 [真, x, y, z, px, py, pz]; }
        px = x; py = y; pz = z;
        如果 (tmx < tmy && tmx < tmz) { x += sx; t = tmx; tmx += tdx; }
        否則如果 (tmy < tmz) { y += sy; t = tmy; tmy += tdy; }
        否則 { z += sz; t = tmz; tmz += tdz; }
    }
    回傳 [假, 0, 0, 0, 0, 0, 0];
};

# 放置的方塊是否會卡住玩家。 Would a block at (x,y,z) intersect the player?
變數 佔據 = 函式(x, y, z) {
    回傳 x + 1 > 位置[0] - 半寬 && x < 位置[0] + 半寬 && z + 1 > 位置[2] - 半寬 && z < 位置[2] + 半寬 && y + 1 > 位置[1] && y < 位置[1] + 身高;
};
