## 背包（Inventory）：0..8 為快捷列，9..35 為背包；另有游標上的「手持」堆疊。
所有格位都是固定的 [編號, 數量, 耐久損耗] 陣列，操作時原地修改，避免別名造成數量不一致。
Slots 0..8 are the hotbar and 9..35 the backpack, plus the stack held on the cursor. Every slot is a
fixed [id, count, damage] array that is modified in place, so counts never fork through aliases.
同一組函式也用於箱子、合成格與熔爐（傳入任意格位陣列）。
The same functions work on chests, crafting grids and furnaces (any array of slots).
##
變數 物 = 0;
變數 格 = [];
變數 手持 = [0, 0, 0];
變數 版本 = 0;            # 內容改變時遞增，讓介面知道要重建 Bumped on every change so the UI can redraw

變數 新格位 = 函式(n) {
    變數 a = [];
    迴圈 (變數 i = 0; i < n; i++) { 陣列.追加(a, [0, 0, 0]); }
    回傳 a;
};

變數 初始化 = 函式(物品模組) {
    物 = 物品模組;
    格 = 新格位(36);
    手持 = [0, 0, 0];
    版本 = 0;
};

變數 變更 = 函式() { 版本 = 版本 + 1; };
變數 是空 = 函式(s) { 回傳 s[0] == 0 || s[1] <= 0; };
變數 清空 = 函式(s) { s[0] = 0; s[1] = 0; s[2] = 0; };
變數 設定 = 函式(s, id, n, d) {
    如果 (n <= 0 || id == 0) { 清空(s); 回傳 0; }
    s[0] = id; s[1] = n; s[2] = d;
    回傳 0;
};
變數 複製到 = 函式(目的, 來源) { 目的[0] = 來源[0]; 目的[1] = 來源[1]; 目的[2] = 來源[2]; };
變數 交換內容 = 函式(a, b) {
    變數 t0 = a[0]; 變數 t1 = a[1]; 變數 t2 = a[2];
    a[0] = b[0]; a[1] = b[1]; a[2] = b[2];
    b[0] = t0; b[1] = t1; b[2] = t2;
};
變數 可疊 = 函式(a, b) { 回傳 a[0] == b[0] && a[2] == b[2] && 物.最大堆疊(a[0]) > 1; };
變數 上限 = 函式(s) { 回傳 物.最大堆疊(s[0]); };

# 放入任意格位範圍：先疊到相同物品，再放空格；回傳剩餘數量。
# Insert into a slot range: merge into matching stacks first, then empty slots; returns the leftover.
變數 放入範圍 = 函式(陣, id, n, d, 起, 迄) {
    如果 (n <= 0 || id == 0) { 回傳 0; }
    變數 剩 = n;
    變數 最大 = 物.最大堆疊(id);
    如果 (最大 > 1) {
        迴圈 (變數 i = 起; i < 迄 && 剩 > 0; i++) {
            變數 s = 陣[i];
            如果 (s[0] == id && s[2] == d && s[1] < 最大) {
                變數 可 = 最大 - s[1];
                如果 (可 > 剩) { 可 = 剩; }
                s[1] = s[1] + 可; 剩 -= 可;
            }
        }
    }
    迴圈 (變數 i = 起; i < 迄 && 剩 > 0; i++) {
        變數 s = 陣[i];
        如果 (是空(s)) {
            變數 可 = 最大;
            如果 (可 > 剩) { 可 = 剩; }
            設定(s, id, 可, d); 剩 -= 可;
        }
    }
    如果 (剩 != n) { 變更(); }
    回傳 剩;
};

# 撿起物品：快捷列優先。 Pick up into the player inventory, hotbar first.
變數 加入 = 函式(id, n, d) { 回傳 放入範圍(格, id, n, d, 0, 36); };

變數 可容納 = 函式(id, n, d) {
    變數 剩 = n;
    變數 最大 = 物.最大堆疊(id);
    迴圈 (變數 i = 0; i < 36 && 剩 > 0; i++) {
        變數 s = 格[i];
        如果 (是空(s)) { 剩 -= 最大; } 否則如果 (s[0] == id && s[2] == d && 最大 > 1) { 剩 -= 最大 - s[1]; }
    }
    回傳 剩 <= 0;
};

變數 計數陣列 = 函式(陣, id) {
    變數 n = 0;
    迴圈 (變數 i = 0; i < 長度(陣); i++) { 如果 ((陣[i])[0] == id) { n += (陣[i])[1]; } }
    回傳 n;
};
變數 計數 = 函式(id) { 回傳 計數陣列(格, id); };

# 從背包取走 n 個（背包區優先，再快捷列）；回傳實際取得數。 Take n items, backpack first.
變數 取走 = 函式(id, n) {
    變數 剩 = n;
    迴圈 (變數 pass = 0; pass < 2; pass++) {
        變數 起 = 9; 變數 迄 = 36;
        如果 (pass == 1) { 起 = 0; 迄 = 9; }
        迴圈 (變數 i = 迄 - 1; i >= 起 && 剩 > 0; i -= 1) {
            變數 s = 格[i];
            如果 (s[0] == id && s[1] > 0) {
                變數 k = s[1];
                如果 (k > 剩) { k = 剩; }
                s[1] = s[1] - k; 剩 -= k;
                如果 (s[1] <= 0) { 清空(s); }
            }
        }
    }
    如果 (剩 != n) { 變更(); }
    回傳 n - 剩;
};

# 從某格移除 n 個。 Remove n items from one slot.
變數 減少 = 函式(s, n) {
    s[1] = s[1] - n;
    如果 (s[1] <= 0) { 清空(s); }
    變更();
};

# ---------- 游標操作 Cursor operations ----------
# 左鍵：拿起整疊、放下、合併或交換。 Left click: pick up, place, merge or swap.
變數 左鍵 = 函式(陣, i) {
    變數 s = 陣[i];
    變數 h = 手持;
    如果 (是空(h)) {
        如果 (!是空(s)) { 複製到(h, s); 清空(s); }
    } 否則如果 (是空(s)) {
        複製到(s, h); 清空(h);
    } 否則如果 (可疊(s, h)) {
        變數 可 = 上限(s) - s[1];
        如果 (可 > h[1]) { 可 = h[1]; }
        s[1] = s[1] + 可; h[1] = h[1] - 可;
        如果 (h[1] <= 0) { 清空(h); }
    } 否則 {
        交換內容(s, h);
    }
    變更();
};

# 右鍵：游標空時拿一半，否則放一個。 Right click: take half, or place one.
變數 右鍵 = 函式(陣, i) {
    變數 s = 陣[i];
    變數 h = 手持;
    如果 (是空(h)) {
        如果 (!是空(s)) {
            變數 一半 = (s[1] + 1) / 2;
            設定(h, s[0], 一半, s[2]);
            s[1] = s[1] - 一半;
            如果 (s[1] <= 0) { 清空(s); }
            變更();
        }
        回傳 0;
    }
    回傳 放一個(陣, i);
};

# 放一個到格位（右鍵拖曳分配）；回傳是否放入。 Drop one item into a slot (right-drag spreading).
變數 放一個 = 函式(陣, i) {
    變數 s = 陣[i];
    變數 h = 手持;
    如果 (是空(h)) { 回傳 假; }
    如果 (是空(s)) {
        設定(s, h[0], 1, h[2]);
    } 否則如果 (可疊(s, h) && s[1] < 上限(s)) {
        s[1] = s[1] + 1;
    } 否則 {
        回傳 假;
    }
    h[1] = h[1] - 1;
    如果 (h[1] <= 0) { 清空(h); }
    變更();
    回傳 真;
};

# 把一格整疊移到另一個陣列的範圍（Shift 點擊）。 Shift-click transfer into a slot range.
變數 快速移動 = 函式(來源陣, i, 目標陣, 起, 迄) {
    變數 s = 來源陣[i];
    如果 (是空(s)) { 回傳 0; }
    變數 剩 = 放入範圍(目標陣, s[0], s[1], s[2], 起, 迄);
    變數 移動 = s[1] - 剩;
    如果 (剩 <= 0) { 清空(s); } 否則 { s[1] = 剩; }
    變更();
    回傳 移動;
};

# 數字鍵：與快捷列交換。 Number key over a slot: swap with that hotbar slot.
變數 與快捷列交換 = 函式(陣, i, 快捷) {
    交換內容(陣[i], 格[快捷]);
    變更();
};

# 工具耗損；耗盡時清空並回傳真。 Wear a tool; returns true if it broke.
變數 磨損 = 函式(s, 量) {
    如果 (!物.是工具(s[0])) { 回傳 假; }
    s[2] = s[2] + 量;
    變更();
    如果 (s[2] >= 物.耐久(s[0])) { 清空(s); 回傳 真; }
    回傳 假;
};

# ---------- 存檔 Serialisation ----------
變數 匯出 = 函式(陣) {
    變數 out = [];
    迴圈 (變數 i = 0; i < 長度(陣); i++) {
        變數 s = 陣[i];
        陣列.追加(out, s[0]); 陣列.追加(out, s[1]); 陣列.追加(out, s[2]);
    }
    回傳 out;
};

變數 匯入 = 函式(陣, 清單) {
    迴圈 (變數 i = 0; i < 長度(陣); i++) {
        如果 (i * 3 + 2 < 長度(清單)) {
            變數 id = 清單[i * 3];
            如果 (物.有效(id)) { 設定(陣[i], id, 清單[i * 3 + 1], 清單[i * 3 + 2]); } 否則 { 清空(陣[i]); }
        } 否則 { 清空(陣[i]); }
    }
    變更();
};

變數 全部清空 = 函式() {
    迴圈 (變數 i = 0; i < 36; i++) { 清空(格[i]); }
    清空(手持);
    變更();
};
