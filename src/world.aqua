## 區塊世界（Chunk world）
區塊為 16x16x128；以玩家為中心產生、網格化並卸載。玩家修改另外記錄，重新產生時套用並可存檔。
Chunks are 16x16x128, generated, meshed and unloaded around the player. Player edits are kept
separately, re-applied when a chunk regenerates, and saved.
##
變數 生 = 0;
變數 方 = 0;
變數 雜 = 0;
變數 高度 = 128;
變數 區塊表 = {};
變數 修改 = {};           # 區塊鍵 -> {區域索引: 方塊}  chunk key -> {local index: id}
變數 修改數 = 0;
變數 已修改 = 假;
變數 冪 = [1, 64, 4096, 262144];
變數 光源 = {};           # 位置鍵 -> [x, y, z, 等級]（火把、燃燒中的熔爐） Light emitters placed by the player

變數 位置鍵 = 函式(x, y, z) { 回傳 字串.轉文字(x) + "," + 字串.轉文字(y) + "," + 字串.轉文字(z); };

# 更新光源表。 Keep the emitter table in sync with a block change.
變數 記錄光源 = 函式(x, y, z, id) {
    變數 k = 位置鍵(x, y, z);
    如果 ((方.發光)[id] > 0) { 光源[k] = [x, y, z, (方.發光)[id]]; }
    否則如果 (雜湊.包含鍵(光源, k)) { 雜湊.刪除鍵(光源, k); }
};

# 回傳最近的光源（扁平陣列 x,y,z,等級），最多 上限 個。 Nearest emitters as a flat list.
變數 附近光源 = 函式(px, py, pz, 半徑, 上限) {
    變數 候選 = [];
    變數 距離 = [];
    變數 全部 = 雜湊.值列表(光源);
    迴圈 (變數 i = 0; i < 長度(全部); i++) {
        變數 L = 全部[i];
        變數 dx = L[0] + 0.5d - px; 變數 dy = L[1] + 0.5d - py; 變數 dz = L[2] + 0.5d - pz;
        變數 d = dx * dx + dy * dy + dz * dz;
        如果 (d < 半徑 * 半徑) { 陣列.追加(候選, L); 陣列.追加(距離, d); }
    }
    變數 結果 = [];
    迴圈 (變數 n = 0; n < 上限 && n < 長度(候選); n++) {
        變數 最佳 = -1; 變數 最佳d = 1000000000.0d;
        迴圈 (變數 i = 0; i < 長度(候選); i++) { 如果 (距離[i] < 最佳d) { 最佳d = 距離[i]; 最佳 = i; } }
        如果 (最佳 < 0) { 中斷; }
        變數 L = 候選[最佳];
        陣列.追加(結果, L[0]); 陣列.追加(結果, L[1]); 陣列.追加(結果, L[2]); 陣列.追加(結果, L[3]);
        距離[最佳] = 2000000000.0d;
    }
    回傳 結果;
};

變數 初始化 = 函式(生成模組, 方塊模組, 雜訊模組) {
    生 = 生成模組; 方 = 方塊模組; 雜 = 雜訊模組;
    區塊表 = {};
};

變數 鍵 = 函式(cx, cz) { 回傳 (cx + 20000) * 40000 + (cz + 20000); };
變數 有區塊 = 函式(cx, cz) { 回傳 雜湊.包含鍵(區塊表, 鍵(cx, cz)); };
變數 取區塊 = 函式(cx, cz) { 回傳 區塊表[鍵(cx, cz)]; };

# 從壓縮資料讀一格（區域座標）。 Read one id from packed data (local coordinates).
變數 讀壓 = 函式(資料, x, y, z) {
    變數 i = (y * 16 + z) * 16 + x;
    變數 n = i % 4;
    回傳 (資料[(i - n) / 4] / 冪[n]) % 64;
};

變數 取方塊 = 函式(x, y, z) {
    如果 (y < 0 || y >= 高度) { 回傳 0; }
    變數 cx = 雜.地板除(x, 16);
    變數 cz = 雜.地板除(z, 16);
    變數 k = (cx + 20000) * 40000 + (cz + 20000);
    如果 (!雜湊.包含鍵(區塊表, k)) { 回傳 -1; }
    回傳 讀壓(區塊表[k]["資料"], x - cx * 16, y, z - cz * 16);
};

變數 計算欄高 = 函式(資料, 高圖, x, z) {
    變數 top = 0;
    迴圈 (變數 y = 高度 - 1; y >= 0; y -= 1) {
        如果 ((方.種類)[讀壓(資料, x, y, z)] == 1) { top = y + 1; 中斷; }
    }
    高圖[z * 16 + x] = top;
};

變數 產生區塊 = 函式(cx, cz) {
    變數 原始 = 生.產生原始(cx, cz);
    變數 k = 鍵(cx, cz);
    如果 (雜湊.包含鍵(修改, k)) {
        變數 改 = 修改[k];
        變數 索引們 = 雜湊.鍵列表(改);
        迴圈 (變數 i = 0; i < 長度(索引們); i++) { 原始[索引們[i]] = 改[索引們[i]]; }
    }
    變數 最高 = 0;
    變數 高圖 = 陣列.建立(256, 0);
    迴圈 (變數 z = 0; z < 16; z++) {
        迴圈 (變數 x = 0; x < 16; x++) {
            迴圈 (變數 y = 高度 - 1; y > 0; y -= 1) {
                變數 id = 原始[(y * 16 + z) * 16 + x];
                如果 (id != 0) {
                    如果 (y > 最高) { 最高 = y; }
                    如果 ((方.種類)[id] == 1) { 高圖[z * 16 + x] = y + 1; 中斷; }
                }
            }
        }
    }
    變數 c = {"cx": cx, "cz": cz, "資料": 生.壓縮(原始), "高": 高圖, "最高": 最高, "網格": 假, "髒": 真,
        "緩衝": 0, "不透明": 0, "半透明": 0, "數": 0};
    區塊表[k] = c;
    回傳 c;
};

變數 標記髒 = 函式(cx, cz) {
    如果 (有區塊(cx, cz)) { 取區塊(cx, cz)["髒"] = 真; }
};

# 設定方塊並記錄修改；回傳舊方塊。 Set a block, record the edit and return the old id.
變數 設方塊 = 函式(x, y, z, id) {
    如果 (y < 0 || y >= 高度) { 回傳 -1; }
    變數 cx = 雜.地板除(x, 16);
    變數 cz = 雜.地板除(z, 16);
    如果 (!有區塊(cx, cz)) { 回傳 -1; }
    變數 c = 取區塊(cx, cz);
    變數 lx = x - cx * 16;
    變數 lz = z - cz * 16;
    變數 i = (y * 16 + lz) * 16 + lx;
    變數 n = i % 4;
    變數 j = (i - n) / 4;
    變數 資料 = c["資料"];
    變數 舊 = (資料[j] / 冪[n]) % 64;
    如果 (舊 == id) { 回傳 舊; }
    資料[j] = 資料[j] + (id - 舊) * 冪[n];
    計算欄高(資料, c["高"], lx, lz);
    如果 (id != 0 && y > c["最高"]) { c["最高"] = y; }
    變數 k = 鍵(cx, cz);
    如果 (!雜湊.包含鍵(修改, k)) { 修改[k] = {}; }
    變數 表 = 修改[k];
    表[i] = id;
    修改數++;
    記錄光源(x, y, z, id);
    已修改 = 真;
    c["髒"] = 真;
    # 邊界與角落的鄰居也要重建（環境光遮蔽與天光）。 Neighbours share AO and light at borders.
    迴圈 (變數 dz = -1; dz <= 1; dz++) {
        迴圈 (變數 dx = -1; dx <= 1; dx++) {
            變數 靠x = (dx == 0) || (dx == -1 && lx == 0) || (dx == 1 && lx == 15);
            變數 靠z = (dz == 0) || (dz == -1 && lz == 0) || (dz == 1 && lz == 15);
            如果 (靠x && 靠z && (dx != 0 || dz != 0)) { 標記髒(cx + dx, cz + dz); }
        }
    }
    回傳 舊;
};

# 建立 18x18x130 的填充方塊陣列與 18x18 欄高，給網格化使用；鄰居必須已產生。
# Padded 18x18x130 ids and 18x18 column heights for meshing; all eight neighbours must exist.
變數 填充 = 函式(cx, cz) {
    變數 c = 取區塊(cx, cz);
    變數 P = 陣列.建立(18 * 18 * 130, 0);
    變數 H = 陣列.建立(324, 0);
    # y=-1 視為石頭，避免輸出世界底部的面。 Treat y=-1 as stone so the world floor has no faces.
    迴圈 (變數 i = 0; i < 324; i++) { P[i] = 3; }
    變數 原始 = 生.解壓(c["資料"]);
    變數 高圖 = c["高"];
    迴圈 (變數 y = 0; y < 高度; y++) {
        迴圈 (變數 z = 0; z < 16; z++) {
            變數 src = (y * 16 + z) * 16;
            變數 dst = ((y + 1) * 18 + z + 1) * 18 + 1;
            迴圈 (變數 x = 0; x < 16; x++) { P[dst + x] = 原始[src + x]; }
        }
    }
    迴圈 (變數 z = 0; z < 16; z++) { 迴圈 (變數 x = 0; x < 16; x++) { H[(z + 1) * 18 + x + 1] = 高圖[z * 16 + x]; } }
    # 邊框：從八個鄰居讀取。 Border cells from the eight neighbours.
    迴圈 (變數 pz = 0; pz < 18; pz++) {
        迴圈 (變數 px = 0; px < 18; px++) {
            如果 (px == 0 || px == 17 || pz == 0 || pz == 17) {
                變數 wx = px - 1;
                變數 wz = pz - 1;
                變數 ncx = cx; 變數 ncz = cz;
                如果 (wx < 0) { ncx = cx - 1; wx += 16; } 否則如果 (wx > 15) { ncx = cx + 1; wx -= 16; }
                如果 (wz < 0) { ncz = cz - 1; wz += 16; } 否則如果 (wz > 15) { ncz = cz + 1; wz -= 16; }
                如果 (有區塊(ncx, ncz)) {
                    變數 n = 取區塊(ncx, ncz);
                    變數 nd = n["資料"];
                    H[pz * 18 + px] = n["高"][wz * 16 + wx];
                    變數 top = n["最高"];
                    迴圈 (變數 y = 0; y <= top; y++) { P[((y + 1) * 18 + pz) * 18 + px] = 讀壓(nd, wx, y, wz); }
                }
            }
        }
    }
    回傳 [P, H];
};

變數 修改清單 = 函式() {
    變數 結果 = 陣列.建立(0, 0, 修改數 * 3 + 16);
    變數 鍵們 = 雜湊.鍵列表(修改);
    迴圈 (變數 i = 0; i < 長度(鍵們); i++) {
        變數 表 = 修改[鍵們[i]];
        變數 格 = 雜湊.鍵列表(表);
        迴圈 (變數 j = 0; j < 長度(格); j++) {
            陣列.追加(結果, 鍵們[i]); 陣列.追加(結果, 格[j]); 陣列.追加(結果, 表[格[j]]);
        }
    }
    回傳 結果;
};

變數 載入修改 = 函式(清單) {
    修改 = {}; 修改數 = 0; 光源 = {};
    迴圈 (變數 i = 0; i + 2 < 長度(清單); i += 3) {
        變數 k = 清單[i];
        如果 (!雜湊.包含鍵(修改, k)) { 修改[k] = {}; }
        變數 表 = 修改[k];
        變數 索 = 清單[i + 1];
        表[索] = 清單[i + 2];
        修改數++;
        # 由區塊鍵與區域索引還原世界座標。 Recover world coordinates from the chunk key and local index.
        如果 ((方.發光)[清單[i + 2]] > 0) {
            變數 cx = k / 40000 - 20000; 變數 cz = k % 40000 - 20000;
            變數 lx = 索 % 16; 變數 lz = (索 / 16) % 16; 變數 ly = 索 / 256;
            記錄光源(cx * 16 + lx, ly, cz * 16 + lz, 清單[i + 2]);
        }
    }
};

變數 清空 = 函式() { 區塊表 = {}; };
變數 全部區塊 = 函式() { 回傳 雜湊.值列表(區塊表); };
變數 移除區塊 = 函式(c) { 雜湊.刪除鍵(區塊表, 鍵(c["cx"], c["cz"])); };

變數 清除修改旗標 = 函式() { 已修改 = 假; };
