## 夜晚怪物「影獸」（Night creatures, "shades"）
夜裡在附近沒有光源的地面生成，追逐並攻擊玩家；不會破壞方塊，所以牆與屋頂能擋住牠們。
天亮時在陽光下燃燒消失。擊敗後掉落煤炭。
Shades spawn at night on unlit ground near the player, chase and strike, but never break blocks, so a
walled shelter keeps them out. They burn away in daylight and drop coal when defeated.
每隻 [x, y, z, vx, vy, vz, 生命, 攻擊冷卻, 受擊閃, 朝向x, 著地, 年齡, 燃燒, 朝向z]
##
變數 世 = 0;
變數 方 = 0;
變數 數 = 0;
變數 怪們 = [];
變數 種子 = 991.0d;
變數 生成計時 = 2.0d;
變數 半寬 = 0.3d;
變數 身高 = 1.7d;
變數 最多 = 5;
變數 事件 = [];      # ["hit", 傷害, dx, dz] 等事件，由主程式處理 Events for the main loop

變數 初始化 = 函式(世界模組, 方塊模組, 數學模組) { 世 = 世界模組; 方 = 方塊模組; 數 = 數學模組; 怪們 = []; };

變數 亂數 = 函式() { 種子 = (種子 * 16807.0d) % 2147483647.0d; 回傳 種子 / 2147483647.0d; };
變數 取整 = 函式(v) { 變數 t = 0; t += v; 如果 (t > v) { t -= 1; } 回傳 t; };

變數 實心 = 函式(x, y, z) {
    變數 id = 世.取方塊(x, y, z);
    如果 (id < 0) { 回傳 真; }
    回傳 (方.實體)[id];
};

變數 碰撞 = 函式(px, py, pz) {
    變數 x0 = 取整(px - 半寬 + 0.001d); 變數 x1 = 取整(px + 半寬 - 0.001d);
    變數 y0 = 取整(py + 0.001d); 變數 y1 = 取整(py + 身高 - 0.001d);
    變數 z0 = 取整(pz - 半寬 + 0.001d); 變數 z1 = 取整(pz + 半寬 - 0.001d);
    迴圈 (變數 y = y0; y <= y1; y++) { 迴圈 (變數 z = z0; z <= z1; z++) { 迴圈 (變數 x = x0; x <= x1; x++) {
        如果 (實心(x, y, z)) { 回傳 真; }
    } } }
    回傳 假;
};

# 找出某欄可站立的地面高度；找不到回傳 -1。 Standing height of a column, or -1.
變數 地面 = 函式(x, z) {
    迴圈 (變數 y = 110; y > 2; y -= 1) {
        變數 id = 世.取方塊(x, y, z);
        如果 (id < 0) { 回傳 -1; }
        如果 (id != 0) {
            如果 (id == 方.水 || id == 方.樹葉 || (方.實體)[id] == 假) { 回傳 -1; }
            如果 (世.取方塊(x, y + 1, z) == 0 && 世.取方塊(x, y + 2, z) == 0) { 回傳 y + 1; }
            回傳 -1;
        }
    }
    回傳 -1;
};

# 嘗試在玩家附近生成。 Try to spawn one near the player.
變數 嘗試生成 = 函式(px, py, pz) {
    變數 角 = 亂數() * 6.2831853d;
    變數 距 = 18.0d + 亂數() * 18.0d;
    變數 x = 取整(px + 數.Cos(角) * 距); 變數 z = 取整(pz + 數.Sin(角) * 距);
    變數 y = 地面(x, z);
    如果 (y < 0) { 回傳 假; }
    如果 (y > py + 20 || y < py - 20) { 回傳 假; }
    # 光源附近不生成。 No spawning near light.
    如果 (長度(世.附近光源(x + 0.5d, y + 0.5d, z + 0.5d, 10.0d, 1)) > 0) { 回傳 假; }
    陣列.追加(怪們, [x + 0.5d, y * 1.0d, z + 0.5d, 0.0d, 0.0d, 0.0d, 12, 1.0d, 0.0d, 0.0d, 假, 0.0d, 0.0d, 1.0d]);
    回傳 真;
};

變數 移動軸 = 函式(m, 軸, 量) {
    如果 (量 == 0) { 回傳 假; }
    變數 nx = m[0]; 變數 ny = m[1]; 變數 nz = m[2];
    如果 (軸 == 0) { nx += 量; } 否則如果 (軸 == 1) { ny += 量; } 否則 { nz += 量; }
    如果 (碰撞(nx, ny, nz)) {
        如果 (軸 == 1 && 量 < 0) { m[1] = 取整(ny) + 1.0d; }
        回傳 真;
    }
    m[0] = nx; m[1] = ny; m[2] = nz;
    回傳 假;
};

# 每影格更新。夜 0..1、白天 0..1；玩家腳座標。 Per-frame update.
變數 更新 = 函式(dt, 夜, 白天, 玩家腳, 和平) {
    事件 = [];
    變數 px = 玩家腳[0]; 變數 py = 玩家腳[1]; 變數 pz = 玩家腳[2];
    生成計時 -= dt;
    如果 (生成計時 <= 0) {
        生成計時 = 4.0d + 亂數() * 3.0d;
        如果 (!和平 && 夜 > 0.6d && 長度(怪們) < 最多) {
            # 多試幾個位置（森林與水面常常不適合）。 Several tries: forests and water often reject a spot.
            變數 成 = 假;
            迴圈 (變數 t = 0; t < 10 && !成; t++) { 成 = 嘗試生成(px, py, pz); }
        }
    }
    變數 留 = [];
    迴圈 (變數 i = 0; i < 長度(怪們); i++) {
        變數 m = 怪們[i];
        m[11] = m[11] + dt;
        m[7] = m[7] - dt;
        m[8] = m[8] - dt;
        變數 dx = px - m[0]; 變數 dz = pz - m[2]; 變數 dy = py - m[1];
        變數 dist = 數.Sqrt(dx * dx + dz * dz) + 0.0001d;
        # 追逐。 Chase.
        變數 wx = 0.0d; 變數 wz = 0.0d;
        如果 (dist < 28.0d && dist > 0.9d) { wx = dx / dist * 2.4d; wz = dz / dist * 2.4d; }
        如果 (dist < 28.0d) {
            # 朝向玩家，供著色器畫出眼睛的那一面。 Face the player; the shader draws the eyes on that side.
            m[9] = dx / dist; m[13] = dz / dist;
        }
        變數 k = 8.0d * dt; 如果 (k > 1) { k = 1.0d; }
        m[3] = m[3] + (wx - m[3]) * k;
        m[5] = m[5] + (wz - m[5]) * k;
        m[4] = m[4] - 24.0d * dt;
        如果 (m[4] < -40) { m[4] = -40.0d; }
        變數 撞y = 移動軸(m, 1, m[4] * dt);
        如果 (撞y) { 如果 (m[4] < 0) { m[10] = 真; } m[4] = 0.0d; } 否則 { m[10] = 假; }
        變數 撞x = 移動軸(m, 0, m[3] * dt);
        變數 撞z = 移動軸(m, 2, m[5] * dt);
        如果 ((撞x || 撞z) && m[10]) { m[4] = 7.6d; m[10] = 假; }
        # 攻擊。 Strike when close.
        如果 (dist < 1.1d && dy > -1.6d && dy < 1.6d && m[7] <= 0) {
            m[7] = 1.1d;
            陣列.追加(事件, ["hit", 2, dx / dist, dz / dist]);
        }
        # 陽光下燃燒。 Burn in daylight when the sky is open above.
        如果 (白天 > 0.55d) {
            m[12] = m[12] + dt;
            如果 (m[12] > 1.0d) { m[12] = 0.0d; m[6] = m[6] - 3; m[8] = 0.25d; }
        }
        如果 (m[6] <= 0) {
            陣列.追加(事件, ["die", m[0], m[1], m[2]]);
        } 否則如果 (dist < 80.0d && m[1] > -10) {
            陣列.追加(留, m);
        }
    }
    怪們 = 留;
};

# 射線與怪物的交點距離（找不到回傳 -1）及索引。 Ray vs creature boxes: [distance, index].
變數 射線命中 = 函式(o, d, 最遠) {
    變數 最佳 = 最遠; 變數 索 = -1;
    迴圈 (變數 i = 0; i < 長度(怪們); i++) {
        變數 m = 怪們[i];
        變數 mn = [m[0] - 半寬 - 0.1d, m[1], m[2] - 半寬 - 0.1d];
        變數 mx = [m[0] + 半寬 + 0.1d, m[1] + 身高, m[2] + 半寬 + 0.1d];
        變數 t0 = 0.0d; 變數 t1 = 最遠; 變數 好 = 真;
        迴圈 (變數 a = 0; a < 3; a++) {
            如果 (d[a] > -0.00001d && d[a] < 0.00001d) {
                如果 (o[a] < mn[a] || o[a] > mx[a]) { 好 = 假; }
            } 否則 {
                變數 ta = (mn[a] - o[a]) / d[a]; 變數 tb = (mx[a] - o[a]) / d[a];
                如果 (ta > tb) { 變數 tt = ta; ta = tb; tb = tt; }
                如果 (ta > t0) { t0 = ta; }
                如果 (tb < t1) { t1 = tb; }
            }
        }
        如果 (好 && t0 <= t1 && t0 < 最佳) { 最佳 = t0; 索 = i; }
    }
    回傳 [最佳, 索];
};

# 玩家攻擊。 The player hits creature i.
變數 受擊 = 函式(i, 傷害, kx, kz) {
    如果 (i < 0 || i >= 長度(怪們)) { 回傳 假; }
    變數 m = 怪們[i];
    m[6] = m[6] - 傷害;
    m[8] = 0.3d;
    m[3] = kx * 7.0d; m[5] = kz * 7.0d; m[4] = 5.0d; m[10] = 假;
    回傳 m[6] <= 0;
};

變數 數量 = 函式() { 回傳 長度(怪們); };

變數 繪製資料 = 函式(out) {
    迴圈 (變數 i = 0; i < 長度(怪們); i++) {
        變數 m = 怪們[i];
        變數 閃 = 0.0d; 如果 (m[8] > 0) { 閃 = 1.0d; }
        # 走動時才擺動。 Bob only while moving.
        變數 走 = 0.0d; 如果 (m[3] * m[3] + m[5] * m[5] > 0.5d) { 走 = m[11]; }
        陣列.追加陣列(out, [m[0], m[1], m[2], 1.0d, 0, 4, m[9], m[13], 閃, 1.0d, 走, 0]);
        陣列.追加陣列(out, [m[0], m[1], m[2], 1.0d, 0, 5, m[9], m[13], 閃, 1.0d, 走, 0]);
    }
};

變數 清除 = 函式() { 怪們 = []; };
