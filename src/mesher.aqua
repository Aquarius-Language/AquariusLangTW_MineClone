## 貪婪網格化（Greedy meshing）
只輸出暴露的面，並在每個切片把相同材質、環境光遮蔽與天光的相鄰面合併成大四邊形。
Only exposed faces are emitted; within each slice, neighbouring faces with the same tile, ambient
occlusion and sky light merge into larger quads. Each quad is three floats (exact 24-bit integers)
read by the vertex shader from a storage buffer (vertex pulling):
  f0 = x + 32 z + 1024 y + 262144 face
  f1 = (w-1) + 128 (h-1) + 16384 tile + 524288 flags   flags: 1 flip diagonal, 2 lowered water, 4 reverse
  f2 = ao0 + 4 ao1 + 16 ao2 + 64 ao3 + 256 (sky0 + 16 sky1 + 256 sky2 + 4096 sky3)
The buffer starts with a 4-float header: chunk origin x, z.
##
變數 方 = 0;
變數 可見表 = [];
變數 遮擋表 = [];
變數 半透明圖格 = [];

變數 初始化 = 函式(方塊模組) {
    方 = 方塊模組;
    可見表 = 陣列.建立(4096, 0);
    迴圈 (變數 a = 0; a < 方.數量; a++) {
        迴圈 (變數 b = 0; b < 方.數量; b++) {
            如果 (a != 0 && 方.面可見(a, b)) { 可見表[a * 64 + b] = 1; }
        }
    }
    遮擋表 = 方.遮擋;
    半透明圖格 = 陣列.建立(32, 0);
    半透明圖格[8] = 1;
    半透明圖格[9] = 1;
};

# 網格化一個區塊。P：18x18x130 填充方塊；H：18x18 欄高；最高：本區塊與鄰居的最高方塊。
# Returns [floats, opaque quad count, translucent quad count].
變數 網格化 = 函式(cx, cz, P, H, 最高) {
    變數 SY = 324;
    變數 yMax = 最高 + 1;
    如果 (yMax > 127) { yMax = 127; }
    # 天光：欄高以上為 15，往下每格減 3。 Sky light: 15 above the column top, -3 per block below.
    變數 S = 陣列.建立(18 * 18 * 130, 0);
    迴圈 (變數 pz = 0; pz < 18; pz++) {
        迴圈 (變數 px = 0; px < 18; px++) {
            變數 top = H[pz * 18 + px];
            迴圈 (變數 y = -1; y <= yMax + 1; y++) {
                變數 s = 15;
                如果 (y < top) { s = 15 - (top - y) * 3; 如果 (s < 0) { s = 0; } }
                S[((y + 1) * 18 + pz) * 18 + px] = s;
            }
        }
    }
    變數 不透明 = 陣列.建立(0, 0, 12000);
    變數 半透明 = 陣列.建立(0, 0, 3000);
    變數 遮罩 = 陣列.建立(2048, 0);
    變數 種 = 方.種類;
    變數 頂 = 方.頂面;
    變數 側 = 方.側面;
    變數 底 = 方.底面;
    變數 前向 = 方.前向;
    變數 前面 = 方.前面;
    迴圈 (變數 face = 0; face < 6; face++) {
        # 軸設定：dn 法線步幅，du/dv 平面步幅，U/V 尺寸，切片數。 Axis setup per face.
        變數 dn = 1; 變數 du = 18; 變數 dv = SY; 變數 U = 16; 變數 V = yMax + 1; 變數 切片 = 16;
        如果 (face == 1) { dn = -1; }
        如果 (face == 2 || face == 3) { dn = SY; du = 1; dv = 18; U = 16; V = 16; 切片 = yMax + 1; 如果 (face == 3) { dn = -SY; } }
        如果 (face == 4 || face == 5) { dn = 18; du = 1; dv = SY; U = 16; V = yMax + 1; 切片 = 16; 如果 (face == 5) { dn = -18; } }
        迴圈 (變數 s = 0; s < 切片; s++) {
            # 建立遮罩。 Build the face mask for this slice.
            迴圈 (變數 v = 0; v < V; v++) {
                變數 列 = v * U;
                迴圈 (變數 u = 0; u < U; u++) {
                    變數 x = s; 變數 y = v; 變數 z = u;
                    如果 (face == 2 || face == 3) { x = u; y = s; z = v; } 否則如果 (face >= 4) { x = u; y = v; z = s; }
                    變數 c = ((y + 1) * 18 + z + 1) * 18 + x + 1;
                    變數 a = P[c];
                    變數 k = 0;
                    如果 (a != 0) {
                        變數 b = P[c + dn];
                        如果 (可見表[a * 64 + b] == 1) {
                            變數 圖 = 側[a];
                            如果 (face == 2) { 圖 = 頂[a]; } 否則如果 (face == 3) { 圖 = 底[a]; } 否則如果 (前向[a] == face) { 圖 = 前面[a]; }
                            變數 n = c + dn;
                            變數 o1 = 遮擋表[P[n - du]]; 變數 o2 = 遮擋表[P[n + du]];
                            變數 o3 = 遮擋表[P[n - dv]]; 變數 o4 = 遮擋表[P[n + dv]];
                            變數 a0 = 3 - o1 - o3 - 遮擋表[P[n - du - dv]];
                            變數 a1 = 3 - o2 - o3 - 遮擋表[P[n + du - dv]];
                            變數 a2 = 3 - o2 - o4 - 遮擋表[P[n + du + dv]];
                            變數 a3 = 3 - o1 - o4 - 遮擋表[P[n - du + dv]];
                            如果 (o1 + o3 == 2) { a0 = 0; }
                            如果 (o2 + o3 == 2) { a1 = 0; }
                            如果 (o2 + o4 == 2) { a2 = 0; }
                            如果 (o1 + o4 == 2) { a3 = 0; }
                            變數 sc = S[n];
                            變數 s0 = (sc + S[n - du] + S[n - dv] + S[n - du - dv]) / 4;
                            變數 s1 = (sc + S[n + du] + S[n - dv] + S[n + du - dv]) / 4;
                            變數 s2 = (sc + S[n + du] + S[n + dv] + S[n + du + dv]) / 4;
                            變數 s3 = (sc + S[n - du] + S[n + dv] + S[n - du + dv]) / 4;
                            k = 1 + 圖 + 32 * (a0 + 4 * a1 + 16 * a2 + 64 * a3) + 8192 * (s0 + 16 * s1 + 256 * s2 + 4096 * s3);
                            如果 (face == 2 && 圖 == 9 && P[c + SY] != 方.水) { k += 536870912; }
                        }
                    }
                    遮罩[列 + u] = k;
                    # 植物：只在 +Y 掃描時輸出一次。 Plants: emitted once during the +Y pass.
                    如果 (face == 2 && a != 0) {
                        如果 (種[a] == 4) {
                            變數 天 = S[c];
                            變數 f2 = 255 + 256 * (天 + 16 * 天 + 256 * 天 + 4096 * 天);
                            變數 f0a = x + 32 * z + 1024 * y + 262144 * 6;
                            變數 f0b = x + 32 * z + 1024 * y + 262144 * 7;
                            變數 f1 = 16384 * 頂[a];
                            陣列.追加(不透明, f0a); 陣列.追加(不透明, f1); 陣列.追加(不透明, f2);
                            陣列.追加(不透明, f0a); 陣列.追加(不透明, f1 + 524288 * 4); 陣列.追加(不透明, f2);
                            陣列.追加(不透明, f0b); 陣列.追加(不透明, f1); 陣列.追加(不透明, f2);
                            陣列.追加(不透明, f0b); 陣列.追加(不透明, f1 + 524288 * 4); 陣列.追加(不透明, f2);
                        }
                    }
                }
            }
            # 貪婪合併。 Greedy merge.
            迴圈 (變數 v = 0; v < V; v++) {
                變數 u = 0;
                迴圈 (變數 _u = 0; u < U; _u = 0) {
                    變數 k = 遮罩[v * U + u];
                    如果 (k == 0) {
                        u++;
                    } 否則 {
                        變數 w = 1;
                        迴圈 (變數 _w = 0; u + w < U && 遮罩[v * U + u + w] == k; _w = 0) { w++; }
                        變數 h = 1;
                        變數 完成 = 假;
                        迴圈 (變數 _h = 0; v + h < V && !完成; _h = 0) {
                            變數 列 = (v + h) * U + u;
                            迴圈 (變數 t = 0; t < w; t++) { 如果 (遮罩[列 + t] != k) { 完成 = 真; 中斷; } }
                            如果 (!完成) { h++; }
                        }
                        迴圈 (變數 hh = 0; hh < h; hh++) {
                            變數 列2 = (v + hh) * U + u;
                            迴圈 (變數 t = 0; t < w; t++) { 遮罩[列2 + t] = 0; }
                        }
                        # 解開鍵值。 Unpack the key.
                        變數 r = k - 1;
                        變數 降 = 0;
                        如果 (r >= 536870912) { 降 = 2; r -= 536870912; }
                        變數 圖 = r % 32; r = (r - 圖) / 32;
                        變數 ao = r % 256;
                        變數 天 = (r - ao) / 256;
                        變數 a0 = ao % 4; 變數 a1 = (ao / 4) % 4; 變數 a2 = (ao / 16) % 4; 變數 a3 = ao / 64;
                        變數 旗 = 降;
                        如果 (a0 + a2 < a1 + a3) { 旗 += 1; }
                        變數 x = s; 變數 y = v; 變數 z = u;
                        如果 (face == 2 || face == 3) { x = u; y = s; z = v; } 否則如果 (face >= 4) { x = u; y = v; z = s; }
                        變數 f0 = x + 32 * z + 1024 * y + 262144 * face;
                        變數 f1 = (w - 1) + 128 * (h - 1) + 16384 * 圖 + 524288 * 旗;
                        變數 f2 = ao + 256 * 天;
                        如果 (半透明圖格[圖] == 1) {
                            陣列.追加(半透明, f0); 陣列.追加(半透明, f1); 陣列.追加(半透明, f2);
                        } 否則 {
                            陣列.追加(不透明, f0); 陣列.追加(不透明, f1); 陣列.追加(不透明, f2);
                        }
                        u += w;
                    }
                }
            }
        }
    }
    變數 結果 = 陣列.建立(0, 0, 長度(不透明) + 長度(半透明) + 4);
    陣列.追加(結果, cx * 16); 陣列.追加(結果, cz * 16); 陣列.追加(結果, 0); 陣列.追加(結果, 0);
    陣列.追加陣列(結果, 不透明);
    陣列.追加陣列(結果, 半透明);
    回傳 [結果, 長度(不透明) / 3, 長度(半透明) / 3];
};
